---
// N20 · Mapa de Colombia con pines y zoom. SVG propio (el proveedor de mapas es la decisión pendiente P5).
// Los pines son botones HTML sobre el SVG (decisión 2.8); el script de la página calcula zoom, centrado,
// tamaños y conteos. El estado inicial es "Toda Colombia", "Todo", "Este finde", 1×.
import Icono from '../ui/Icono.astro';
import { ciudadesMapa, contornoColombia, cordilleras, rotulosGeo, miCiudad } from '../../data/mapa';
import { nombreCiudad } from '../../data/ciudades';
import { eventos, conteoCiudad } from '../../data/eventos';
import { planes, ciudadesTexto } from '../../lib/formato';

const activas = ciudadesMapa.filter((c) => conteoCiudad(c.id) > 0).length;
const tamano = (n: number) => Math.min(70, 40 + 5 * (n - 1));
---

<section class="mapa superficie-oscura" aria-label="Mapa de Colombia con los eventos" data-mapa>
  <div class="controles">
    <div class="alcance">
      <button type="button" class="alcance-boton" aria-pressed="true" data-accion="todo">
        <Icono nombre="globo" tamano={16} />Toda Colombia
      </button>
      <button type="button" class="alcance-boton" aria-pressed="false" data-accion="mi-ciudad" data-mi-ciudad={miCiudad}>
        <Icono nombre="inicio" tamano={16} />Mi ciudad: {nombreCiudad(miCiudad)}
      </button>
    </div>
    <div class="zoom" role="group" aria-label="Zoom del mapa">
      <!-- aria-disabled en lugar de disabled para no perder el foco en los límites (H7) -->
      <button type="button" class="zoom-boton" aria-label="Alejar" aria-disabled="true" data-zoom="-0.5">
        <Icono nombre="menos" tamano={18} grosor={2.4} />
      </button>
      <span class="zoom-nivel" data-zoom-nivel>1×</span>
      <button type="button" class="zoom-boton" aria-label="Acercar" aria-disabled="false" data-zoom="0.5">
        <Icono nombre="mas" tamano={18} grosor={2.4} />
      </button>
    </div>
  </div>

  <!-- overflow: clip para que el foco en un pin no desplace el mapa (H50) -->
  <div class="marco" data-marco>
    <div class="lienzo" data-lienzo>
      <div class="capa" data-capa>
        <div class="reticula" aria-hidden="true"></div>
        <svg viewBox="0 0 130 175" aria-hidden="true" focusable="false">
          <path
            d={contornoColombia}
            fill="#2E2220"
            stroke="#8A6A55"
            stroke-width="1.4"
            stroke-linejoin="round"
            vector-effect="non-scaling-stroke"
          />
          {
            cordilleras.map((c) => (
              <path
                d={c.d}
                fill="none"
                stroke="#8FD3D0"
                stroke-opacity={c.opacidad}
                stroke-width={c.grosor}
                stroke-linecap="round"
                stroke-linejoin="round"
                vector-effect="non-scaling-stroke"
              />
            ))
          }
        </svg>

        {
          rotulosGeo.map((g) => (
            <div class:list={['ancla', 'geo', g.tipo]} style={`left: ${g.left}%; top: ${g.top}%`} aria-hidden="true">
              <span style={`--giro: ${g.giro}deg`}>{g.texto}</span>
            </div>
          ))
        }

        {
          ciudadesMapa.map((c) => {
            const n = conteoCiudad(c.id);
            const t = tamano(n);
            const fs = Math.round(t * 0.36);
            const largo = Math.hypot(c.ox, c.oy);
            const angulo = (Math.atan2(c.oy, c.ox) * 180) / Math.PI;
            return (
              <div
                class="ancla pin-ancla"
                data-ancla={c.id}
                hidden={n === 0}
                style={`left: ${c.left}%; top: ${c.top}%; z-index: ${40 - n}`}
              >
                {largo > 0 && (
                  <>
                    <span class="guia" aria-hidden="true" style={`--largo: ${largo.toFixed(1)}px; --angulo: ${angulo.toFixed(1)}deg`} />
                    <span class="punto-real" aria-hidden="true" />
                  </>
                )}
                <button
                  type="button"
                  class="pin"
                  aria-pressed="false"
                  data-pin={c.id}
                  style={`--tam: ${t}; --fs: ${fs}; --bx: ${c.ox}px; --by: ${c.oy}px`}
                >
                  {/* El nombre va primero en el DOM para que el nombre accesible empiece por el texto visible (H59) */}
                  <span class:list={['rotulo', c.lado]}>{c.nombre}</span>{' '}
                  <span data-pin-conteo>{n}</span>
                  <span class="solo-lectores" data-pin-unidad>{n === 1 ? ' plan' : ' planes'}</span>
                </button>
              </div>
            );
          })
        }
      </div>
    </div>
  </div>

  <div class="leyenda">
    <span class="leyenda-texto">
      <span class="puntos" aria-hidden="true"><span></span><span></span><span></span></span>
      El tamaño del punto indica cuántos planes hay
    </span>
    <b data-leyenda>{`${planes(eventos.length)} en ${ciudadesTexto(activas)}`}</b>
  </div>
</section>

<style>
  .mapa {
    /* Los pines (z-index hasta 60) no salen de esta capa ni tapan el encabezado */
    isolation: isolate;
    min-width: 0;
    border-radius: var(--radius-2xl);
    overflow: hidden;
    color: var(--on-dark);
    padding: clamp(14px, 2vw, 20px);
    display: flex;
    flex-direction: column;
    gap: 14px;
    background:
      radial-gradient(circle at 80% 16%, rgba(214, 140, 70, .32) 0, transparent 30%),
      radial-gradient(circle at 14% 90%, rgba(190, 70, 80, .3) 0, transparent 34%),
      radial-gradient(ellipse at 4% 8%, rgba(70, 30, 80, .6) 0, transparent 45%),
      radial-gradient(circle at 50% 55%, rgba(230, 170, 80, .1) 0, transparent 42%),
      var(--hero);
  }

  .controles {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
  }

  .alcance {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .alcance-boton {
    height: 40px;
    border-radius: var(--radius-pill);
    padding: 0 15px;
    font-size: .84rem;
    font-weight: 700;
    display: flex;
    align-items: center;
    gap: 7px;
    border: 1px solid rgba(255, 255, 255, .3);
    background: rgba(255, 255, 255, .08);
    color: var(--on-dark);
  }

  .alcance-boton[aria-pressed='true'] {
    border-color: var(--surface);
    background: var(--surface);
    color: var(--ink);
  }

  .zoom {
    display: flex;
    align-items: center;
    gap: 2px;
    border: 1px solid rgba(255, 255, 255, .3);
    border-radius: var(--radius-pill);
    padding: 2px;
  }

  .zoom-boton {
    width: 40px;
    height: 40px;
    border: 0;
    border-radius: 50%;
    background: transparent;
    color: var(--on-dark);
    display: grid;
    place-items: center;
    padding: 0;
  }

  .zoom-boton[aria-disabled='true'] {
    opacity: .4;
    cursor: default;
  }

  .zoom-nivel {
    min-width: 40px;
    text-align: center;
    font-size: .8rem;
    font-weight: 700;
    color: var(--on-dark-muted);
  }

  .marco {
    position: relative;
    overflow: clip;
    border-radius: var(--radius-lg);
    padding: 16px 0;
    border: 1px solid rgba(255, 255, 255, .07);
  }

  .lienzo {
    position: relative;
    width: min(100%, 560px);
    aspect-ratio: 130 / 175;
    margin: 0 auto;
    container: lienzo / inline-size;
  }

  .capa {
    position: absolute;
    inset: 0;
    transform-origin: 0 0;
    transition: transform 460ms cubic-bezier(.22, .8, .24, 1);
  }

  .reticula {
    position: absolute;
    inset: -60% -45%;
    background-image: radial-gradient(rgba(255, 255, 255, .12) 1px, transparent 1.5px);
    background-size: 16px 16px;
  }

  svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
    filter: drop-shadow(0 0 22px rgba(243, 178, 126, .18));
  }

  /* Anclas de 0 × 0 que se contraescalan (scale(1/Z)) para conservar el tamaño en pantalla */
  .ancla {
    position: absolute;
    width: 0;
    height: 0;
    transform: scale(var(--inv, 1));
    transition: transform 460ms cubic-bezier(.22, .8, .24, 1);
  }

  .geo {
    z-index: 1;
    pointer-events: none;
  }

  .geo span {
    position: absolute;
    left: 0;
    top: 0;
    transform: translate(-50%, -50%) rotate(var(--giro));
    white-space: nowrap;
    font-weight: 700;
    text-transform: uppercase;
  }

  .mar span {
    color: #7FA3A6;
    font-size: .72rem;
    letter-spacing: .22em;
  }

  .pais span {
    color: #9C8B80;
    font-size: .66rem;
    letter-spacing: .14em;
  }

  @container lienzo (max-width: 420px) {
    .pais {
      display: none;
    }

    .mar span {
      font-size: .6rem;
      letter-spacing: .12em;
    }
  }

  .guia {
    position: absolute;
    left: 0;
    top: -1px;
    height: 2px;
    width: calc(var(--largo) * var(--f, 1));
    background: rgba(246, 220, 106, .75);
    transform-origin: 0 50%;
    transform: rotate(var(--angulo));
    transition: width 460ms ease;
  }

  .punto-real {
    position: absolute;
    left: -5px;
    top: -5px;
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--yellow);
    box-shadow: 0 0 0 2px var(--hero);
  }

  .pin {
    position: absolute;
    left: calc(var(--bx) * var(--f, 1));
    top: calc(var(--by) * var(--f, 1));
    transform: translate(-50%, -50%);
    width: clamp(36px, calc(var(--tam) / 5.6 * 1cqw), calc(var(--tam) * 1px));
    height: clamp(36px, calc(var(--tam) / 5.6 * 1cqw), calc(var(--tam) * 1px));
    padding: 0;
    border-radius: 50%;
    border: 3px solid var(--hero);
    background: var(--yellow);
    color: var(--ink);
    box-shadow: 0 6px 14px rgba(0, 0, 0, .4);
    display: grid;
    place-items: center;
    font-family: var(--display);
    font-weight: 900;
    font-size: clamp(13px, calc(var(--fs) / 5.6 * 1cqw), calc(var(--fs) * 1px));
    line-height: 1;
    transition:
      left 460ms ease,
      top 460ms ease,
      background-color 200ms ease,
      box-shadow 200ms ease;
  }

  .pin[aria-pressed='true'] {
    background: var(--brand);
    color: var(--on-dark);
    box-shadow:
      0 0 0 4px rgba(194, 58, 36, .6),
      0 0 0 12px rgba(194, 58, 36, .22),
      0 8px 22px rgba(0, 0, 0, .45);
  }

  /* Nombre dentro del botón: tocarlo también elige la ciudad */
  .rotulo {
    position: absolute;
    white-space: nowrap;
    background: rgba(20, 14, 16, .9);
    color: var(--on-dark);
    border-radius: var(--radius-pill);
    padding: 3px 8px;
    font-family: var(--ui);
    font-size: .72rem;
    font-weight: 700;
    line-height: 1.3;
    letter-spacing: 0;
    box-shadow: 0 2px 8px rgba(0, 0, 0, .35);
  }

  .pin[aria-pressed='true'] .rotulo {
    background: var(--surface);
    color: var(--ink);
  }

  .derecha {
    left: calc(100% + 7px);
    top: 50%;
    transform: translate(0, -50%);
  }

  .izquierda {
    left: -7px;
    top: 50%;
    transform: translate(-100%, -50%);
  }

  .abajo {
    left: 50%;
    top: calc(100% + 6px);
    transform: translate(-50%, 0);
  }

  .arriba {
    left: 50%;
    top: -6px;
    transform: translate(-50%, -100%);
  }

  /* Al cargar con ?ciudad= el mapa aparece ya centrado, sin animación */
  .mapa[data-sin-transicion] :is(.capa, .ancla, .pin, .guia) {
    transition: none;
  }

  .leyenda {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 8px 20px;
    font-size: .84rem;
    color: var(--on-dark-muted);
  }

  .leyenda-texto {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .puntos {
    display: flex;
    align-items: center;
    gap: 4px;
  }

  .puntos span {
    border-radius: 50%;
    background: var(--yellow);
    width: 10px;
    height: 10px;
    flex-shrink: 0;
  }

  .puntos span:nth-child(2) {
    width: 15px;
    height: 15px;
  }

  .puntos span:nth-child(3) {
    width: 21px;
    height: 21px;
  }

  .leyenda b {
    color: var(--on-dark);
    font-size: .9rem;
  }
</style>
