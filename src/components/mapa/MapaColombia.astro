---
// N20 · Mapa de Colombia con pines y zoom. SVG propio (el proveedor de mapas es la decisión pendiente P5).
// Mapa de tierra y mar (decisión 2.36): los departamentos reales (DANE) se colorean según los planes del finde; el
// script de la página les cambia el nivel (data-nivel) cuando cambian los filtros.
// Los pines son botones HTML sobre el SVG (decisión 2.8); el script de la página calcula zoom, centrado,
// tamaños y conteos. El estado inicial es "Toda Colombia", "Todo", "Este finde", 1×.
import Icono from '../ui/Icono.astro';
import { ciudadesMapa, rotulosGeo, miCiudad } from '../../data/mapa';
import { departamentos, islas, nivelPlanes, escalaPlanes } from '../../data/departamentos';
import { nombreCiudad } from '../../data/ciudades';
import { eventos as eventosDemo, type Evento } from '../../data/eventos';
import { planes, ciudadesTexto } from '../../lib/formato';
import { delFinde, porCiudad, porDepartamento as planesPorDpto } from '../../lib/planes';

interface Props {
  // Eventos publicados (lib/datos-eventos.ts); el estado inicial es "Este finde"
  eventos?: Evento[];
}

const eventos = delFinde(Astro.props.eventos ?? eventosDemo);
const conteos = porCiudad(eventos);
const conteoCiudad = (id: string) => conteos[id] ?? 0;
const activas = ciudadesMapa.filter((c) => conteoCiudad(c.id) > 0).length;
const tamano = (n: number) => Math.min(70, 40 + 5 * (n - 1));
const porDepartamento = planesPorDpto(eventos);
// Recuadro de las islas: 1 grado = 40 unidades, alrededor del archipiélago
const islaX = (lon: number) => (lon + 82.05) * 40;
const islaY = (lat: number) => (13.6 - lat) * 40;
---

<section class="mapa" aria-label="Mapa de Colombia con los eventos" data-mapa>
  <div class="controles">
    <div class="alcance">
      <button type="button" class="alcance-boton" aria-pressed="true" data-accion="todo">
        <Icono nombre="globo" tamano={16} />Toda Colombia
      </button>
      <!-- La ciudad de la usuaria solo existe con sesión (decisión 2.24) -->
      <button type="button" class="alcance-boton solo-sesion" aria-pressed="false" data-accion="mi-ciudad" data-mi-ciudad={miCiudad}>
        <Icono nombre="inicio" tamano={16} />Mi ciudad: {nombreCiudad(miCiudad)}
      </button>
    </div>
    <div class="zoom" role="group" aria-label="Zoom del mapa">
      <!-- aria-disabled en lugar de disabled para no perder el foco en los límites (H7) -->
      <button type="button" class="zoom-boton" aria-label="Alejar" aria-disabled="true" data-zoom="-0.5">
        <Icono nombre="menos" tamano={18} grosor={2.4} />
      </button>
      <span class="zoom-nivel" data-zoom-nivel>1×</span>
      <button type="button" class="zoom-boton" aria-label="Acercar" aria-disabled="false" data-zoom="0.5">
        <Icono nombre="mas" tamano={18} grosor={2.4} />
      </button>
    </div>
  </div>

  <!-- overflow: clip para que el foco en un pin no desplace el mapa (H50) -->
  <div class="marco" data-marco>
    <div class="lienzo" data-lienzo>
      <div class="capa" data-capa>
        <svg viewBox="0 0 130 175" aria-hidden="true" focusable="false">
          {
            departamentos.map((d) => (
              <path
                class="dpto"
                d={d.d}
                data-dpto={d.cod}
                data-nivel={nivelPlanes(porDepartamento[d.cod] ?? 0)}
                vector-effect="non-scaling-stroke"
              />
            ))
          }
        </svg>

        {
          rotulosGeo.map((g) => (
            <div class:list={['ancla', 'geo', g.tipo]} style={`left: ${g.left}%; top: ${g.top}%`} aria-hidden="true">
              <span style={`--giro: ${g.giro}deg`}>{g.texto}</span>
            </div>
          ))
        }

        {
          ciudadesMapa.map((c) => {
            const n = conteoCiudad(c.id);
            const t = tamano(n);
            const fs = Math.round(t * 0.36);
            const largo = Math.hypot(c.ox, c.oy);
            const angulo = (Math.atan2(c.oy, c.ox) * 180) / Math.PI;
            return (
              <div
                class="ancla pin-ancla"
                data-ancla={c.id}
                hidden={n === 0}
                style={`left: ${c.left}%; top: ${c.top}%; z-index: ${40 - n}`}
              >
                {largo > 0 && (
                  <>
                    <span class="guia" aria-hidden="true" style={`--largo: ${largo.toFixed(1)}px; --angulo: ${angulo.toFixed(1)}deg`} />
                    <span class="punto-real" aria-hidden="true" />
                  </>
                )}
                <button
                  type="button"
                  class="pin"
                  aria-pressed="false"
                  data-pin={c.id}
                  style={`--tam: ${t}; --fs: ${fs}; --bx: ${c.ox}px; --by: ${c.oy}px`}
                >
                  {/* El nombre va primero en el DOM para que el nombre accesible empiece por el texto visible (H59) */}
                  <span class:list={['rotulo', c.lado]}>{c.nombre}</span>{' '}
                  <span data-pin-conteo>{n}</span>
                  <span class="solo-lectores" data-pin-unidad>{n === 1 ? ' plan' : ' planes'}</span>
                </button>
              </div>
            );
          })
        }
      </div>
    </div>

    <svg class="brujula" viewBox="0 0 60 60" aria-hidden="true" focusable="false">
      <circle cx="30" cy="30" r="13" />
      <path class="aguja" d="M30 8 L33 30 L30 52 L27 30Z M8 30 L30 27 L52 30 L30 33Z" />
      <path class="aguja-luz" d="M30 8 L33 30 L30 30Z M52 30 L30 33 L30 30Z M30 52 L27 30 L30 30Z M8 30 L30 27 L30 30Z" />
      <text x="30" y="5.5">N</text>
    </svg>

    <!-- Con zoom: flechas para moverse sin arrastrar (decisión 2.37, WCAG 2.5.7); el script las muestra -->
    <div class="mover" role="group" aria-label="Moverse por el mapa" hidden data-mover>
      <button type="button" class="mover-boton arriba-f" aria-label="Ver más al norte" data-mover-dir="0,-1"><Icono nombre="siguiente" tamano={16} grosor={2.4} /></button>
      <button type="button" class="mover-boton izquierda-f" aria-label="Ver más al occidente" data-mover-dir="-1,0"><Icono nombre="siguiente" tamano={16} grosor={2.4} /></button>
      <span class="mover-pista">Arrastra para moverte</span>
      <button type="button" class="mover-boton derecha-f" aria-label="Ver más al oriente" data-mover-dir="1,0"><Icono nombre="siguiente" tamano={16} grosor={2.4} /></button>
      <button type="button" class="mover-boton abajo-f" aria-label="Ver más al sur" data-mover-dir="0,1"><Icono nombre="siguiente" tamano={16} grosor={2.4} /></button>
    </div>

    <!-- San Andrés, Providencia y Santa Catalina: fuera del recuadro continental, en su propio recuadro -->
    <div class="islas" aria-hidden="true">
      <svg viewBox="0 0 34 52" focusable="false">
        {islas.map((i) => <circle cx={islaX(i.lon)} cy={islaY(i.lat)} r="3.2" />)}
      </svg>
      <span>San Andrés y Providencia</span>
    </div>
  </div>

  <div class="leyenda">
    <div class="escala" aria-hidden="true">
      <span class="escala-titulo">Planes por departamento</span>
      {escalaPlanes.map((e) => <span class="escala-paso"><i data-nivel={e.nivel}></i>{e.texto}</span>)}
    </div>
    <span class="leyenda-texto">
      <span class="puntos" aria-hidden="true"><span></span><span></span><span></span></span>
      El tamaño del punto indica cuántos planes hay
    </span>
    <b data-leyenda>{`${planes(eventos.length)} en ${ciudadesTexto(activas)}`}</b>
  </div>
</section>

<style>
  .mapa {
    /* Los pines (z-index hasta 60) no salen de esta capa ni tapan el encabezado */
    isolation: isolate;
    min-width: 0;
    border-radius: var(--radius-2xl);
    overflow: hidden;
    color: var(--ink);
    padding: clamp(14px, 2vw, 20px);
    display: flex;
    flex-direction: column;
    gap: 14px;
    background: var(--mapa-mar);
  }

  .controles {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
  }

  .alcance {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .alcance-boton {
    height: 40px;
    border-radius: var(--radius-pill);
    padding: 0 15px;
    font-size: .84rem;
    font-weight: 700;
    display: flex;
    align-items: center;
    gap: 7px;
    border: 1px solid var(--line-input);
    background: var(--surface);
    color: var(--ink);
  }

  .alcance-boton[aria-pressed='true'] {
    border-color: var(--ink);
    background: var(--ink);
    color: var(--on-dark);
  }

  .zoom {
    display: flex;
    align-items: center;
    gap: 2px;
    border: 1px solid var(--line-input);
    border-radius: var(--radius-pill);
    background: var(--surface);
    padding: 2px;
  }

  .zoom-boton {
    width: 40px;
    height: 40px;
    border: 0;
    border-radius: 50%;
    background: transparent;
    color: var(--ink);
    display: grid;
    place-items: center;
    padding: 0;
  }

  .zoom-boton[aria-disabled='true'] {
    opacity: .4;
    cursor: default;
  }

  .zoom-nivel {
    min-width: 40px;
    text-align: center;
    font-size: .8rem;
    font-weight: 700;
    color: var(--ink);
  }

  .marco {
    position: relative;
    overflow: clip;
    border-radius: var(--radius-lg);
    padding: 16px 0;
    border: 1px solid rgba(23, 18, 15, .08);
  }

  .lienzo {
    position: relative;
    width: min(100%, 560px);
    aspect-ratio: 130 / 175;
    margin: 0 auto;
    container: lienzo / inline-size;
  }

  .capa {
    position: absolute;
    inset: 0;
    transform-origin: 0 0;
    transition: transform 460ms cubic-bezier(.22, .8, .24, 1);
  }

  .capa > svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
    filter: drop-shadow(0 10px 18px rgba(23, 18, 15, .18));
  }

  /* Departamentos según los planes (escala de la leyenda, data/departamentos.ts) */
  .dpto {
    fill: var(--mapa-sin-planes);
    stroke: var(--mapa-borde);
    stroke-width: .6;
    stroke-linejoin: round;
    transition: fill 300ms ease;
  }

  .dpto[data-nivel='1'],
  .escala i[data-nivel='1'] {
    fill: var(--mapa-planes-1);
    background: var(--mapa-planes-1);
  }

  .dpto[data-nivel='2'],
  .escala i[data-nivel='2'] {
    fill: var(--mapa-planes-2);
    background: var(--mapa-planes-2);
  }

  .dpto[data-nivel='3'],
  .escala i[data-nivel='3'] {
    fill: var(--mapa-planes-3);
    background: var(--mapa-planes-3);
  }

  /* Con zoom el mapa se arrastra (decisión 2.37): el dedo mueve el mapa, no la página */
  .mapa[data-movible] .marco {
    cursor: grab;
    touch-action: none;
  }

  .mapa[data-arrastrando] .marco {
    cursor: grabbing;
    user-select: none;
  }

  .mapa[data-arrastrando] :is(.capa, .ancla) {
    transition: none;
  }

  /* Flechas para moverse: una cruz abajo a la derecha, con la pista en el centro */
  .mover {
    position: absolute;
    right: 12px;
    bottom: 12px;
    z-index: 70;
    display: grid;
    grid-template-columns: 44px auto 44px;
    grid-template-areas: '. arriba .' 'izquierda pista derecha' '. abajo .';
    align-items: center;
    justify-items: center;
    gap: 2px;
    padding: 6px;
    border: 1px solid var(--line-input);
    border-radius: var(--radius-lg);
    background: rgba(255, 255, 255, .9);
    box-shadow: 0 6px 18px rgba(23, 18, 15, .14);
    cursor: default;
  }

  .mover-boton {
    width: 44px;
    height: 44px;
    border: 0;
    border-radius: 50%;
    background: transparent;
    color: var(--ink);
    display: grid;
    place-items: center;
  }

  .mover-boton:hover {
    background: var(--light-hover);
  }

  .arriba-f { grid-area: arriba; }
  .izquierda-f { grid-area: izquierda; }
  .derecha-f { grid-area: derecha; }
  .abajo-f { grid-area: abajo; }

  .arriba-f :global(svg) { transform: rotate(-90deg); }
  .izquierda-f :global(svg) { transform: rotate(180deg); }
  .abajo-f :global(svg) { transform: rotate(90deg); }

  .mover-pista {
    grid-area: pista;
    max-width: 9ch;
    font-size: .68rem;
    font-weight: 700;
    line-height: 1.2;
    text-align: center;
    color: var(--muted);
  }

  /* En celular la cruz es compacta y sin la pista: arrastrar con el dedo es lo natural */
  @media (max-width: 767px) {
    .mover {
      right: 8px;
      bottom: 8px;
      grid-template-columns: 34px 10px 34px;
      gap: 0;
      padding: 3px;
      border-radius: var(--radius-md);
    }

    .mover-boton {
      width: 34px;
      height: 34px;
    }

    .mover-pista {
      display: none;
    }
  }

  /* Brújula y recuadro de las islas: fijos en el marco, no se mueven con el zoom */
  .brujula {
    position: absolute;
    top: 14px;
    right: 14px;
    width: 52px;
    pointer-events: none;
  }

  .brujula circle {
    fill: none;
    stroke: var(--mapa-rotulo-pais);
    stroke-opacity: .5;
  }

  .brujula .aguja {
    fill: var(--mapa-rotulo-mar);
  }

  .brujula .aguja-luz {
    fill: var(--mapa-planes-1);
  }

  @media (max-width: 767px) {
    .brujula {
      display: none;
    }
  }

  .brujula text {
    font: 700 7px var(--ui);
    fill: var(--mapa-rotulo-mar);
    text-anchor: middle;
  }

  .islas {
    position: absolute;
    left: 14px;
    bottom: 14px;
    width: 92px;
    padding: 6px 8px 8px;
    border: 1px solid rgba(23, 18, 15, .12);
    border-radius: var(--radius-xs);
    background: rgba(255, 255, 255, .35);
    pointer-events: none;
    text-align: center;
  }

  .islas svg {
    display: block;
    width: 26px;
    margin: 0 auto 4px;
  }

  .islas circle {
    fill: var(--mapa-sin-planes);
    stroke: var(--mapa-rotulo-pais);
    stroke-width: .8;
  }

  .islas span {
    display: block;
    font-size: .62rem;
    font-weight: 700;
    line-height: 1.2;
    color: var(--mapa-rotulo-pais);
  }

  /* Anclas de 0 × 0 que se contraescalan (scale(1/Z)) para conservar el tamaño en pantalla */
  .ancla {
    position: absolute;
    width: 0;
    height: 0;
    transform: scale(var(--inv, 1));
    transition: transform 460ms cubic-bezier(.22, .8, .24, 1);
  }

  .geo {
    z-index: 1;
    pointer-events: none;
  }

  .geo span {
    position: absolute;
    left: 0;
    top: 0;
    transform: translate(-50%, -50%) rotate(var(--giro));
    white-space: nowrap;
    font-weight: 700;
    text-transform: uppercase;
  }

  .mar span {
    color: var(--mapa-rotulo-mar);
    font-size: .72rem;
    letter-spacing: .22em;
  }

  .pais span {
    color: var(--mapa-rotulo-pais);
    font-size: .66rem;
    letter-spacing: .14em;
  }

  @container lienzo (max-width: 420px) {
    .pais {
      display: none;
    }

    .mar span {
      font-size: .6rem;
      letter-spacing: .12em;
    }
  }

  .guia {
    position: absolute;
    left: 0;
    top: -1px;
    height: 2px;
    width: calc(var(--largo) * var(--f, 1));
    background: rgba(246, 220, 106, .75);
    transform-origin: 0 50%;
    transform: rotate(var(--angulo));
    transition: width 460ms ease;
  }

  .punto-real {
    position: absolute;
    left: -5px;
    top: -5px;
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--yellow);
    box-shadow: 0 0 0 2px var(--hero);
  }

  .pin {
    position: absolute;
    left: calc(var(--bx) * var(--f, 1));
    top: calc(var(--by) * var(--f, 1));
    transform: translate(-50%, -50%);
    width: clamp(36px, calc(var(--tam) / 5.6 * 1cqw), calc(var(--tam) * 1px));
    height: clamp(36px, calc(var(--tam) / 5.6 * 1cqw), calc(var(--tam) * 1px));
    padding: 0;
    border-radius: 50%;
    border: 3px solid var(--hero);
    background: var(--yellow);
    color: var(--ink);
    box-shadow: 0 6px 14px rgba(0, 0, 0, .4);
    display: grid;
    place-items: center;
    font-family: var(--display);
    font-weight: 900;
    font-size: clamp(13px, calc(var(--fs) / 5.6 * 1cqw), calc(var(--fs) * 1px));
    line-height: 1;
    transition:
      left 460ms ease,
      top 460ms ease,
      background-color 200ms ease,
      box-shadow 200ms ease;
  }

  .pin[aria-pressed='true'] {
    background: var(--brand);
    color: var(--on-dark);
    box-shadow:
      0 0 0 4px rgba(194, 58, 36, .6),
      0 0 0 12px rgba(194, 58, 36, .22),
      0 8px 22px rgba(0, 0, 0, .45);
  }

  /* Nombre dentro del botón: tocarlo también elige la ciudad */
  .rotulo {
    position: absolute;
    white-space: nowrap;
    background: rgba(20, 14, 16, .9);
    color: var(--on-dark);
    border-radius: var(--radius-pill);
    padding: 3px 8px;
    font-family: var(--ui);
    font-size: .72rem;
    font-weight: 700;
    line-height: 1.3;
    letter-spacing: 0;
    box-shadow: 0 2px 8px rgba(0, 0, 0, .35);
  }

  .pin[aria-pressed='true'] .rotulo {
    background: var(--surface);
    color: var(--ink);
  }

  .derecha {
    left: calc(100% + 7px);
    top: 50%;
    transform: translate(0, -50%);
  }

  .izquierda {
    left: -7px;
    top: 50%;
    transform: translate(-100%, -50%);
  }

  .abajo {
    left: 50%;
    top: calc(100% + 6px);
    transform: translate(-50%, 0);
  }

  .arriba {
    left: 50%;
    top: -6px;
    transform: translate(-50%, -100%);
  }

  /* Al cargar con ?ciudad= el mapa aparece ya centrado, sin animación */
  .mapa[data-sin-transicion] :is(.capa, .ancla, .pin, .guia) {
    transition: none;
  }

  .leyenda {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 8px 20px;
    font-size: .84rem;
    color: var(--ink);
  }

  .escala {
    flex-basis: 100%;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px 14px;
  }

  .escala-titulo {
    font-weight: 700;
  }

  .escala-paso {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }

  .escala i {
    width: 14px;
    height: 14px;
    border-radius: 4px;
    background: var(--mapa-sin-planes);
    box-shadow: inset 0 0 0 1px rgba(23, 18, 15, .12);
  }

  .leyenda-texto {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .puntos {
    display: flex;
    align-items: center;
    gap: 4px;
  }

  .puntos span {
    border-radius: 50%;
    background: var(--yellow);
    width: 10px;
    height: 10px;
    flex-shrink: 0;
  }

  .puntos span:nth-child(2) {
    width: 15px;
    height: 15px;
  }

  .puntos span:nth-child(3) {
    width: 21px;
    height: 21px;
  }

  .leyenda b {
    color: var(--ink);
    font-size: .9rem;
  }
</style>
