---
// N22 · Tarjeta compacta horizontal de evento (lista del mapa). Miniatura de 88 px.
import Icono from '../ui/Icono.astro';
import type { Evento } from '../../data/eventos';
import { nombreCiudad } from '../../data/ciudades';
import { pesos, placaFecha, rutaEvento } from '../../lib/formato';

interface Props {
  evento: Evento;
  reposteado?: boolean;
}

const { evento: e, reposteado = false } = Astro.props;
const { dia, mes } = placaFecha(e.fecha);
const ciudad = nombreCiudad(e.ciudad);
// Cada tarjeta abre su propio evento (H36)
const href = rutaEvento(e.ciudad, e.titulo);
---

<article
  class="tarjeta"
  data-tarjeta
  data-id={e.id}
  data-ciudad={e.ciudad}
  data-fecha={e.fecha}
  data-etiquetas={e.etiquetas.join(' ')}
  data-titulo={e.titulo}
  data-categoria={e.categoria}
  data-lugar={e.lugar}
  data-nombre-ciudad={ciudad}
  data-dia={dia}
  data-mes={mes}
  data-bg1={e.bg1}
  data-bg2={e.bg2}
>
  <div class="miniatura">
    <span class="foto" role="img" aria-label="[Foto del evento]" style={`--bg1: ${e.bg1}; --bg2: ${e.bg2}`}></span>
    <span class="placa"><b>{dia}</b><span>{mes}</span></span>
  </div>
  <div class="texto">
    <span class="categoria">{e.categoria}</span>
    <h4 class="titulo"><a href={href}>{e.titulo}</a></h4>
    <span class="lugar">{e.lugar} · {ciudad}</span>
    <div class="compra">
      <!-- Precio con aviso del cargo (H21, decisión 2.14) y boletera como marcador (H1) -->
      <span class="precio">
        {e.precio ? `Desde ${pesos(e.precio)}` : 'Gratis'}
        {e.precio > 0 && <small>+ cargo por servicio</small>}
        <small>{e.vende}</small>
      </span>
      <a class="cta" href={href} aria-label={e.precio ? `Comprar boletas para ${e.titulo}` : `Ver plan: ${e.titulo}`}>
        {e.precio ? 'Comprar' : 'Ver plan'}
      </a>
    </div>
    <div class="acciones">
      <!-- Mismo patrón que la Agenda (H41): "Repostear" abre la ventana; "Reposteado" lo quita -->
      <button type="button" class="repost" aria-pressed={reposteado ? 'true' : 'false'} data-repost data-abrir-modal="ventana-repost">
        <Icono nombre="repostear" tamano={14} grosor={2.2} /><span data-repost-texto>{reposteado ? 'Reposteado' : 'Repostear'}</span>
      </button>
      <button type="button" class="guardar" aria-pressed="false" aria-label={`Guardar ${e.titulo}`} data-guardar>
        <Icono nombre="marcador" tamano={16} />
      </button>
      <!-- Visible también con ciudad elegida (H7): lleva al mapa y enfoca el pin (H42) -->
      <button type="button" class="ver-mapa" aria-label={`Ver en el mapa: ${ciudad}`} data-ver-mapa={e.ciudad}>
        <Icono nombre="pin" tamano={14} grosor={2.2} />Ver en el mapa
      </button>
    </div>
  </div>
</article>

<style>
  .tarjeta {
    display: flex;
    gap: 14px;
    padding: 14px 0;
    border-bottom: 1px solid var(--line-soft);
  }

  .miniatura {
    position: relative;
    width: 88px;
    height: 88px;
    flex-shrink: 0;
    border-radius: var(--radius-sm);
    overflow: hidden;
  }

  .foto {
    position: absolute;
    inset: 0;
    background: radial-gradient(circle at 70% 30%, var(--bg1) 0, transparent 58%), var(--bg2);
  }

  .placa {
    position: absolute;
    top: 6px;
    left: 6px;
    min-width: 32px;
    background: var(--surface);
    border-radius: 8px;
    padding: 4px 6px 3px;
    text-align: center;
    line-height: 1;
  }

  .placa b {
    display: block;
    font-family: var(--display);
    font-size: 1rem;
    font-weight: 900;
  }

  .placa span {
    font-size: .58rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: .06em;
    color: var(--muted);
  }

  .texto {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
  }

  .categoria {
    font-size: .68rem;
    font-weight: 700;
    letter-spacing: .1em;
    text-transform: uppercase;
    color: var(--brand);
  }

  .titulo {
    margin: 2px 0 3px;
    font-size: .98rem;
    font-weight: 700;
    line-height: 1.25;
  }

  .lugar {
    font-size: .8rem;
    line-height: 1.35;
    color: var(--muted);
  }

  .compra {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    margin-top: 8px;
  }

  .precio {
    font-weight: 700;
    font-size: .88rem;
    line-height: 1.2;
  }

  .precio small {
    display: block;
    font-weight: 400;
    font-size: .7rem;
    color: var(--muted);
  }

  .cta,
  .cta:hover {
    display: inline-flex;
    align-items: center;
    height: 36px;
    flex-shrink: 0;
    background: var(--brand);
    color: var(--on-dark);
    border-radius: var(--radius-pill);
    padding: 0 14px;
    font-size: .8rem;
    font-weight: 700;
    white-space: nowrap;
  }

  .acciones {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    margin-top: 10px;
  }

  .repost {
    height: 36px;
    border-radius: var(--radius-pill);
    border: 1px solid var(--line-strong);
    background: var(--surface);
    color: var(--ink);
    padding: 0 12px;
    font-size: .78rem;
    font-weight: 700;
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .repost[aria-pressed='true'] {
    background: var(--ink);
    color: var(--on-dark);
  }

  .guardar {
    width: 36px;
    height: 36px;
    padding: 0;
    border-radius: 50%;
    border: 1px solid var(--line);
    background: var(--surface);
    color: var(--ink);
    display: grid;
    place-items: center;
  }

  .guardar[aria-pressed='true'] {
    color: var(--brand);
  }

  .guardar[aria-pressed='true'] :global(svg) {
    fill: currentColor;
  }

  .ver-mapa {
    margin-left: auto;
    height: 36px;
    border: 0;
    background: transparent;
    color: var(--brand);
    padding: 0 2px;
    font-size: .78rem;
    font-weight: 700;
    display: flex;
    align-items: center;
    gap: 4px;
  }

  /* En celular, zona táctil de 44 px sin cambiar el tamaño visible de 36 px */
  @media (max-width: 767px) {
    .cta,
    .repost,
    .guardar,
    .ver-mapa {
      position: relative;
    }

    .cta::after,
    .repost::after,
    .guardar::after,
    .ver-mapa::after {
      content: '';
      position: absolute;
      inset: -4px;
    }
  }
</style>
