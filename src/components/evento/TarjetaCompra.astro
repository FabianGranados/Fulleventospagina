---
// N35 · Tarjeta de compra fija (desde 980 px). Precio con "+ cargo por servicio" (H21, decisión 2.14).
// "Ver boleta" abre un visor aparte que no toca el checkout (H26).
// Con VENTA_PROPIA = false (decisión 2.22) es solo lista de precios: cada localidad con su precio y
// disponibilidad, sin cantidad ni subtotal, y el botón a la boletera (BotonBoletera).
import Icono from '../ui/Icono.astro';
import Cantidad from './Cantidad.astro';
import BotonBoletera from '../eventos/BotonBoletera.astro';
import { VENTA_PROPIA } from '../../config';
import { pesos } from '../../lib/formato';
import type { ModeloEvento } from './modelo';

interface Props {
  m: ModeloEvento;
}

const { m } = Astro.props;
const { localidades } = m;
const inicial = localidades[0];
---

<aside id="comprar-boletas" class="lateral" aria-label={VENTA_PROPIA ? 'Comprar boletas' : 'Boletas'}>
  <div class="tarjeta">
    <div class="cabeza">
      <div>
        <span class="rotulo">Boletas</span>
        <b class="desde">{m.precioDesde}</b>
        <span class="cargo">+ cargo por servicio</span>
      </div>
      <span class="en-venta">En venta</span>
    </div>

    {
      VENTA_PROPIA ? (
        <>
          <div role="status" class="estado" data-estado-compra hidden>
            <span class="visto" aria-hidden="true"><Icono nombre="visto" tamano={16} grosor={3} /></span>
            <span class="estado-texto">
              <b data-estado-titulo></b>
              <span data-estado-sub></span>
            </span>
            <button type="button" class="ver-boleta" data-ver-boleta data-abrir-modal="visor-boleta">Ver boleta</button>
          </div>

          <fieldset class="grupo">
            <legend class="rotulo">Localidad</legend>
            {
              localidades.map((l) => (
                <label class="opcion" style={`--tinte: ${l.tinte}`} data-loc-opcion={l.id} data-elegida={l.id === inicial.id ? '' : undefined}>
                  <input type="radio" name="loc-tarjeta" value={l.id} data-loc checked={l.id === inicial.id} />
                  <span class="texto">
                    <b>{l.nombre}</b>
                    {l.disponibilidad && <span class:list={['stock', { caliente: l.caliente }]}>{l.disponibilidad}</span>}
                  </span>
                  <b class="precio">{pesos(l.precio)}</b>
                </label>
              ))
            }
          </fieldset>

          <Cantidad id="tarjeta-cantidad" variante="tarjeta" />

          <p class="subtotal">
            <span data-linea-subtotal>Subtotal · 1 boleta × {pesos(inicial.precio)}</span>
            <b data-subtotal>{pesos(inicial.precio)}</b>
          </p>

          <button type="button" class="comprar" data-abrir-compra>
            <Icono nombre="boleta" tamano={18} />
            <span data-texto-comprar>Comprar boletas</span>
          </button>

          <p class="seguro">
            <Icono nombre="candado" tamano={16} />
            <span>Pago seguro · Boleta oficial emitida por [BOLETERA].</span>
          </p>
        </>
      ) : (
        <>
          <ul class="precios" aria-label="Precios por localidad">
            {localidades.map((l) => (
              <li class="fila-precio">
                <span class="muestra" style={`--color: ${l.color}`} aria-hidden="true" />
                <span class="texto">
                  <b>{l.nombre}</b>
                  {l.disponibilidad && <span class:list={['stock', { caliente: l.caliente }]}>{l.disponibilidad}</span>}
                </span>
                <span class="precio">
                  <b>{pesos(l.precio)}</b>
                  <span class="unidad">{l.unidad}</span>
                </span>
              </li>
            ))}
          </ul>

          <BotonBoletera evento={m.evento} id="tarjeta-boletera" />

          <p class="seguro">
            <Icono nombre="informacion" tamano={16} />
            <span>La compra se hace en el sitio de {m.evento.vende}. Fulleventos no vende boletas ni recibe pagos.</span>
          </p>
        </>
      )
    }
  </div>
</aside>

<style>
  .lateral {
    flex: 1 1 340px;
    max-width: 380px;
    min-width: 0;
  }

  .tarjeta {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius-xl);
    padding: 20px;
    display: flex;
    flex-direction: column;
    gap: 16px;
    box-shadow: 0 14px 40px rgba(23, 18, 15, .07);
    position: sticky;
    top: 88px;
  }

  .cabeza {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 12px;
    line-height: 1.2;
  }

  .rotulo {
    display: block;
    font-size: .72rem;
    font-weight: 700;
    letter-spacing: .1em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .desde {
    display: block;
    font-family: var(--display);
    font-weight: 900;
    font-size: 1.7rem;
    letter-spacing: -0.02em;
    margin-top: 2px;
  }

  .cargo {
    display: block;
    font-size: .8rem;
    color: var(--muted);
    margin-top: 2px;
  }

  .en-venta {
    flex-shrink: 0;
    background: var(--lime);
    border-radius: var(--radius-pill);
    padding: 4px 10px;
    font-size: .74rem;
    font-weight: 700;
  }

  .estado {
    display: flex;
    align-items: center;
    gap: 10px;
    background: #F1F8E6;
    border: 1.5px solid var(--lime);
    border-radius: var(--radius-md);
    padding: 10px 12px;
  }

  .visto {
    flex-shrink: 0;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: var(--ink);
    color: var(--lime);
    display: grid;
    place-items: center;
  }

  .estado-texto {
    flex: 1;
    min-width: 0;
    line-height: 1.25;
  }

  .estado-texto b {
    display: block;
    font-size: .92rem;
  }

  .estado-texto span {
    display: block;
    font-size: .76rem;
    color: var(--muted);
  }

  .ver-boleta {
    flex-shrink: 0;
    min-height: 44px;
    border: 0;
    background: transparent;
    padding: 0 4px;
    font-size: .82rem;
    font-weight: 700;
    color: var(--ink);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .grupo {
    border: 0;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .grupo legend {
    margin-bottom: 8px;
  }

  .opcion {
    width: 100%;
    display: flex;
    align-items: center;
    gap: 10px;
    min-height: 56px;
    padding: 8px 12px;
    border-radius: var(--radius-sm);
    border: 1.5px solid var(--line);
    background: var(--surface);
    color: var(--ink);
    cursor: pointer;
  }

  .opcion[data-elegida] {
    border-color: var(--ink);
    background: var(--tinte);
  }

  .opcion:has(:focus-visible) {
    outline: 3px solid var(--brand);
    outline-offset: 2px;
  }

  /* Radio nativo con el aspecto del prototipo: círculo de 20 px y punto de 10 px */
  input[type='radio'] {
    appearance: none;
    flex-shrink: 0;
    width: 20px;
    height: 20px;
    margin: 0;
    border-radius: 50%;
    border: 2px solid var(--ink);
    display: grid;
    place-items: center;
    cursor: pointer;
  }

  input[type='radio']::before {
    content: '';
    width: 10px;
    height: 10px;
    border-radius: 50%;
  }

  input[type='radio']:checked::before {
    background: var(--ink);
  }

  input[type='radio']:focus-visible {
    outline: none;
  }

  .texto {
    flex: 1;
    min-width: 0;
    line-height: 1.2;
  }

  .texto b,
  .precio {
    display: block;
    font-size: .9rem;
  }

  .stock {
    display: block;
    font-size: .74rem;
    font-weight: 700;
    color: var(--muted);
  }

  .stock.caliente {
    color: var(--brand);
  }

  .subtotal {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 10px;
    padding-top: 14px;
    border-top: 1px dashed var(--line);
    font-size: .88rem;
    color: var(--muted);
  }

  .subtotal b {
    font-size: 1.1rem;
    color: var(--ink);
    white-space: nowrap;
  }

  .precios {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .fila-precio {
    display: flex;
    align-items: center;
    gap: 10px;
    min-height: 56px;
    padding: 8px 12px;
    border-radius: var(--radius-sm);
    border: 1.5px solid var(--line);
    background: var(--surface);
  }

  .muestra {
    flex-shrink: 0;
    width: 14px;
    height: 14px;
    border-radius: 4px;
    border: 1.5px solid var(--ink);
    background: var(--color);
  }

  .precio {
    flex-shrink: 0;
    text-align: right;
    line-height: 1.2;
  }

  .unidad {
    display: block;
    font-size: .72rem;
    color: var(--muted);
  }

  .comprar {
    height: 54px;
    border: 0;
    border-radius: var(--radius-pill);
    background: var(--brand);
    color: var(--on-dark);
    font-weight: 700;
    font-size: 1rem;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
  }

  .seguro {
    display: flex;
    align-items: flex-start;
    gap: 8px;
    font-size: .78rem;
    color: var(--muted);
    line-height: 1.4;
  }

  .seguro :global(svg) {
    flex-shrink: 0;
    margin-top: 1px;
  }

  @media (max-width: 979px) {
    .lateral {
      display: none;
    }
  }
</style>
