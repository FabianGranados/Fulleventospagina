---
// N27 · Acciones del evento y "quién va". "Invitar amigos" y "Compartir" comparten la URL del evento (H34, H38).
import Icono from '../ui/Icono.astro';
import { cifra } from '../../lib/formato';
import { textoVan, type ModeloEvento } from './modelo';
import { leInteresa, tieneBoleta } from '../../data/asistencia';
import { VENTA_PROPIA } from '../../config';

interface Props {
  m: ModeloEvento;
}

const { m } = Astro.props;
const { evento: e, detalle: d } = m;
// "Voy" y "Me interesa" arrancan como los dejó la usuaria (asistencia.ts, H37); los conteos ya la incluyen
const interesa = leInteresa(e.id);
// "Ya tengo boleta" (decisión 2.22): sin venta propia cada quien lo marca a mano, solo en eventos de pago
const marcaBoleta = !VENTA_PROPIA && !m.gratis;
const tengoBoleta = tieneBoleta(e.id);
const vanBase = e.van - (m.voy ? 1 : 0);
// Quién va: amigos calculados de los parches del evento, no un texto fijo (H37)
const colorDe: Record<string, string> = {
  c1: '#F3B27E',
  c2: '#A3A8F0',
  c3: '#EE93BC',
  c4: '#B9E07A',
  c5: '#F6DC6A',
  c6: '#8FD3D0',
};
const amigos = m.amigosVan;
const corto = (nombre: string) => nombre.split(' ')[0];
const nombrados = amigos.slice(0, 3).map((a) => corto(a.nombre));
const resto = amigos.length - nombrados.length;
const textoAmigos = resto
  ? `${nombrados.join(', ')} y ${resto} ${resto === 1 ? 'amigo más' : 'amigos más'}`
  : nombrados.length > 1
    ? `${nombrados.slice(0, -1).join(', ')} y ${nombrados[nombrados.length - 1]}`
    : nombrados.join('');
const avatares = amigos.slice(0, 4);
const mas = amigos.length - avatares.length;
---

<!-- Página pública (decisión 2.24): los botones salen como los ve el visitante. Con sesión, asistencia.ts aplica el
     estado de la usuaria (data-sesion-pulsado); sin sesión, data-requiere-cuenta abre "Crea tu cuenta" -->
<div class="acciones-evento">
  <div class="fila">
    <button
      type="button"
      class="boton voy"
      aria-pressed="false"
      data-voy
      data-sesion-pulsado={String(m.voy)}
      data-requiere-cuenta="para decir que vas"
    >
      <Icono nombre="visto" tamano={18} grosor={2.4} />
      <span data-texto-voy>Voy</span>
    </button>
    <button
      type="button"
      class="boton claro interes"
      aria-pressed="false"
      data-interes
      data-sesion-pulsado={String(interesa)}
      data-requiere-cuenta="para marcar lo que te interesa"
    >
      <Icono nombre="estrella" tamano={18} />
      Me interesa
    </button>
    {
      marcaBoleta && (
        <button
          type="button"
          class="boton claro tengo"
          aria-pressed="false"
          data-tengo-boleta
          data-sesion-pulsado={String(tengoBoleta)}
          data-requiere-cuenta="para marcar que ya tienes boleta"
        >
          <Icono nombre="boleta" tamano={18} />
          Ya tengo boleta
        </button>
      )
    }
    <button type="button" class="boton claro" data-compartir="invitar" data-requiere-cuenta="para invitar a tus amigos">
      <Icono nombre="avion" tamano={18} />
      Invitar amigos
    </button>
    <button type="button" class="boton claro circulo" aria-label="Compartir evento" data-compartir="compartir">
      <Icono nombre="compartirEvento" tamano={18} />
    </button>
  </div>
  <p class="aviso" role="status" data-aviso-compartir></p>

  {
    d && (
      <div class="quien-va solo-visitante">
        <p>
          <b>{textoVan(e.van)}</b> · <span class="gris">{cifra(d.interesados)} interesados</span>
        </p>
        <a href="#parches" class="enlace">Ver parches</a>
      </div>
    )
  }

  {
    d && (
      <div class="quien-va solo-sesion">
        {avatares.length > 0 && (
          <span class="pila" aria-hidden="true">
            {avatares.map((a) => (
              <span class="av" style={`background: ${colorDe[a.color]}`}>{a.iniciales}</span>
            ))}
            {mas > 0 && <span class="av mas">+{mas}</span>}
          </span>
        )}
        <p>
          {amigos.length > 0 && <><b>{textoAmigos}</b> {amigos.length === 1 ? 'va' : 'van'}.{' '}</>}
          <span class="gris">
            <span data-conteo-van data-base={vanBase} data-solo-numero>{cifra(e.van)}</span> personas confirmadas ·{' '}
            <span data-conteo-interes data-base={d.interesados - (interesa ? 1 : 0)}>{cifra(d.interesados)}</span> interesadas
          </span>
        </p>
        <a href="#parches" class="enlace">Ver parches</a>
      </div>
    )
  }
</div>

<style>
  .acciones-evento {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .fila {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    align-items: center;
  }

  .boton {
    height: 48px;
    border-radius: var(--radius-pill);
    padding: 0 22px;
    font-size: .95rem;
    font-weight: 700;
    display: flex;
    align-items: center;
    gap: 8px;
    color: var(--ink);
    background: var(--surface);
    border: 1px solid var(--line);
  }

  .voy {
    padding: 0 24px;
    border-color: var(--ink);
  }

  .voy[aria-pressed='true'] {
    background: var(--ink);
    color: var(--on-dark);
  }

  .interes[aria-pressed='true'] {
    color: var(--brand);
  }

  .interes[aria-pressed='true'] :global(svg) {
    fill: currentColor;
  }

  .tengo[aria-pressed='true'] {
    background: var(--lime);
    border-color: var(--ink);
  }

  .circulo {
    width: 48px;
    padding: 0;
    justify-content: center;
    border-radius: 50%;
  }

  .aviso:empty {
    display: none;
  }

  .aviso {
    font-size: .86rem;
    color: var(--muted);
    margin-top: -4px;
  }

  .quien-va {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    padding: 18px 20px;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 14px 20px;
  }

  .pila {
    display: flex;
  }

  /* 40 px + borde blanco de 3 px por lado: 46 px dibujados */
  .av {
    width: 46px;
    height: 46px;
    border-radius: 50%;
    border: 3px solid var(--surface);
    display: grid;
    place-items: center;
    font-weight: 700;
    font-size: .74rem;
  }

  .av + .av {
    margin-left: -12px;
  }

  .mas {
    background: var(--ink);
    color: var(--on-dark);
    font-size: .7rem;
  }

  .quien-va p {
    flex: 1 1 220px;
  }

  .gris {
    color: var(--muted);
  }

  .enlace {
    font-size: .86rem;
    font-weight: 700;
    border-bottom: 2px solid var(--ink);
    padding-bottom: 1px;
  }
</style>
