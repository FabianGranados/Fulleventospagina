---
// N28 · "Sobre el evento": la descripción del organizador (ficha completa) o la descripción corta del
// evento (`resumen`, decisión 2.23). Las etiquetas solo existen en la ficha completa.
interface Props {
  parrafos: string[];
  etiquetas?: string[];
}

const { parrafos, etiquetas = [] } = Astro.props;
---

<section id="sobre" class="seccion-evento" aria-labelledby="h-sobre">
  <h2 id="h-sobre" class="titulo-seccion">Sobre el evento</h2>
  <div class="texto">
    {parrafos.map((p) => <p>{p}</p>)}
  </div>
  {
    etiquetas.length > 0 && (
      <ul class="etiquetas" aria-label="Etiquetas del evento">
        {etiquetas.map((t) => <li>{t}</li>)}
      </ul>
    )
  }
</section>

<style>
  .texto {
    display: flex;
    flex-direction: column;
    gap: 12px;
    max-width: 66ch;
    font-size: 1rem;
  }

  .etiquetas {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .etiquetas li {
    height: 34px;
    display: inline-flex;
    align-items: center;
    padding: 0 14px;
    border-radius: var(--radius-pill);
    border: 1px solid var(--line);
    background: var(--surface);
    font-size: .84rem;
  }
</style>
