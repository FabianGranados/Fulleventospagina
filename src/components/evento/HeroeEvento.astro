---
// N25 · Héroe del evento. La foto real del evento (H57) reemplaza al marcador cuando exista.
import Icono from '../ui/Icono.astro';
import Etiqueta from '../ui/Etiqueta.astro';
import Titular from '../ui/Titular.astro';
import { lineasTitulo, textoVan, type ModeloEvento } from './modelo';
import { cifra } from '../../lib/formato';

interface Props {
  m: ModeloEvento;
}

const { m } = Astro.props;
const { evento: e, detalle: d } = m;
const lineas = lineasTitulo(e.titulo).map((texto, i) => ({ texto, sangria: i ? '1em' : '0' }));
const fondo = d
  ? undefined
  : `--bg1: ${e.bg1}; --bg2: ${e.bg2}`;
---

<section class:list={['heroe', 'superficie-oscura', { propio: !d }]} aria-labelledby="titulo-evento" style={fondo}>
  <span class="nota-foto" role="img" aria-label="[Foto del evento]">[Foto del evento]</span>
  <Etiqueta tamano="md" class="etiqueta-heroe">{e.categoria} · {m.fechaCorta}</Etiqueta>
  <div id="titulo-evento" class="titulo">
    <Titular lineas={lineas} tamano="clamp(2.2rem, 5vw, 4.2rem)" />
  </div>
  <ul class="datos">
    <li>
      <Icono nombre="reloj" tamano={16} />
      {m.fechaLarga}{d && ` · Puertas ${d.puertas}`}
    </li>
    <li>
      <Icono nombre="pin" tamano={16} />
      {m.lugarCompleto}
    </li>
    <li>
      <Icono nombre="gente" tamano={16} />
      <span><span data-conteo-van data-base={e.van}>{textoVan(e.van)}</span>{
        d && <> · <span data-conteo-interes data-base={d.interesados}>{cifra(d.interesados)}</span> interesados</>
      }</span>
    </li>
  </ul>
</section>

<style>
  .heroe {
    position: relative;
    border-radius: var(--radius-2xl);
    overflow: hidden;
    min-height: 380px;
    padding: clamp(28px, 5vw, 48px) clamp(20px, 5vw, 56px);
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    gap: 16px;
    color: var(--on-dark);
    background:
      radial-gradient(circle at 74% 30%, rgba(232, 160, 79, .65) 0, transparent 26%),
      radial-gradient(circle at 90% 80%, rgba(181, 55, 43, .6) 0, transparent 30%),
      radial-gradient(ellipse at 8% 40%, rgba(70, 30, 80, .55) 0, transparent 45%),
      var(--hero);
  }

  /* Eventos sin foto ni degradado propio: se usan sus colores de tarjeta */
  .propio {
    background:
      radial-gradient(circle at 74% 30%, color-mix(in srgb, var(--bg1) 65%, transparent) 0, transparent 26%),
      radial-gradient(circle at 90% 80%, color-mix(in srgb, var(--bg2) 60%, transparent) 0, transparent 30%),
      radial-gradient(ellipse at 8% 40%, rgba(70, 30, 80, .55) 0, transparent 45%),
      var(--hero);
  }

  .nota-foto {
    position: absolute;
    top: 20px;
    right: 20px;
    font-size: .72rem;
    color: rgba(255, 255, 255, .8);
    border: 1px solid rgba(255, 255, 255, .35);
    border-radius: var(--radius-pill);
    padding: 4px 10px;
  }

  .heroe :global(.etiqueta-heroe) {
    align-self: flex-start;
    font-size: .95rem;
    padding: 4px 11px;
  }

  .titulo :global(.linea) {
    overflow-wrap: anywhere;
  }

  .datos {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 8px 22px;
    font-size: .95rem;
    color: rgba(255, 255, 255, .92);
  }

  .datos li {
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .datos :global(svg) {
    flex-shrink: 0;
  }
</style>
