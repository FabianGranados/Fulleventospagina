  .segmentado-chico input,
  .medio input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }

  .segmentado b {
    font-size: .9rem;
  }

  .segmentado span {
    font-size: .74rem;
    margin-top: 2px;
    color: var(--muted);
  }

  .segmentado label:has(:checked) {
    background: var(--ink);
    color: var(--on-dark);
  }

  .segmentado label:has(:checked) span {
    color: rgba(255, 255, 255, .78);
  }

  .parche {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    padding: 16px;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .parche[hidden] {
    display: none;
  }

  .parche-cabeza {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .av-parche {
    flex-shrink: 0;
    width: 44px;
    height: 44px;
    border-radius: 12px;
    background: var(--yellow);
    display: grid;
    place-items: center;
    font-family: var(--display);
    font-weight: 900;
    font-size: .9rem;
  }

  .parche-texto {
    flex: 1;
    min-width: 0;
    line-height: 1.25;
  }

  .parche-texto b {
    display: block;
    font-size: .95rem;
  }

  .parche-texto span {
    font-size: .8rem;
    color: var(--muted);
  }

  .van {
    flex-shrink: 0;
    background: var(--bg);
    border-radius: var(--radius-pill);
    padding: 4px 10px;
    font-size: .8rem;
    font-weight: 700;
  }

