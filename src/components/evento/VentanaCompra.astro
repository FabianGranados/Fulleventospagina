    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .miembros:focus {
    outline: none;
  }

  .miembro {
    height: 44px;
    border-radius: var(--radius-pill);
    padding: 0 12px 0 5px;
    display: flex;
    align-items: center;
    gap: 8px;
    border: 1.5px solid var(--line);
    background: var(--surface);
    color: var(--ink);
    font-size: .86rem;
    font-weight: 500;
  }

  .miembro .av {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    font-size: .7rem;
    font-weight: 700;
  }

  .miembro :global(.check) {
    display: none;
  }

  .miembro[aria-pressed='true'] {
    border-color: var(--ink);
    background: var(--bg);
  }

  .miembro[aria-pressed='true'] :global(.check) {
    display: block;
  }

  .miembro[aria-disabled='true'] {
    background: var(--line);
    color: var(--muted);
    cursor: default;
  }

  .cupo {
    font-size: .78rem;
    color: var(--muted);
  }

  .aviso-recorte:empty {
    display: none;
  }

  .aviso-recorte {
    font-size: .8rem;
    font-weight: 700;
  }

  .interruptor {
    display: flex;
    align-items: center;
    gap: 12px;
    width: 100%;
    text-align: left;
    min-height: 52px;
    background: transparent;
    border: 0;
    border-top: 1px solid var(--line-soft);
    padding: 12px 0 0;
    color: var(--ink);
  }

  /* H52: pista apagada con contraste de 3:1 */
  .pista-switch {
    position: relative;
    flex-shrink: 0;
    width: 46px;
    height: 28px;
    border-radius: var(--radius-pill);
    background: var(--borde-campo);
  }

  .perilla {
    position: absolute;
    top: 3px;
    left: 3px;
    width: 22px;
    height: 22px;
    border-radius: 50%;
    background: var(--surface);
    box-shadow: 0 1px 3px rgba(23, 18, 15, .3);
  }

