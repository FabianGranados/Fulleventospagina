    flex-direction: column;
  }

  .paso[hidden] {
    display: none;
  }

  .paso-1 {
    gap: 22px;
  }

  .paso-2 {
    gap: 14px;
  }

  .paso-3 {
    gap: 16px;
  }

  .paso-4 {
    gap: 18px;
  }

  h3 {
    font-size: 1rem;
    font-weight: 700;
  }

  h3:focus {
    outline: none;
  }

  h3:focus-visible {
    outline: 3px solid var(--brand);
  }

  fieldset {
    border: 0;
    min-width: 0;
  }

  .grupo {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .grupo legend {
    margin-bottom: 8px;
    padding: 0;
