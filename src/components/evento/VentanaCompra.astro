  .opcion {
    width: 100%;
    display: flex;
    align-items: center;
    gap: 12px;
    min-height: 62px;
    padding: 10px 14px;
    border-radius: var(--radius-md);
    border: 1.5px solid var(--line);
    background: var(--surface);
    cursor: pointer;
  }

  .opcion[data-elegida] {
    border-color: var(--ink);
    background: var(--tinte);
  }

  .opcion:has(:focus-visible),
  .medio:has(:focus-visible),
  .segmentado label:has(:focus-visible),
  .segmentado-chico label:has(:focus-visible) {
    outline: 3px solid var(--brand);
    outline-offset: 2px;
  }

  input[type='radio'] {
    appearance: none;
    flex-shrink: 0;
    width: 20px;
    height: 20px;
    margin: 0;
    border-radius: 50%;
    border: 2px solid var(--ink);
    display: grid;
    place-items: center;
    cursor: pointer;
  }

  input[type='radio']::before {
    content: '';
    width: 10px;
    height: 10px;
    border-radius: 50%;
  }

  input[type='radio']:checked::before {
    background: var(--ink);
  }

  input[type='radio']:focus-visible {
    outline: none;
  }

  .op-texto {
    flex: 1;
    min-width: 0;
    line-height: 1.25;
  }

  .op-texto b,
  .op-derecha b {
    display: block;
    font-size: .92rem;
  }

  .op-texto span {
    display: block;
    font-size: .76rem;
    color: var(--muted);
  }

  .op-derecha {
    flex-shrink: 0;
    text-align: right;
    line-height: 1.2;
  }

  .stock {
    display: block;
    font-size: .7rem;
    font-weight: 700;
    color: var(--muted);
  }

  .stock.caliente {
    color: var(--brand);
  }

  .segmentado {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 6px;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius-card);
    padding: 5px;
  }

