    background: var(--brand);
  }

  .interruptor[aria-checked='true'] .perilla {
    left: 21px;
  }

  .interruptor[aria-disabled='true'] {
    color: var(--muted);
    cursor: default;
  }

  .interruptor[aria-disabled='true'] .pista-switch {
    background: var(--line);
  }

  .switch-texto {
    line-height: 1.3;
  }

  .switch-texto b {
    display: block;
    font-size: .9rem;
  }

  .switch-texto span {
    display: block;
    font-size: .76rem;
    color: var(--muted);
  }

  .switch-estado {
