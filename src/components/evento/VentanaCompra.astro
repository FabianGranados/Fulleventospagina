    color: var(--brand);
    font-weight: 700;
  }

  .ayuda {
    margin-top: 2px;
    font-size: .84rem;
    color: var(--muted);
  }

  .campo {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .campo label {
    font-weight: 700;
    font-size: .86rem;
  }

  .oblig {
    font-weight: 400;
    color: var(--muted);
  }

  .campo input,
  .campo select {
    height: 48px;
    width: 100%;
    border: 1px solid var(--borde-campo);
    border-radius: var(--radius-field);
    padding: 0 14px;
    font-size: 1rem;
    background: var(--surface);
    color: var(--ink);
  }

  .campo select {
    padding: 0 10px;
