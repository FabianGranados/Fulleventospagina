    display: block;
    font-size: .9rem;
  }

  .asistentes-lista :global(.amigo span span) {
    font-size: .78rem;
    color: var(--muted);
  }

  .medios {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(140px, 1fr));
    gap: 8px;
  }

  .medio {
    position: relative;
    min-height: 92px;
    border-radius: var(--radius-md);
    border: 1.5px solid var(--line);
    background: var(--surface);
    padding: 12px;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 6px;
    cursor: pointer;
  }

  .medio:has(:checked) {
    border-color: var(--ink);
    box-shadow: inset 0 0 0 1px var(--ink);
  }

  .medio-arriba {
    width: 100%;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

