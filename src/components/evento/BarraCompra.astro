---
// N37 · Barra de compra fija por debajo de 980 px.
// Con VENTA_PROPIA = false (decisión 2.22): precio desde y el botón compacto a la boletera.
// Más liviana (decisión 2.27): solo en eventos de pago (la página no la pinta en los gratis), se oculta mientras la
// tarjeta de boletas o la sección de localidades están en pantalla, y con sesión en celular se apila encima de la
// barra de navegación inferior (--espacio-barra-nav, BarraNavegacion).
import type { ModeloEvento } from './modelo';
import BotonBoletera from '../eventos/BotonBoletera.astro';
import { VENTA_PROPIA } from '../../config';
import { pesos } from '../../lib/formato';

interface Props {
  m: ModeloEvento;
}

const { m } = Astro.props;
const inicial = m.localidades[0];
---

<div class="barra" role="region" aria-label={VENTA_PROPIA ? 'Comprar boletas' : 'Boletas'} data-barra-compra>
  <div class="texto">
    <b>{m.precioDesde}</b>
    <span class="cargo">+ cargo por servicio</span>
    {VENTA_PROPIA && <span class="sub" data-barra-sub>{inicial.nombre} · 1 boleta · {pesos(inicial.precio)}</span>}
  </div>
  {
    VENTA_PROPIA ? (
      <>
        <button type="button" class="ver" data-ver-boleta data-abrir-modal="visor-boleta" hidden>Ver boleta</button>
        <button type="button" class="comprar" data-abrir-compra>Comprar</button>
      </>
    ) : (
      <BotonBoletera evento={m.evento} id="barra-boletera" compacto />
    )
  }
</div>

<script>
  // Se oculta cuando lo que muestra ya está a la vista: la tarjeta de boletas (computador) o las localidades
  const barra = document.querySelector<HTMLElement>('[data-barra-compra]');
  const vigilados = [...document.querySelectorAll<HTMLElement>('#comprar-boletas, #localidades')];
  if (barra && vigilados.length && 'IntersectionObserver' in window) {
    const visibles = new Set<Element>();
    const observador = new IntersectionObserver((entradas) => {
      entradas.forEach((e) => (e.isIntersecting ? visibles.add(e.target) : visibles.delete(e.target)));
      const ocultar = visibles.size > 0;
      // Si el foco está dentro, no se esconde de golpe
      if (ocultar && barra.contains(document.activeElement)) return;
      barra.toggleAttribute('data-oculta', ocultar);
    });
    vigilados.forEach((v) => observador.observe(v));
  }
</script>

<style>
  .barra {
    display: none;
  }

  @media (max-width: 979px) {
    .barra {
      position: fixed;
      left: 0;
      right: 0;
      bottom: 0;
      z-index: 15;
      background: var(--surface);
      border-top: 1px solid var(--line);
      box-shadow: 0 -10px 30px rgba(23, 18, 15, .08);
      padding: 10px var(--margen-lateral) calc(10px + env(safe-area-inset-bottom, 0px));
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 12px;
      transition: transform .2s ease, visibility .2s;
    }

    /* Oculta (fuera de la pantalla y fuera del orden del foco) mientras se ven las boletas */
    .barra[data-oculta] {
      transform: translateY(calc(100% + var(--espacio-barra-nav, 0px)));
      visibility: hidden;
    }
  }

  /* Con sesión en celular, encima de la barra de navegación inferior; el área segura ya la cubre esa barra */
  @media (max-width: 767px) {
    :global(html[data-sesion='si']) .barra {
      bottom: var(--espacio-barra-nav, 0px);
      padding-bottom: 10px;
      z-index: 19;
    }
  }

  .texto {
    flex: 1;
    min-width: 0;
    line-height: 1.2;
  }

  .texto b,
  .sub {
    display: block;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .texto b {
    font-size: 1rem;
  }

  .cargo {
    display: block;
    font-size: .72rem;
    line-height: 1.2;
    color: var(--muted);
  }

  .sub {
    font-size: .76rem;
    color: var(--muted);
  }

  .ver {
    flex-shrink: 0;
    height: 44px;
    border: 1px solid var(--ink);
    border-radius: var(--radius-pill);
    padding: 0 14px;
    background: var(--surface);
    color: var(--ink);
    font-weight: 700;
    font-size: .86rem;
  }

  .comprar {
    flex-shrink: 0;
    height: 48px;
    border: 0;
    border-radius: var(--radius-pill);
    padding: 0 22px;
    background: var(--brand);
    color: var(--on-dark);
    font-weight: 700;
    font-size: .95rem;
  }

  .ver[hidden] {
    display: none;
  }
</style>
