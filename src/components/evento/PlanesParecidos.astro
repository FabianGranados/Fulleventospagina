---
// N34 · Planes parecidos en otras ciudades (+ recuerdos, solo con fotos de ediciones pasadas).
// Cada tarjeta abre su propio evento (H36); es la tarjeta afiche común (decisión 2.35).
import Icono from '../ui/Icono.astro';
import TarjetaAfiche from '../eventos/TarjetaAfiche.astro';
import type { ModeloEvento } from './modelo';

interface Props {
  m: ModeloEvento;
}

const { m } = Astro.props;
const { detalle: d } = m;
---

<div class:list={['bloque', { 'con-recuerdos': d }]}>
  {
    m.similares.length > 0 && (
      <section class="parecidos" aria-labelledby="h-parecidos">
        <div class="cabecera">
          <div>
            <h2 id="h-parecidos" class="titulo-seccion">Planes parecidos en otras ciudades</h2>
            <p class="sub">{m.textoSimilares}</p>
          </div>
          <a href={`/mapa?categoria=${encodeURIComponent(m.evento.etiquetas[0])}`} class="enlace">
            <Icono nombre="mapa" tamano={16} />
            Ver más planes en el mapa
          </a>
        </div>
        <ul class="rejilla">
          {m.similares.map((e) => (
            <li>
              <TarjetaAfiche evento={e} nivel={3} guardable={false} />
            </li>
          ))}
        </ul>
      </section>
    )
  }

  {
    d && (
      <section class="recuerdos" aria-labelledby="h-recuerdos">
        <h2 id="h-recuerdos">Recuerdos de ediciones pasadas</h2>
        <ul class="fotos">
          {d.recuerdos.map((fondo) => (
            <li><span role="img" aria-label="[Foto de asistente]" style={`background: ${fondo}`} /></li>
          ))}
        </ul>
        {/* El perfil del organizador con sus fotos no existe todavía (PF2, H38): con sesión dice "Próximamente" */}
        <div class="solo">
          <button type="button" class="enlace" data-requiere-cuenta="para ver los perfiles y sus fotos" data-retomar="fotos" data-ver-fotos>Ver las {d.fotosRecuerdos} fotos</button>
          <p class="pronto" role="status" data-aviso-fotos></p>
        </div>
      </section>
    )
  }
</div>

<style>
  .bloque {
    display: flex;
    flex-wrap: wrap;
    gap: 24px;
    align-items: flex-start;
    margin-top: 16px;
    padding-top: 32px;
    border-top: 1px solid var(--line);
  }

  .parecidos {
    flex: 2 1 560px;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .cabecera {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 8px 16px;
  }

  .sub {
    margin-top: 4px;
    font-size: .88rem;
    color: var(--muted);
  }

  .enlace {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: .86rem;
    font-weight: 700;
    border-bottom: 2px solid var(--ink);
    padding-bottom: 1px;
  }

  .rejilla {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 240px), 1fr));
    gap: 16px;
  }

  /* Ancho máximo para que una sola tarjeta no se estire de más */
  .rejilla li {
    display: flex;
  }

  .rejilla li > :global(*) {
    flex: 1;
  }

  .recuerdos {
    flex: 1 1 300px;
    min-width: 0;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    padding: 18px;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .recuerdos h2 {
    font-size: 1rem;
    font-weight: 700;
  }

  .fotos {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 6px;
  }

  /* A 768 px los cuadros no pasan de 140 px (el bloque quedaba muy alto) */
  .fotos span {
    display: block;
    aspect-ratio: 1;
    border-radius: var(--radius-xs);
  }

  @media (min-width: 600px) and (max-width: 969px) {
    .recuerdos {
      max-width: 460px;
    }
  }

  .solo {
    align-self: flex-start;
  }

  button.enlace {
    border-width: 0 0 2px;
    border-style: solid;
    border-color: var(--ink);
    background: transparent;
    color: var(--ink);
    padding: 0 0 1px;
    font-family: inherit;
  }

  button.enlace:hover {
    color: var(--brand);
  }

  .pronto {
    font-size: .85rem;
    color: var(--muted);
  }

  .pronto:not(:empty) {
    margin-top: 6px;
  }
</style>

<script>
  const boton = document.querySelector<HTMLButtonElement>('[data-ver-fotos]');
  const aviso = document.querySelector<HTMLElement>('[data-aviso-fotos]');
  boton?.addEventListener('click', () => {
    if (!aviso) return;
    aviso.textContent = '';
    requestAnimationFrame(() => (aviso.textContent = 'Próximamente podrás ver las fotos de ediciones pasadas.'));
  });
</script>
