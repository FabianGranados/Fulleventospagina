---
// N28 · Atajos "En esta página". H61: fila con desplazamiento lateral (sin desvanecido, decisión 2.28).
interface Props {
  atajos: { href: string; texto: string }[];
}

const { atajos } = Astro.props;
---

<div class="atajos" data-atajos>
  <nav aria-label="En esta página" class="fila" data-atajos-fila>
    {atajos.map((a) => <a href={a.href}>{a.texto}</a>)}
  </nav>
</div>


<style>
  .atajos {
    position: relative;
    margin: -22px 0 -18px;
    background: var(--bg);
  }

  .fila {
    display: flex;
    gap: 8px;
    overflow-x: auto;
    padding: 10px 2px;
    scrollbar-width: thin;
  }

  /* Pista de que hay más (H61) */
  a {
    flex-shrink: 0;
    height: 40px;
    display: inline-flex;
    align-items: center;
    padding: 0 16px;
    border-radius: var(--radius-pill);
    border: 1px solid var(--line);
    background: var(--surface);
    font-size: .88rem;
    font-weight: 500;
    white-space: nowrap;
  }

  @media (min-width: 980px) {
    .atajos {
      position: sticky;
      top: 69px;
      z-index: 4;
    }
  }
</style>
