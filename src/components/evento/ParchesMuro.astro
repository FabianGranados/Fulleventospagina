---
// N31 · Parches del evento y muro, con pestañas N63 (patrón ARIA completo, H59).
// Camila ya está en "Salseros de jueves" (H25). Reportar/bloquear (H9) y parches con aprobación (H30): pendientes de diseño.
import Icono from '../ui/Icono.astro';
import { persona, usuaria } from '../../data/personas';
import type { DetalleEvento } from '../../data/evento';
import { rutaNuevoParche } from '../../data/mensajes';

interface Props {
  d: DetalleEvento;
  eventoId: string;
}

const { d, eventoId } = Astro.props;
const colorDe: Record<string, string> = {
  c1: 'var(--peach)',
  c2: 'var(--lilac)',
  c3: 'var(--pink)',
  c4: 'var(--lime)',
  c5: 'var(--yellow)',
  c6: 'var(--aqua)',
};
const pct = (usados: number, maximo: number) => Math.round((usados / maximo) * 100);
---

<section id="parches" class="seccion-evento" aria-labelledby="h-parches">
  <div class="cabecera">
    <div>
      <h2 id="h-parches" class="titulo-seccion">Parches para este evento</h2>
      <p class="sub">Únete a un grupo para llegar acompañado, o arma el tuyo.</p>
    </div>
    <a class="armar" href={rutaNuevoParche(eventoId)}>
      <Icono nombre="mas" tamano={16} grosor={2.2} />
      Armar parche
    </a>
  </div>

  <div role="tablist" aria-label="Parches y muro" class="pestanas" data-pestanas>
    <button type="button" role="tab" id="pestana-parches" aria-controls="panel-parches" aria-selected="true">
      Parches ({d.parches.length})
    </button>
    <button type="button" role="tab" id="pestana-muro" aria-controls="panel-muro" aria-selected="false" tabindex="-1">
      Muro ({d.conteoMuro})
    </button>
  </div>

  <div role="tabpanel" id="panel-parches" aria-labelledby="pestana-parches" class="panel-parches">
    {
      d.parches.map((p) => {
        const usados = p.usados;
        return (
          <article class="parche" data-parche data-usados={usados - (p.propio ? 1 : 0)} data-maximo={p.maximo}>
            <span class="av-parche" style={`background: ${p.color}`} aria-hidden="true">{p.iniciales}</span>
            <div class="texto">
              <h3>{p.nombre}</h3>
              <p class="desc">{p.descripcion}</p>
              <div class="cupos">
                <span class="barra" aria-hidden="true"><span style={`width: ${pct(usados, p.maximo)}%`} data-barra /></span>
                <span data-cupos>{usados} de {p.maximo} cupos</span>
              </div>
            </div>
            <button type="button" class="unirme" aria-pressed={p.propio ? 'true' : 'false'} data-unirme>
              {p.propio ? 'Estás dentro' : 'Unirme'}
            </button>
          </article>
        );
      })
    }
  </div>

  <div role="tabpanel" id="panel-muro" aria-labelledby="pestana-muro" class="panel-muro" hidden>
    <form class="compositor" data-muro>
      <span class="av" style={`background: ${colorDe[usuaria.color]}`} aria-hidden="true">{usuaria.iniciales}</span>
      <label class="campo">
        <span class="solo-lectores">Escribe en el muro</span>
        <input type="text" name="mensaje" placeholder="Pregunta o comenta algo del evento" autocomplete="off" />
      </label>
      <button type="submit">Enviar</button>
    </form>
    <p class="aviso" role="status" data-aviso-muro></p>
    {
      d.muro.map((msj) => {
        const p = persona(msj.persona)!;
        return (
          <div class="mensaje">
            <a href={`/perfil/${p.id}`} class="av" style={`background: ${colorDe[p.color]}`} aria-label={`Perfil de ${p.nombre}`}>
              {p.iniciales}
            </a>
            <div class="burbuja">
              <span class="quien">
                <b>{p.nombre}</b> <span>· {msj.hace}</span>
              </span>
              <p>{msj.texto}</p>
            </div>
          </div>
        );
      })
    }
  </div>
</section>

<script>
  // Pestañas con flechas, Inicio/Fin y tabindex itinerante (N63, H59)
  document.querySelectorAll<HTMLElement>('[data-pestanas]').forEach((lista) => {
    const pestanas = [...lista.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
    const elegir = (p: HTMLButtonElement, enfocar = false) => {
      pestanas.forEach((t) => {
        const activa = t === p;
        t.setAttribute('aria-selected', String(activa));
        t.tabIndex = activa ? 0 : -1;
        document.getElementById(t.getAttribute('aria-controls')!)!.hidden = !activa;
      });
      if (enfocar) p.focus();
    };
    pestanas.forEach((p, i) => {
      p.addEventListener('click', () => elegir(p));
      p.addEventListener('keydown', (ev) => {
        const destino =
          ev.key === 'ArrowRight' ? pestanas[(i + 1) % pestanas.length]
          : ev.key === 'ArrowLeft' ? pestanas[(i - 1 + pestanas.length) % pestanas.length]
          : ev.key === 'Home' ? pestanas[0]
          : ev.key === 'End' ? pestanas[pestanas.length - 1]
          : null;
        if (destino) {
          ev.preventDefault();
          elegir(destino, true);
        }
      });
    });
  });

  // "Unirme" ↔ "Estás dentro" con cupos. En producción es una solicitud que se acepta (H9, H30).
  document.querySelectorAll<HTMLElement>('[data-parche]').forEach((parche) => {
    const boton = parche.querySelector<HTMLButtonElement>('[data-unirme]')!;
    const base = Number(parche.dataset.usados);
    const maximo = Number(parche.dataset.maximo);
    boton.addEventListener('click', () => {
      const dentro = boton.getAttribute('aria-pressed') !== 'true';
      boton.setAttribute('aria-pressed', String(dentro));
      boton.textContent = dentro ? 'Estás dentro' : 'Unirme';
      const usados = base + (dentro ? 1 : 0);
      parche.querySelector('[data-cupos]')!.textContent = `${usados} de ${maximo} cupos`;
      parche.querySelector<HTMLElement>('[data-barra]')!.style.width = `${Math.round((usados / maximo) * 100)}%`;
    });
  });

  // Publicar en el muro necesita backend y moderación (H9, H38): por ahora "Próximamente".
  document.querySelector<HTMLFormElement>('[data-muro]')?.addEventListener('submit', (ev) => {
    ev.preventDefault();
    const aviso = document.querySelector<HTMLElement>('[data-aviso-muro]')!;
    aviso.textContent = '';
    requestAnimationFrame(() => (aviso.textContent = 'Próximamente'));
  });
</script>

<style>
  .cabecera {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 10px 16px;
  }

  .sub {
    margin-top: 4px;
    color: var(--muted);
  }

  .armar {
    height: 40px;
    border: 1px solid var(--ink);
    background: var(--surface);
    border-radius: var(--radius-pill);
    padding: 0 16px;
    font-weight: 700;
    font-size: .86rem;
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .pestanas {
    display: flex;
    gap: 4px;
    overflow-x: auto;
    box-shadow: inset 0 -1px 0 var(--line);
  }

  [role='tab'] {
    flex-shrink: 0;
    white-space: nowrap;
    height: 48px;
    border: 0;
    border-bottom: 3px solid transparent;
    background: transparent;
    padding: 0 16px;
    font-size: .95rem;
    font-weight: 700;
    color: var(--muted);
  }

  [role='tab'][aria-selected='true'] {
    color: var(--ink);
    border-bottom-color: var(--brand);
  }

  [role='tab']:focus-visible {
    outline-offset: -3px;
  }

  .panel-parches {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .parche {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius-card);
    padding: 16px 18px;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 14px 18px;
  }

  .av-parche {
    flex-shrink: 0;
    width: 52px;
    height: 52px;
    border-radius: 14px;
    display: grid;
    place-items: center;
    font-family: var(--display);
    font-weight: 900;
    font-size: 15px;
  }

  .texto {
    flex: 1 1 240px;
    min-width: 0;
  }

  h3 {
    font-size: 1.02rem;
    font-weight: 700;
  }

  .desc {
    margin-top: 2px;
    font-size: .86rem;
    color: var(--muted);
  }

  .cupos {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-top: 8px;
    font-size: .8rem;
    color: var(--muted);
  }

  .barra {
    flex: 0 1 160px;
    height: 8px;
    border-radius: 4px;
    background: var(--line);
    overflow: hidden;
  }

  .barra span {
    display: block;
    height: 100%;
    background: var(--brand);
  }

  .unirme {
    height: 42px;
    border: 0;
    border-radius: var(--radius-pill);
    padding: 0 18px;
    font-size: .86rem;
    font-weight: 700;
    color: var(--on-dark);
    background: var(--brand);
  }

  .unirme[aria-pressed='true'] {
    background: var(--ink);
  }

  .panel-muro {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .compositor {
    display: flex;
    gap: 10px;
    align-items: center;
  }

  .av {
    flex-shrink: 0;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    font-weight: 700;
    font-size: .78rem;
    color: var(--ink);
  }

  .campo {
    position: relative;
    flex: 1;
    min-width: 0;
  }

  .campo input {
    width: 100%;
    height: 44px;
    border: 1px solid var(--borde-campo);
    border-radius: var(--radius-pill);
    padding: 0 16px;
    background: var(--surface);
    font-size: .95rem;
    color: var(--ink);
  }

  .campo input::placeholder {
    color: var(--placeholder);
  }

  .compositor button {
    height: 44px;
    border: 0;
    border-radius: var(--radius-pill);
    padding: 0 18px;
    background: var(--brand);
    color: var(--on-dark);
    font-weight: 700;
  }

  .aviso:empty {
    display: none;
  }

  .aviso {
    font-size: .86rem;
    color: var(--muted);
    margin-top: -6px;
  }

  .mensaje {
    display: flex;
    gap: 12px;
  }

  .burbuja {
    min-width: 0;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 4px 16px 16px 16px;
    padding: 10px 14px;
    line-height: 1.4;
  }

  .quien {
    font-size: .86rem;
  }

  .quien span {
    color: var(--muted);
  }
</style>
