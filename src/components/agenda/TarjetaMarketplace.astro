---
// N15 · Tarjeta de evento de la Agenda (decisión 2.35): la misma tarjeta afiche de la Bienvenida (TarjetaAfiche)
// con lo propio de la Agenda: Repostear junto a Guardar, la marca "Reposteaste" y la línea social de reposts.
// La interactividad (guardar, repostear) la maneja el script de la página (AgendaApp). "Enviar a un amigo"
// (H38, "Próximamente") sale de la tarjeta para dejarla limpia; vuelve cuando exista la hoja de enviar.
import Icono from '../ui/Icono.astro';
import PilaAvatares from '../ui/PilaAvatares.astro';
import TarjetaAfiche from '../eventos/TarjetaAfiche.astro';
import { categoriaOficialDe, ciudadDe, esGratis, type Evento } from '../../data/eventos';
import { lineaRepost, type SocialAgenda } from '../../data/agenda';
import { cifra, placaFecha } from '../../lib/formato';
import { textoBuscable } from '../../lib/filtros-agenda';

interface Props {
  evento: Evento;
  social: SocialAgenda;
  reposteado?: boolean;
  oculta?: boolean;
}

const { evento: e, social, reposteado = false, oculta = false } = Astro.props;
const { dia, mes } = placaFecha(e.fecha);
const ciudad = ciudadDe(e);
const tituloId = `tarjeta-${e.id}-titulo`;
// Texto sin tildes para la búsqueda del encabezado (el mismo con el que busca el servidor)
const texto = textoBuscable(e);
---

<!-- H59 pide un encabezado por tarjeta; aquí cuelgan directo del h1 de la página, por eso h2 -->
<TarjetaAfiche
  evento={e}
  nivel={2}
  tituloId={tituloId}
  oculta={oculta}
  datos={{
    'data-etiquetas': e.etiquetas.join(' '),
    // Filtros de la etapa B2: categoría oficial (una de las 14) y "Gratis" aparte
    'data-oficial': categoriaOficialDe(e) ?? '',
    'data-gratis': String(esGratis(e)),
    'data-fecha': e.fecha,
    'data-amigos': String(social.amigos),
    'data-texto': texto,
    'data-quien': social.quien,
    'data-reposts': social.reposts,
    'data-titulo': e.titulo,
    'data-categoria': e.categoria,
    'data-lugar': e.lugar,
    'data-nombre-ciudad': ciudad,
    'data-dia': dia,
    'data-mes': mes,
    'data-bg1': e.bg1,
    'data-bg2': e.bg2,
  }}
  guardar={{
    // H41: "Guardar" usa el marcador (el corazón es "Me gusta" en Inicio)
    'data-guardar': '',
    'data-requiere-cuenta': 'para guardar tus planes',
    'data-retomar': `guardar-${e.id}`,
    'data-retomar-aviso': `Listo: guardaste ${e.titulo}.`,
  }}
>
  <!-- El servidor lo pinta como lo ve el visitante; con sesión, AgendaApp aplica el repost de la usuaria
       (data-reposteado-sesion) -->
  <button
    slot="acciones"
    type="button"
    class="repostear"
    aria-pressed="false"
    data-repostear
    data-reposteado-sesion={reposteado ? '' : undefined}
    data-abrir-modal="ventana-repost"
    data-requiere-cuenta="para repostear planes"
    data-retomar={`repostear-${e.id}`}
  >
    <Icono nombre="repost" tamano={18} grosor={2.2} />
    <span class="solo-lectores"><span data-repostear-texto>Repostear</span> {e.titulo}</span>
  </button>

  <span slot="marca" class="marca solo-sesion" hidden={!reposteado} data-marca>
    <Icono nombre="repost" tamano={13} grosor={2.6} />Reposteaste
  </span>

  <!-- Con sesión: quiénes de tu gente lo repostearon; al visitante, solo el total (decisión 2.24) -->
  <Fragment slot="social">
    <span class="social solo-sesion">
      <PilaAvatares colores={social.colores} tamano={22} solape={7} borde="hero" />
      <span data-linea>{lineaRepost(social, reposteado)}</span>
    </span>
    {
      social.reposts > 0 && (
        <span class="social solo-visitante">
          <Icono nombre="repost" tamano={15} grosor={2.2} />
          {cifra(social.reposts)} {social.reposts === 1 ? 'repost' : 'reposts'}
        </span>
      )
    }
  </Fragment>
</TarjetaAfiche>

<style>
  .repostear {
    width: 44px;
    height: 44px;
    border: 0;
    border-radius: 50%;
    background: rgba(255, 255, 255, .94);
    display: grid;
    place-items: center;
    color: var(--ink);
  }

  .repostear[aria-pressed='true'] {
    background: var(--lime);
  }

  .marca {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    margin-bottom: 8px;
    padding: 4px 10px;
    border-radius: var(--radius-pill);
    background: var(--lime);
    color: var(--ink);
    font-size: .76rem;
    font-weight: 700;
  }

  .social {
    display: flex;
    align-items: center;
    gap: 7px;
    min-width: 0;
    font-size: .84rem;
    font-weight: 600;
  }

  [data-linea] {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
</style>
