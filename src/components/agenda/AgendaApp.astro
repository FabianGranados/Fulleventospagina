---
// Agenda (4.6): cabecera con vista y fecha, filtros de ciudad y categoría (en la URL),
// aviso de repost, línea de resultados, estado vacío, rejilla paginada y región viva (H49).
// Dos modos (etapa B3):
// - Estática (sin D1): salen todas las tarjetas y el script filtra en el navegador; 8 y "Ver N planes más" (H47).
// - Bajo demanda (con D1, prop `filtros`): el servidor filtra y manda solo una página de 24, con enlaces
//   "Anterior" y "Siguiente" que funcionan sin JavaScript. Al cambiar un filtro el script pide la nueva URL.
import Icono from '../ui/Icono.astro';
import EnlaceSubrayado from '../ui/EnlaceSubrayado.astro';
import TarjetaMarketplace from './TarjetaMarketplace.astro';
import BotonFiltro from '../filtros/BotonFiltro.astro';
import BotonGratis from '../filtros/BotonGratis.astro';
import HojaFiltro from '../filtros/HojaFiltro.astro';
import OpcionFiltro from '../filtros/OpcionFiltro.astro';
import { ciudades, nombreCiudad } from '../../data/ciudades';
import { eventos as eventosDemo, type Evento } from '../../data/eventos';
import { socialAgenda, reposteadosIniciales, categoriasAgenda, fechasAgenda } from '../../data/agenda';
import { planes, ciudadesTexto } from '../../lib/formato';
import {
  FILTROS_INICIALES,
  consultaAgenda,
  fechaAgenda,
  intercalar,
  resultadoAgenda,
  type FiltrosAgenda,
} from '../../lib/filtros-agenda';

interface Props {
  // Eventos publicados (etapa B2: lib/datos-eventos.ts, de D1 o de eventos.ts)
  eventos?: Evento[];
  // Solo bajo demanda (etapa B3): los filtros de la URL, que el servidor aplica
  filtros?: FiltrosAgenda;
}

const { eventos = eventosDemo, filtros } = Astro.props;
const servidor = Boolean(filtros);
const f = filtros ?? FILTROS_INICIALES;

// H47: 8 tarjetas y "Ver N planes más", como en la Bienvenida (solo en la página estática)
const PAGINA = 8;

// Estático: todas las tarjetas (el script filtra) y el estado inicial "Este finde", todo el país, "Para ti".
// Bajo demanda: solo la página pedida, ya filtrada.
const r = resultadoAgenda(eventos, f);
const tarjetas = servidor ? r.planes : intercalar(eventos);
const enPagina = new Set(servidor ? r.planes : resultadoAgenda(eventos, f, eventos.length || 1).planes.slice(0, PAGINA));
const siguientes = servidor ? 0 : Math.min(PAGINA, r.total - PAGINA);

// Textos de la cabecera y de la línea de resultados (los mismos que pinta el script)
const fecha = fechaAgenda(f.fecha);
const lugar = f.ciudad === 'all' ? 'Colombia' : nombreCiudad(f.ciudad);
const busqueda = f.q ? ` para «${f.q}»` : '';
const donde = f.ciudad !== 'all' ? `en ${lugar}` : r.total ? `en ${ciudadesTexto(r.ciudades)}` : `en ${lugar}`;
const textoCategoria = categoriasAgenda.find((c) => c.id === f.categoria)?.texto ?? 'Para ti';
const mensajeVacio =
  f.fecha === 'finde'
    ? `Por ahora no hay planes con este filtro en ${lugar} este finde. Prueba otra ciudad o mira todo el país.`
    : `${fecha.titulo} no hay planes con este filtro en ${lugar}: mira el finde.`;
const conFiltro = f.ciudad !== 'all' || f.categoria !== 'all' || f.gratis || f.q !== '';
// Al cambiar de página se vuelve a los resultados (el script les pasa el foco)
const enlacePagina = (pagina: number) => `/agenda${consultaAgenda({ ...f, pagina })}#agenda-resultados`;
---

<div class="agenda" data-agenda-app data-pagina={PAGINA} data-servidor={servidor ? '' : undefined}>
  <div class="cabecera">
    <div class="titulos">
      <!-- "Para ti" solo con sesión: el visitante ve la agenda de todo el país, sin gustos (decisión 2.24) -->
      <p class="antetitulo"><span class="solo-sesion">Agenda para ti</span><span class="solo-visitante">Agenda</span></p>
      <h1 id="agenda-titulo" tabindex="-1" data-titulo>{`${fecha.titulo} en ${lugar}`}</h1>
      <p class="bajada solo-sesion">
        Elegidos por tus gustos (salsa, rock, fútbol y planes gratis) en todo el país, de la costa al Amazonas,
        empezando por Bogotá. Repostea los que te gusten para que tu gente los vea.
      </p>
      <p class="bajada solo-visitante">
        Planes en todo el país, de la costa al Amazonas, empezando por Bogotá. Crea tu cuenta para guardarlos,
        repostearlos y ver a qué va tu gente.
      </p>
    </div>
    <div class="controles">
      <nav aria-label="Vista" class="segmentado">
        <a href="/agenda" aria-current="page" class="opcion-vista" data-vista-lista>
          <Icono nombre="lista" tamano={16} grosor={2.2} />Lista
        </a>
        <a href="/mapa" class="opcion-vista" data-vista-mapa><Icono nombre="mapa" tamano={16} />Mapa</a>
      </nav>
      {
        servidor ? (
          // Bajo demanda (etapa B3): cada fecha es otra página, así que son enlaces (WCAG 3.2.2: elegir con las
          // flechas no recarga nada) y funcionan sin JavaScript
          <nav aria-label="Fecha" class="segmentado fechas">
            {fechasAgenda.map((x) => (
              <a
                href={`/agenda${consultaAgenda({ ...f, fecha: x.id, pagina: 1 })}#agenda-resultados`}
                class="opcion-fecha"
                aria-current={x.id === f.fecha ? 'page' : undefined}
              >
                {x.texto}
              </a>
            ))}
          </nav>
        ) : (
          // H59: grupo excluyente con radios nativos; H39: filtra de verdad
          <fieldset class="segmentado fechas">
            <legend class="solo-lectores">Fecha</legend>
            {fechasAgenda.map((x) => (
              <label class="opcion-fecha">
                <input type="radio" name="agenda-fecha" value={x.id} checked={x.id === f.fecha} data-fecha />
                {x.texto}
              </label>
            ))}
          </fieldset>
        )
      }
    </div>
  </div>

  <!-- Filtros de ciudad y categoría (decisión 2.35): dos botones que abren una hoja con las opciones, en vez de
       dos filas de chips. Los radios viven en las hojas; el resultado se aplica al elegir y la página se ve detrás -->
  <div class="filtros">
    <BotonFiltro hoja="filtro-ciudad" filtro="ciudad" rotulo="Ciudad" icono="pin" activo={f.ciudad !== 'all'}>{f.ciudad === 'all' ? 'Toda Colombia' : lugar}</BotonFiltro>
    <BotonFiltro hoja="filtro-categoria" filtro="categoria" rotulo="Categoría" icono="filtro" activo={f.categoria !== 'all'}>{
      f.categoria === 'all' ? (
        <><span class="solo-sesion">Para ti</span><span class="solo-visitante">Todas las categorías</span></>
      ) : (
        textoCategoria
      )
    }</BotonFiltro>
    <!-- "Gratis" no es una categoría (etapa B2): se suma a cualquiera de las 14 -->
    <BotonGratis activo={f.gratis} />
  </div>

  <HojaFiltro id="filtro-ciudad" titulo="Ciudad" leyenda="Filtrar por ciudad">
    <OpcionFiltro nombre="agenda-ciudad" valor="all" atributo="ciudad" checked={f.ciudad === 'all'} icono="pin" conteo={r.conteoCiudad.all}>Toda Colombia</OpcionFiltro>
    {
      ciudades.map((c) => (
        <OpcionFiltro
          nombre="agenda-ciudad"
          valor={c.id}
          atributo="ciudad"
          checked={f.ciudad === c.id}
          conteo={r.conteoCiudad[c.id] ?? 0}
          class={(r.conteoCiudad[c.id] ?? 0) === 0 ? 'vacia' : undefined}
        >
          {c.nombre}
        </OpcionFiltro>
      ))
    }
  </HojaFiltro>

  <HojaFiltro id="filtro-categoria" titulo="Categoría" leyenda="Filtrar por categoría">
    {
      // Bajo demanda no va "Lo que repostea tu gente": son datos de la usuaria y la página se guarda en caché pública
      categoriasAgenda.filter((c) => !servidor || c.id !== 'amigos').map((c) => {
        return (
          <OpcionFiltro
            nombre="agenda-categoria"
            valor={c.id}
            atributo="categoria"
            checked={c.id === f.categoria}
            icono={c.icono ?? (c.id === 'amigos' ? 'repost' : 'filtro')}
            conteo={c.icono ? r.conteoCategoria[c.id] : undefined}
            class={c.id === 'amigos' ? 'solo-sesion' : c.icono && !r.conteoCategoria[c.id] ? 'vacia' : undefined}
          >
            {c.id === 'all' ? (
              <>
                <span class="solo-sesion">{c.texto}</span>
                <span class="solo-visitante">Todas las categorías</span>
              </>
            ) : (
              c.texto
            )}
          </OpcionFiltro>
        );
      })
    }
  </HojaFiltro>

  <!-- N17 · Aviso de repost, en el flujo de la página. Lo anuncia la región viva permanente (H49). -->
  <div class="aviso" hidden data-aviso>
    <Icono nombre="check" tamano={20} grosor={2.4} class="aviso-icono" />
    <span class="aviso-texto" data-aviso-texto></span>
    <a href="/inicio" class="aviso-enlace">Ver en mi feed</a>
    <button type="button" class="aviso-cerrar" aria-label="Cerrar aviso" data-aviso-cerrar>
      <Icono nombre="cerrar" tamano={16} grosor={2.4} />
    </button>
  </div>

  <div class="resultados">
    <p class="conteo-resultados" id="agenda-resultados" tabindex="-1" data-resultados>
      <b>{r.total ? planes(r.total) : 'Sin planes'}</b>{`${busqueda} ${donde} ${fecha.periodo}`}
    </p>
    <div class="resultados-derecha">
      <span class="ejemplo">Contenido de ejemplo</span>
      <EnlaceSubrayado href="/mapa" class="ver-mapa">Ver todos los planes en el mapa</EnlaceSubrayado>
    </div>
  </div>

  <!-- Región viva permanente y vacía (H49) -->
  <p class="solo-lectores" role="status" data-anuncio></p>

  <div class="vacio" hidden={r.total > 0} data-vacio>
    <p data-vacio-mensaje>{mensajeVacio}</p>
    <div class="vacio-botones">
      <button type="button" class="boton-contorno" hidden={f.fecha === 'finde'} data-ver-finde>Ver los planes de este finde</button>
      <button type="button" class="boton-contorno" hidden={f.fecha !== 'finde' && !conFiltro} data-limpiar>Ver todos los planes del país</button>
    </div>
  </div>

  <div class="rejilla" id="agenda-rejilla" data-rejilla>
    {
      tarjetas.map((e) => (
        <TarjetaMarketplace
          evento={e}
          social={socialAgenda[e.id] ?? { quien: '', reposts: 0, colores: [], amigos: false }}
          reposteado={reposteadosIniciales.includes(e.id)}
          oculta={!enPagina.has(e)}
        />
      ))
    }
  </div>

  {
    servidor && r.paginas > 1 && (
      <nav class="paginacion" aria-label="Páginas de la agenda">
        {r.pagina > 1 ? (
          <a href={enlacePagina(r.pagina - 1)} rel="prev" class="boton-contorno pagina-enlace">
            <Icono nombre="volver" tamano={16} grosor={2.2} />
            Anterior
          </a>
        ) : (
          <span class="pagina-hueco" />
        )}
        <span class="pagina-actual">
          Página {r.pagina} de {r.paginas}
        </span>
        {r.pagina < r.paginas ? (
          <a href={enlacePagina(r.pagina + 1)} rel="next" class="boton-contorno pagina-enlace">
            Siguiente
            <Icono nombre="siguiente" tamano={16} grosor={2.2} />
          </a>
        ) : (
          <span class="pagina-hueco" />
        )}
      </nav>
    )
  }

  <div class="mas" hidden={siguientes <= 0} data-mas-contenedor>
    <button type="button" class="boton-contorno grande" aria-controls="agenda-rejilla" data-mas>
      {`Ver ${siguientes} ${siguientes === 1 ? 'plan más' : 'planes más'}`}
    </button>
  </div>
</div>

<script>
  import { ciudades } from '../../data/ciudades';
  import { fechasAgenda, destinosRepost, lineaRepost } from '../../data/agenda';
  import { planes, ciudadesTexto, slug } from '../../lib/formato';
  import { haySesion } from '../../lib/sesion';
  import { consultaAgenda, leerFiltros } from '../../lib/filtros-agenda';

  const raiz = document.querySelector<HTMLElement>('[data-agenda-app]');

  if (raiz) {
    const PAGINA = Number(raiz.dataset.pagina);
    // Bajo demanda (etapa B3): el servidor ya filtró y paginó; cambiar un filtro pide la nueva URL
    const servidor = raiz.dataset.servidor !== undefined;
    const conSesion = haySesion();
    const nombres: Record<string, string> = Object.fromEntries(ciudades.map((c) => [c.id, c.nombre]));
    const fechas = Object.fromEntries(fechasAgenda.map((f) => [f.id, f]));

    const $ = <T extends HTMLElement = HTMLElement>(sel: string) => raiz.querySelector<T>(sel)!;
    const $$ = <T extends HTMLElement = HTMLElement>(sel: string) => [...raiz.querySelectorAll<T>(sel)];

    const rejilla = $('[data-rejilla]');
    const tarjetas = $$('[data-tarjeta]');
    const radiosCiudad = $$<HTMLInputElement>('input[data-ciudad]');
    const radiosCategoria = $$<HTMLInputElement>('input[data-categoria]');
    const radiosFecha = $$<HTMLInputElement>('input[data-fecha]');
    const titulo = $('[data-titulo]');
    const resultados = $('[data-resultados]');
    const anuncio = $('[data-anuncio]');
    const vacio = $('[data-vacio]');
    const mensajeVacio = $('[data-vacio-mensaje]');
    const botonFinde = $<HTMLButtonElement>('[data-ver-finde]');
    const botonLimpiar = $<HTMLButtonElement>('[data-limpiar]');
    const contenedorMas = $('[data-mas-contenedor]');
    const botonMas = $<HTMLButtonElement>('[data-mas]');
    const aviso = $('[data-aviso]');
    const avisoTexto = $('[data-aviso-texto]');
    const vistaLista = $<HTMLAnchorElement>('[data-vista-lista]');
    const vistaMapa = $<HTMLAnchorElement>('[data-vista-mapa]');
    const verMapa = $<HTMLAnchorElement>('.ver-mapa');
    const botonCiudad = $('[data-filtro="ciudad"]');
    const botonCategoria = $('[data-filtro="categoria"]');
    const botonesVer = $$('[data-ver-resultados]');
    const botonGratis = $<HTMLButtonElement>('[data-filtro-gratis]');

    // Encabezados (N1 con sesión y N2 de visitante, decisión 2.24): selector de ciudad y buscador de los dos;
    // solo uno está visible
    const selectores = [...document.querySelectorAll<HTMLSelectElement>('select[data-selector-ciudad]')];
    const buscadores = [...document.querySelectorAll<HTMLFormElement>('[data-buscador-app]')];
    const camposBusqueda = buscadores.flatMap((b) => [...b.querySelectorAll<HTMLInputElement>('input[name="q"]')]);

    // Estado: filtros (en la URL) + guardados y reposts (en memoria: demo sin backend)
    const estado = { ciudad: 'all', categoria: 'all', gratis: false, fecha: 'finde', q: '', mostrados: PAGINA };

    const normalizar = (t: string) => slug(t).replace(/-/g, ' ');

    // La misma lectura del servidor (lib/filtros-agenda.ts); "Lo que repostea tu gente" es solo con sesión (2.24)
    const leerUrl = () => {
      const { pagina: _pagina, ...filtros } = leerFiltros(new URLSearchParams(location.search));
      Object.assign(estado, filtros, { mostrados: PAGINA });
      if (estado.categoria === 'amigos' && !conSesion) estado.categoria = 'all';
    };

    // Cambiar un filtro vuelve a la página 1
    const consulta = () => consultaAgenda({ ...estado, pagina: 1 });

    const enlaceMapa = () => {
      const p = new URLSearchParams();
      if (estado.ciudad !== 'all') p.set('ciudad', estado.ciudad);
      // El mapa filtra con las mismas 14 categorías y "Gratis" aparte (etapa B3)
      if (estado.categoria !== 'all' && estado.categoria !== 'amigos') p.set('categoria', estado.categoria);
      if (estado.gratis) p.set('gratis', '1');
      if (estado.fecha !== 'finde') p.set('fecha', estado.fecha);
      const s = p.toString();
      return s ? `/mapa?${s}` : '/mapa';
    };

    // Filtros sin la ciudad (para los conteos de las ciudades) y con la ciudad (para la rejilla)
    // `cat` permite contar con otra categoría (los conteos de la hoja de categorías)
    const pasaSinCiudad = (t: HTMLElement, cat = estado.categoria) => {
      const d = t.dataset;
      const f = fechas[estado.fecha];
      if (d.fecha! < f.desde || d.fecha! > f.hasta) return false;
      if (cat === 'amigos' && d.amigos !== 'true') return false;
      if (cat !== 'all' && cat !== 'amigos' && d.oficial !== cat) return false;
      if (estado.gratis && d.gratis !== 'true') return false;
      if (estado.q && !normalizar(estado.q).split(' ').every((p) => d.texto!.includes(p))) return false;
      return true;
    };

    const ordenar = (lista: HTMLElement[]) => {
      if (estado.ciudad !== 'all') return lista;
      const grupos = ciudades.map((c) => lista.filter((t) => t.dataset.ciudad === c.id));
      const salida: HTMLElement[] = [];
      for (let i = 0; grupos.some((g) => g[i]); i++) for (const g of grupos) if (g[i]) salida.push(g[i]);
      // Municipios que aún no son ciudades del sitio (eventos de D1), al final
      return [...salida, ...lista.filter((t) => !nombres[t.dataset.ciudad!])];
    };

    const lugar = () => (estado.ciudad === 'all' ? 'Colombia' : nombres[estado.ciudad]);
    const busqueda = () => (estado.q ? ` para «${estado.q}»` : '');

    let visibles: HTMLElement[] = [];

    const pintar = ({ anunciar = true, url = true } = {}) => {
      const f = fechas[estado.fecha];
      const base = tarjetas.filter((t) => pasaSinCiudad(t));
      const coinciden = base.filter((t) => estado.ciudad === 'all' || t.dataset.ciudad === estado.ciudad);
      visibles = ordenar(coinciden);

      tarjetas.forEach((t) => (t.hidden = true));
      visibles.forEach((t, i) => {
        rejilla.append(t);
        t.hidden = i >= estado.mostrados;
      });

      // Controles
      radiosCiudad.forEach((r) => (r.checked = r.value === estado.ciudad));
      radiosCategoria.forEach((r) => (r.checked = r.value === estado.categoria));
      radiosFecha.forEach((r) => (r.checked = r.value === estado.fecha));
      selectores.forEach((s) => (s.value = estado.ciudad));
      camposBusqueda.forEach((c) => document.activeElement !== c && (c.value = estado.q));

      // Botones de filtro: muestran lo elegido y se marcan si hay filtro (decisión 2.35)
      const elegido = (radios: HTMLInputElement[], valor: string) =>
        radios.find((r) => r.value === valor)?.closest('label')?.querySelector('[data-nombre]')?.innerHTML ?? '';
      botonCiudad.querySelector('[data-filtro-texto]')!.innerHTML = elegido(radiosCiudad, estado.ciudad);
      botonCategoria.querySelector('[data-filtro-texto]')!.innerHTML = elegido(radiosCategoria, estado.categoria);
      botonCiudad.classList.toggle('activo', estado.ciudad !== 'all');
      botonCategoria.classList.toggle('activo', estado.categoria !== 'all');
      botonGratis.setAttribute('aria-pressed', String(estado.gratis));
      botonesVer.forEach((b) => (b.textContent = visibles.length ? `Ver ${planes(visibles.length)}` : 'Ver resultados'));

      // Conteos de las ciudades: siguen la categoría, la fecha y la búsqueda
      const pintarConteo = (r: HTMLInputElement, n: number) => {
        const caja = r.closest('label')!.querySelector('[data-conteo]');
        if (caja) {
          caja.firstChild!.textContent = String(n);
          caja.querySelector('.solo-lectores')!.textContent = n === 1 ? ' plan' : ' planes';
        }
        // Las opciones sin planes se atenúan (siguen elegibles: el estado vacío lo explica)
        r.closest('label')!.classList.toggle('vacia', n === 0);
      };
      radiosCiudad.forEach((r) =>
        pintarConteo(r, r.value === 'all' ? base.length : base.filter((t) => t.dataset.ciudad === r.value).length),
      );
      // Conteos de las 14 categorías: siguen la ciudad, la fecha, Gratis y la búsqueda (etapa B2)
      const enCiudad = (t: HTMLElement) => estado.ciudad === 'all' || t.dataset.ciudad === estado.ciudad;
      radiosCategoria
        .filter((r) => r.value !== 'all' && r.value !== 'amigos')
        .forEach((r) => pintarConteo(r, tarjetas.filter((t) => enCiudad(t) && pasaSinCiudad(t, r.value)).length));

      // Título y línea de resultados (H39: dicen la fecha elegida)
      titulo.textContent = `${f.titulo} en ${lugar()}`;
      const nCiudades = new Set(visibles.map((t) => t.dataset.ciudad)).size;
      // Sin resultados no se cuentan "0 planes en 0 ciudades" (B4): "Sin planes … en Colombia", como el Mapa
      const donde =
        estado.ciudad !== 'all' ? `en ${nombres[estado.ciudad]}` : visibles.length ? `en ${ciudadesTexto(nCiudades)}` : `en ${lugar()}`;
      resultados.innerHTML = '';
      const negrita = document.createElement('b');
      negrita.textContent = visibles.length ? planes(visibles.length) : 'Sin planes';
      resultados.append(negrita, `${busqueda()} ${donde} ${f.periodo}`);

      // Estado vacío (N67); con otra fecha, uno honesto que invita al finde (H39)
      vacio.hidden = visibles.length > 0;
      const conFiltro = estado.ciudad !== 'all' || estado.categoria !== 'all' || estado.gratis || estado.q !== '';
      if (estado.fecha === 'finde') {
        mensajeVacio.textContent = `Por ahora no hay planes con este filtro en ${lugar()} este finde. Prueba otra ciudad o mira todo el país.`;
        botonFinde.hidden = true;
        botonLimpiar.hidden = false;
      } else {
        const periodo = f.titulo;
        mensajeVacio.textContent = `${periodo} no hay planes con este filtro en ${lugar()}: mira el finde.`;
        botonFinde.hidden = false;
        botonLimpiar.hidden = !conFiltro;
      }

      // Paginación (H47)
      const restantes = visibles.length - estado.mostrados;
      contenedorMas.hidden = restantes <= 0;
      if (restantes > 0) {
        const n = Math.min(PAGINA, restantes);
        botonMas.textContent = `Ver ${n} ${n === 1 ? 'plan más' : 'planes más'}`;
      }

      // Enlaces que conservan el contexto (H42)
      vistaLista.href = `/agenda${consulta()}`;
      vistaMapa.href = enlaceMapa();
      verMapa.href = enlaceMapa();
      if (url) history.replaceState(null, '', `${location.pathname}${consulta()}`);

      if (anunciar) {
        anuncio.textContent = visibles.length
          ? `Mostrando ${planes(Math.min(visibles.length, estado.mostrados))}${busqueda()} ${donde} ${f.periodo}`
          : mensajeVacio.textContent;
      }
    };

    const cambiar = (cambios: Partial<typeof estado>) => {
      Object.assign(estado, { mostrados: PAGINA }, cambios);
      if (servidor) location.assign(`${location.pathname}${consulta()}#agenda-resultados`);
      else pintar();
    };

    // Bajo demanda, elegir en la hoja no recarga (WCAG 3.2.2: con las flechas se pasa por varias opciones): la
    // página filtrada se pide al cerrar la hoja ("Ver resultados", Escape o la X)
    const pendiente: Partial<typeof estado> = {};
    const elegir = (cambios: Partial<typeof estado>) => {
      if (servidor) Object.assign(pendiente, cambios);
      else cambiar(cambios);
    };
    if (servidor)
      document.querySelectorAll<HTMLDialogElement>('#filtro-ciudad, #filtro-categoria').forEach((hoja) =>
        hoja.addEventListener('close', () => {
          const cambia = Object.entries(pendiente).some(([k, v]) => estado[k as keyof typeof estado] !== v);
          if (cambia) cambiar({ ...pendiente });
        }),
      );
    radiosCiudad.forEach((r) => r.addEventListener('change', () => r.checked && elegir({ ciudad: r.value })));
    radiosCategoria.forEach((r) => r.addEventListener('change', () => r.checked && elegir({ categoria: r.value })));
    botonGratis.addEventListener('click', () => cambiar({ gratis: !estado.gratis }));
    radiosFecha.forEach((r) => r.addEventListener('change', () => r.checked && cambiar({ fecha: r.value })));
    // Bajo demanda, la ciudad del encabezado se aplica al buscar (el botón del buscador), no al moverse por la lista
    if (!servidor) selectores.forEach((s) => s.addEventListener('change', () => cambiar({ ciudad: s.value || 'all' })));

    // El encabezado no recarga en esta página (data-agenda-app): aplicamos la búsqueda aquí
    buscadores.forEach((buscador) => buscador.addEventListener('submit', () => {
      const datos = new FormData(buscador);
      cambiar({ q: String(datos.get('q') ?? '').trim(), ciudad: String(datos.get('ciudad') ?? 'all') });
      resultados.focus();
    }));

    botonLimpiar.addEventListener('click', () => {
      cambiar({ ciudad: 'all', categoria: 'all', gratis: false, q: '' });
      titulo.focus();
    });
    botonFinde.addEventListener('click', () => {
      cambiar({ fecha: 'finde' });
      titulo.focus();
    });

    botonMas.addEventListener('click', () => {
      const antes = estado.mostrados;
      estado.mostrados += PAGINA;
      pintar({ url: false });
      // El foco pasa al primer plan nuevo
      visibles[antes]?.querySelector<HTMLAnchorElement>('h2 a')?.focus();
    });

    // Guardar y repostear
    const anunciarTexto = (t: string) => {
      anuncio.textContent = '';
      requestAnimationFrame(() => (anuncio.textContent = t));
    };

    const marcarRepost = (t: HTMLElement, reposteado: boolean) => {
      const boton = t.querySelector<HTMLElement>('[data-repostear]')!;
      boton.setAttribute('aria-pressed', String(reposteado));
      t.querySelector('[data-repostear-texto]')!.textContent = reposteado ? 'Reposteado' : 'Repostear';
      t.querySelector<HTMLElement>('[data-marca]')!.hidden = !reposteado;
      t.querySelector('[data-linea]')!.textContent = lineaRepost(
        { quien: t.dataset.quien!, reposts: Number(t.dataset.reposts), colores: ['c1', 'c1'], amigos: false },
        reposteado,
      );
    };

    raiz.addEventListener('click', (ev) => {
      const objetivo = ev.target as HTMLElement;
      const guardar = objetivo.closest<HTMLButtonElement>('[data-guardar]');
      if (guardar) {
        guardar.setAttribute('aria-pressed', String(guardar.getAttribute('aria-pressed') !== 'true'));
        return;
      }
      const repostear = objetivo.closest<HTMLButtonElement>('[data-repostear]');
      // "Reposteado" quita el repost sin abrir la ventana y cierra el aviso (6.2.4)
      if (repostear && repostear.getAttribute('aria-pressed') === 'true') {
        ev.stopPropagation();
        const t = repostear.closest<HTMLElement>('[data-tarjeta]')!;
        marcarRepost(t, false);
        aviso.hidden = true;
        anunciarTexto(`Quitaste el repost de «${t.dataset.titulo}».`);
      }
    });

    document.addEventListener('repost:confirmado', (ev) => {
      const { id, destino } = (ev as CustomEvent<{ id: string; destino: string }>).detail;
      const t = tarjetas.find((x) => x.dataset.id === id);
      if (!t) return;
      marcarRepost(t, true);
      const donde = destinosRepost.find((d) => d.id === destino) ?? destinosRepost[0];
      const texto = `Reposteaste «${t.dataset.titulo}» en ${donde.aviso}.`;
      avisoTexto.textContent = texto;
      aviso.hidden = false;
      anunciarTexto(texto);
    });

    $('[data-aviso-cerrar]').addEventListener('click', () => {
      aviso.hidden = true;
      resultados.focus();
    });

    // Atrás y adelante del navegador (bajo demanda cada URL es una página propia)
    if (!servidor)
      addEventListener('popstate', () => {
        leerUrl();
        pintar({ url: false });
      });

    // Con sesión, los reposts de la usuaria del demo (el servidor pinta la tarjeta como la ve el visitante)
    if (conSesion) tarjetas.filter((t) => t.querySelector('[data-reposteado-sesion]')).forEach((t) => marcarRepost(t, true));

    leerUrl();
    if (!servidor) pintar({ anunciar: false, url: false });
    // Bajo demanda: "Lo que repostea tu gente" sin sesión vuelve a todas las categorías
    else {
      // Los enlaces al mapa llevan los filtros de la página
      vistaMapa.href = enlaceMapa();
      verMapa.href = enlaceMapa();
      // El buscador y el selector de ciudad del encabezado muestran lo que se está viendo (si no, buscar borraría la
      // ciudad elegida)
      selectores.forEach((s) => (s.value = estado.ciudad));
      camposBusqueda.forEach((c) => (c.value = estado.q));
      // Después de cambiar un filtro o de página, el foco queda en los resultados (H49): no hay que recorrer otra vez
      // el encabezado y los filtros
      if (location.hash === '#agenda-resultados') resultados.focus();
    }
  }
</script>

