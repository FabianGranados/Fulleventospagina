---
// Foto real del evento desde R2 (src/lib/fotos-eventos.ts, docs/imagenes-r2.md). Ocupa todo el contenedor
// (position: absolute; inset: 0) y el contenedor conserva su degradado como marcador y respaldo: sin foto
// publicada, sin índice o con IMAGENES_URL vacía no cambia nada de lo que se ve hoy.
// - `capa="fondo"`: queda debajo de todo el contenido que no está posicionado (texto de las tarjetas afiche).
//   El contenedor necesita `position: relative` (o absolute), `overflow: hidden` e `isolation: isolate`.
// - `capa="normal"`: se pinta en el orden del HTML (miniaturas con otras capas posicionadas encima).
// - `velo`: capa oscura sobre la foto para que el texto blanco tenga contraste ("abajo" = afiche; "completo" =
//   héroe del evento). Solo aparece cuando la foto cargó, así no oscurece el degradado.
// - `conAlt`: usa el texto alternativo del índice (detalle del evento). En las tarjetas la foto es decorativa
//   porque el título del evento está al lado.
interface Props {
  id: string;
  tamano?: 'tarjeta' | 'detalle' | 'mini' | 'media';
  capa?: 'fondo' | 'normal';
  velo?: 'ninguno' | 'abajo' | 'completo';
  conAlt?: boolean;
}

const { id, tamano = 'tarjeta', capa = 'fondo', velo = 'ninguno', conAlt = false } = Astro.props;
---

<span
  class:list={['foto-evento', `capa-${capa}`, `velo-${velo}`]}
  data-foto-evento={id}
  data-tamano={tamano}
  data-con-alt={conAlt ? '' : undefined}
  aria-hidden={conAlt ? undefined : 'true'}
></span>

<script>
  import { pintarFotos } from '../../lib/fotos-eventos';

  pintarFotos();
</script>

<style>
  .foto-evento {
    position: absolute;
    inset: 0;
    display: block;
    overflow: hidden;
    pointer-events: none;
  }

  .capa-fondo {
    z-index: -1;
  }

  .foto-evento :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    transition: opacity 240ms ease-out;
  }

  .cargada :global(img) {
    opacity: 1;
  }

  .velo-abajo.cargada::after,
  .velo-completo.cargada::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  /* Igual a la capa oscura de la tarjeta afiche: el texto blanco conserva el contraste sobre cualquier foto */
  .velo-abajo.cargada::after {
    background: linear-gradient(180deg, rgba(20, 14, 16, .05) 30%, rgba(20, 14, 16, .6) 62%, rgba(20, 14, 16, .92) 100%);
  }

  .velo-completo.cargada::after {
    background:
      linear-gradient(90deg, rgba(20, 14, 16, .78) 0%, rgba(20, 14, 16, .45) 55%, rgba(20, 14, 16, .2) 100%),
      linear-gradient(180deg, rgba(20, 14, 16, 0) 40%, rgba(20, 14, 16, .7) 100%);
  }

  @media (prefers-reduced-motion: reduce) {
    .foto-evento :global(img) {
      transition: none;
    }
  }
</style>
