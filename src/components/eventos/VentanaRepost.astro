---
// N16 · Ventana "Repostear evento" sobre el Modal compartido (N68): Escape, clic afuera,
// foco atrapado y retorno del foco al botón que la abrió (H7). Los destinos son radios (H59).
// Un solo patrón para repostear en Agenda y Mapa (H41). La abre un botón con data-abrir-modal="ventana-repost"
// dentro de una tarjeta [data-tarjeta] con data-id, data-titulo, data-categoria, data-lugar, data-nombre-ciudad,
// data-dia, data-mes, data-bg1 y data-bg2. Al confirmar emite "repost:confirmado" con el id y el destino;
// cada pantalla marca su tarjeta y avisa.
import Modal from '../ui/Modal.astro';
import { usuaria } from '../../data/personas';
import { destinosRepost } from '../../data/agenda';
---

<Modal id="ventana-repost" titulo="Repostear evento">
  <form class="formulario" data-form-repost>
    <div class="comentario">
      <span class="avatar" aria-hidden="true">{usuaria.iniciales}</span>
      <label class="campo">
        <span class="solo-lectores">Comentario</span>
        <textarea name="comentario" rows="3" placeholder="Añade un comentario. Ej.: ¿Quién se apunta?"></textarea>
      </label>
    </div>

    <div class="vista-previa">
      <span class="foto" data-rp-foto></span>
      <div class="texto">
        <span class="categoria" data-rp-categoria></span>
        <b data-rp-titulo></b>
        <span class="detalle" data-rp-detalle></span>
      </div>
    </div>

    <fieldset class="destinos">
      <legend>¿Dónde lo compartes?</legend>
      {
        destinosRepost.map((d, i) => (
          <label class="opcion">
            <input type="radio" name="destino" value={d.id} checked={i === 0} />
            <span class="radio" aria-hidden="true" />
            <span class="opcion-texto">
              <b>{d.titulo}</b>
              <span>{d.detalle}</span>
            </span>
          </label>
        ))
      }
    </fieldset>

    <div class="botones">
      <button type="button" class="cancelar" data-cerrar-modal>Cancelar</button>
      <button type="submit" class="confirmar">Repostear</button>
    </div>
  </form>
</Modal>

<script>
  const dialogo = document.getElementById('ventana-repost') as HTMLDialogElement | null;
  const form = dialogo?.querySelector<HTMLFormElement>('[data-form-repost]');

  if (dialogo && form) {
    let idEvento = '';
    const $ = (sel: string) => dialogo.querySelector<HTMLElement>(sel)!;

    dialogo.addEventListener('modal:abierta', (ev) => {
      const origen = (ev as CustomEvent<{ origen: HTMLElement }>).detail.origen;
      const t = origen.closest<HTMLElement>('[data-tarjeta]');
      if (!t) return;
      const d = t.dataset;
      idEvento = d.id!;
      // Al abrir: comentario vacío y "En mi feed" marcado (8.2.4, detalle 14)
      form.reset();
      $('[data-rp-foto]').style.cssText = `--bg1: ${d.bg1}; --bg2: ${d.bg2}`;
      $('[data-rp-categoria]').textContent = d.categoria!;
      $('[data-rp-titulo]').textContent = d.titulo!;
      $('[data-rp-detalle]').textContent = `${d.dia} ${d.mes} · ${d.lugar} · ${d.nombreCiudad}`;
    });

    form.addEventListener('submit', (ev) => {
      ev.preventDefault();
      const destino = String(new FormData(form).get('destino') ?? 'feed');
      document.dispatchEvent(new CustomEvent('repost:confirmado', { detail: { id: idEvento, destino } }));
      // close() devuelve el foco al botón "Repostear" de la tarjeta (Modal, H7)
      dialogo.close();
    });
  }
</script>

<style>
  .formulario {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .comentario {
    display: flex;
    gap: 12px;
    align-items: flex-start;
  }

  .avatar {
    width: 42px;
    height: 42px;
    flex-shrink: 0;
    border-radius: 50%;
    background: var(--aqua);
    display: grid;
    place-items: center;
    font-weight: 700;
    font-size: .8rem;
  }

  .campo {
    flex: 1;
    min-width: 0;
  }

  textarea {
    display: block;
    width: 100%;
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    padding: 12px 14px;
    font-size: .95rem;
    line-height: 1.5;
    color: var(--ink);
    background: var(--bg);
    resize: none;
  }

  /* H52: placeholder legible (#6E6259) */
  textarea::placeholder {
    color: var(--placeholder);
  }

  .vista-previa {
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    overflow: hidden;
    display: flex;
  }

  .foto {
    width: 110px;
    flex-shrink: 0;
    background: radial-gradient(circle at 70% 30%, var(--bg1) 0, transparent 58%), var(--bg2);
  }

  .texto {
    padding: 12px 14px;
    line-height: 1.3;
    min-width: 0;
  }

  .categoria {
    font-size: .68rem;
    font-weight: 700;
    letter-spacing: .1em;
    text-transform: uppercase;
    color: var(--brand);
  }

  .texto b {
    display: block;
    margin: 2px 0;
  }

  .detalle {
    font-size: .82rem;
    color: var(--muted);
  }

  .destinos {
    position: relative;
    border: 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  legend {
    font-weight: 700;
    font-size: .88rem;
    margin-bottom: 8px;
  }

  .opcion {
    position: relative;
    display: flex;
    align-items: center;
    gap: 12px;
    min-height: 52px;
    border-radius: var(--radius-sm);
    padding: 8px 14px;
    border: 1.5px solid var(--line);
    background: var(--surface);
    color: var(--ink);
    cursor: pointer;
  }

  .opcion input {
    position: absolute;
    opacity: 0;
    width: 1px;
    height: 1px;
  }

  .opcion:has(input:checked) {
    border-color: var(--line-strong);
    background: var(--bg);
  }

  .opcion:has(input:focus-visible) {
    outline: 3px solid var(--brand);
    outline-offset: 2px;
  }

  .radio {
    width: 24px;
    height: 24px;
    flex-shrink: 0;
    border-radius: 50%;
    border: 2px solid var(--line-strong);
    display: grid;
    place-items: center;
  }

  .radio::after {
    content: '';
    width: 10px;
    height: 10px;
    border-radius: 50%;
  }

  .opcion:has(input:checked) .radio::after {
    background: var(--ink);
  }

  .opcion-texto {
    line-height: 1.25;
  }

  .opcion-texto b {
    font-size: .9rem;
  }

  .opcion-texto span {
    display: block;
    font-size: .78rem;
    color: var(--muted);
  }

  .botones {
    display: flex;
    justify-content: flex-end;
    gap: 10px;
  }

  /* 8.2.4 detalle 31: tamaño explícito (.9rem, el de los demás botones de la pantalla) */
  .cancelar,
  .confirmar {
    height: 46px;
    border: 0;
    font-size: .9rem;
    font-weight: 700;
  }

  .cancelar {
    background: transparent;
    padding: 0 16px;
    color: var(--ink);
  }

  .confirmar {
    border-radius: var(--radius-pill);
    padding: 0 22px;
    background: var(--brand);
    color: var(--on-dark);
  }
</style>
