---
// Tarjeta de evento tipo afiche (decisiones 2.34 y 2.35): la tarjeta pública de los eventos (Bienvenida, Agenda,
// noticias y "Planes parecidos"). La imagen ocupa toda la tarjeta y encima va solo lo esencial: fecha, título, día y
// ciudad, cuánta gente va y el precio. Toda la tarjeta lleva al evento (el enlace del título se estira sobre ella);
// "Guardar" queda encima como botón propio. El cargo por servicio y quién vende se ven en la página del evento,
// junto al botón de compra.
// Para otras variantes (la de la Agenda): `nivel` del título, `tituloId`, atributos extra del artículo (`datos`) y
// de "Guardar" (`guardar`), y los espacios "acciones" (botones junto a Guardar), "marca" (sobre el título) y
// "social" (reemplaza la línea "N van").
// Marcado común para los scripts: [data-tarjeta][data-id], .guardar y el enlace del título.
import Icono from '../ui/Icono.astro';
import FotoEvento from './FotoEvento.astro';
import { ciudadDe, esGratis, textoPrecio, type Evento } from '../../data/eventos';
import { cifra, fechaCorta, placaFecha, rutaEvento } from '../../lib/formato';

interface Props {
  evento: Evento;
  // Muestra la etiqueta "N parches abiertos" (fila "Para ir en parche")
  parches?: boolean;
  // Nivel del título: 4 dentro de las filas con h3; 3 en rejillas bajo un h2; 2 si cuelga del h1 de la página
  nivel?: 2 | 3 | 4;
  tituloId?: string;
  oculta?: boolean;
  datos?: Record<string, string | number | undefined>;
  guardar?: Record<string, string>;
  // Sin "Guardar" donde la página no lo maneja ("Planes parecidos" del evento)
  guardable?: boolean;
}

const { evento: e, parches = false, nivel = 4, tituloId, oculta = false, datos = {}, guardar = {}, guardable = true } = Astro.props;
const Titulo = `h${nivel}`;
const { dia, mes } = placaFecha(e.fecha);
const href = rutaEvento(e.ciudad, e.titulo);
// Pila decorativa de la gente que va: tres círculos de color, sin nombres ni iniciales (es pública)
const tonos = ['peach', 'pink', 'lilac', 'lime', 'aqua', 'yellow'];
const base = parseInt(e.id.replace(/\D/g, ''), 10) || 0;
const pila = [0, 1, 2].map((k) => `var(--${tonos[(base + k) % tonos.length]})`);
---

<article
  class="afiche"
  style={`--bg1: ${e.bg1}; --bg2: ${e.bg2}`}
  aria-labelledby={tituloId}
  hidden={oculta}
  data-tarjeta
  data-id={e.id}
  data-ciudad={e.ciudad}
  {...datos}
>
  <FotoEvento id={e.id} velo="abajo" />
  <span class="fecha"><b>{dia}</b><span>{mes}</span></span>
  <div class="botones">
    <slot name="acciones" />
    {
      guardable && (
        <button type="button" class="guardar" aria-pressed="false" aria-label={`Guardar ${e.titulo}`} {...guardar}>
          <Icono nombre="marcador" tamano={18} />
        </button>
      )
    }
  </div>

  <div class="cuerpo">
    {
      parches && e.parches > 0 && (
        <span class="parches">
          {e.parches} {e.parches === 1 ? 'parche abierto' : 'parches abiertos'}
        </span>
      )
    }
    <slot name="marca" />
    <Titulo class="titulo" id={tituloId}><a href={href}>{e.titulo}</a></Titulo>
    <p class="meta">{fechaCorta(e.fecha)} · {ciudadDe(e)}</p>
    <div class="pie">
      <slot name="social">
        {e.van > 0 && <span class="gente">
          <span class="pila" aria-hidden="true">{pila.map((c) => <i style={`background: ${c}`}></i>)}</span>
          {cifra(e.van)} van
        </span>}
      </slot>
      <span class:list={['precio', { gratis: esGratis(e) }]}>{textoPrecio(e)}</span>
    </div>
  </div>
</article>

<style>
  .afiche {
    position: relative;
    aspect-ratio: 4 / 5;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    border-radius: var(--radius-field);
    overflow: hidden;
    /* La foto de R2 (FotoEvento, capa de fondo) queda debajo del texto y encima de este degradado */
    isolation: isolate;
    /* Capa oscura abajo (para que el texto blanco tenga contraste sobre cualquier imagen) sobre la imagen */
    background:
      linear-gradient(180deg, rgba(20, 14, 16, 0) 35%, rgba(20, 14, 16, .6) 62%, rgba(20, 14, 16, .92) 100%),
      radial-gradient(circle at 70% 28%, var(--bg1) 0, transparent 58%),
      var(--bg2);
    color: var(--on-dark);
    transition: transform 150ms ease-out;
  }

  .afiche:active {
    transform: scale(.985);
  }

  /* El foco del enlace se marca en toda la tarjeta */
  .afiche:has(.titulo a:focus-visible) {
    outline: 3px solid var(--brand);
    outline-offset: 3px;
  }

  .fecha {
    position: absolute;
    top: 12px;
    left: 12px;
    z-index: 1;
    min-width: 46px;
    padding: 5px 9px 4px;
    border-radius: var(--radius-xs);
    background: var(--surface);
    color: var(--ink);
    text-align: center;
    line-height: 1;
  }

  .fecha b {
    display: block;
    font-family: var(--display);
    font-size: 1.25rem;
    font-weight: 900;
  }

  .fecha span {
    font-size: .66rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: .06em;
    color: var(--muted);
  }

  /* Botones arriba a la derecha, por encima del enlace estirado */
  .botones {
    position: absolute;
    top: 10px;
    right: 10px;
    z-index: 2;
    display: flex;
    gap: 8px;
  }

  .guardar {
    width: 44px;
    height: 44px;
    border: 0;
    border-radius: 50%;
    background: rgba(255, 255, 255, .94);
    display: grid;
    place-items: center;
    color: var(--ink);
  }

  .guardar[aria-pressed='true'] {
    color: var(--brand);
  }

  .guardar[aria-pressed='true'] :global(svg) {
    fill: currentColor;
  }

  .cuerpo {
    padding: 16px;
  }

  .parches {
    display: inline-block;
    margin-bottom: 8px;
    padding: 4px 10px;
    border-radius: var(--radius-pill);
    background: var(--yellow);
    color: var(--ink);
    font-size: .8rem;
    font-weight: 700;
  }

  .titulo {
    font-family: var(--display);
    font-size: 1.22rem;
    font-weight: 800;
    line-height: 1.12;
    letter-spacing: -0.01em;
    text-wrap: balance;
  }

  .titulo a,
  .titulo a:hover {
    color: var(--on-dark);
  }

  .titulo a:focus-visible {
    outline: none;
  }

  /* Toda la tarjeta es el enlace: se estira sobre .afiche, el primer ancestro posicionado */
  .titulo a::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
  }

  .meta {
    margin-top: 5px;
    font-size: .86rem;
    color: var(--on-dark-muted);
  }

  .pie {
    margin-top: 12px;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
  }

  .gente {
    display: flex;
    align-items: center;
    gap: 7px;
    font-size: .84rem;
    font-weight: 600;
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
  }

  .pila {
    display: flex;
  }

  .pila i {
    width: 22px;
    height: 22px;
    margin-left: -8px;
    border: 2px solid var(--hero);
    border-radius: 50%;
  }

  .pila i:first-child {
    margin-left: 0;
  }

  .precio {
    padding: 6px 11px;
    border-radius: var(--radius-pill);
    background: var(--surface);
    color: var(--ink);
    font-size: .84rem;
    font-weight: 700;
    white-space: nowrap;
  }

  .precio.gratis {
    background: var(--cat-gratis);
  }

  @media (max-width: 767px) {
    .cuerpo {
      padding: 14px;
    }

    .titulo {
      font-size: 1.08rem;
    }

    .gente {
      gap: 5px;
      font-size: .8rem;
    }

    .pila i {
      width: 18px;
      height: 18px;
      margin-left: -7px;
    }

    .precio {
      padding: 5px 9px;
      font-size: .76rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .afiche {
      transition: none;
    }

    .afiche:active {
      transform: none;
    }
  }
</style>
