---
// Hoja de opciones de un filtro (decisión 2.35, Agenda y Noticias): Modal en forma de hoja con un grupo de radios
// (OpcionFiltro) y el botón "Ver resultados" abajo, que cierra la hoja; la página cambia su texto ("Ver 6 planes").
// El filtro se aplica al elegir: la página escucha el "change" de los radios.
import Modal from '../ui/Modal.astro';

interface Props {
  id: string;
  titulo: string;
  // Leyenda del grupo para los lectores de pantalla: "Filtrar por ciudad"
  leyenda: string;
}

const { id, titulo, leyenda } = Astro.props;
---

<Modal id={id} titulo={titulo} forma="hoja" ancho={440}>
  <fieldset class="opciones">
    <legend class="solo-lectores">{leyenda}</legend>
    <slot />
  </fieldset>
  <button type="button" class="ver-resultados" data-cerrar-modal data-ver-resultados>Ver resultados</button>
</Modal>

<style>
  .opciones {
    border: 0;
    display: flex;
    flex-direction: column;
    gap: 4px;
    max-height: min(60vh, 520px);
    overflow-y: auto;
    margin-inline: -8px;
    padding: 4px 8px;
  }

  .ver-resultados {
    width: 100%;
    height: 52px;
    margin-top: 14px;
    border: 0;
    border-radius: var(--radius-pill);
    background: var(--brand);
    color: var(--on-dark);
    font-size: 1rem;
    font-weight: 700;
  }
</style>
