---
// N41 · Campo de formulario, variante "registro": rótulo arriba, campo crema de 50 px y error por campo (H23).
// El error se escribe desde el script de la página; mientras no hay error, el campo no lo referencia.
// También lo usa /crear-evento (decisión 2.26), con texto largo, hora, enlace y una ayuda bajo el rótulo.
import Icono from '../ui/Icono.astro';

interface Opcion {
  valor: string;
  texto: string;
}

interface Props {
  id: string;
  etiqueta: string;
  obligatorio?: boolean;
  tipo?: 'text' | 'date' | 'select' | 'time' | 'url' | 'textarea';
  placeholder?: string;
  autocomplete?: string;
  opciones?: Opcion[];
  // Primera opción vacía de la lista
  opcionVacia?: string;
  // Ayuda permanente bajo el rótulo (id `${id}-ayuda`, referenciada por aria-describedby)
  ayuda?: string;
  maximo?: number;
  inputmode?: 'numeric' | 'url' | 'text';
  filas?: number;
}

const {
  id,
  etiqueta,
  obligatorio = false,
  tipo = 'text',
  placeholder,
  autocomplete,
  opciones = [],
  opcionVacia,
  ayuda,
  maximo,
  inputmode,
  filas = 4,
} = Astro.props;
const describe = ayuda ? `${id}-ayuda` : undefined;
---

<div class="campo">
  <label for={id}>
    {etiqueta} <span class="marca">{obligatorio ? '(obligatorio)' : '(opcional)'}</span>
  </label>
  {ayuda && <p id={`${id}-ayuda`} class="ayuda">{ayuda}</p>}
  {
    tipo === 'select' ? (
      <select id={id} name={id} required={obligatorio} autocomplete={autocomplete} aria-describedby={describe} class="control">
        {opcionVacia && <option value="">{opcionVacia}</option>}
        {opciones.map((o) => <option value={o.valor}>{o.texto}</option>)}
      </select>
    ) : tipo === 'textarea' ? (
      <textarea
        id={id}
        name={id}
        required={obligatorio}
        placeholder={placeholder}
        maxlength={maximo}
        rows={filas}
        aria-describedby={describe}
        class="control area"
      />
    ) : (
      <input
        id={id}
        name={id}
        type={tipo}
        required={obligatorio}
        placeholder={placeholder}
        autocomplete={autocomplete}
        maxlength={maximo}
        inputmode={inputmode}
        aria-describedby={describe}
        class="control"
      />
    )
  }
  <slot />
  <p id={`${id}-error`} class="error" hidden>
    <Icono nombre="informacion" tamano={16} />
    <span data-texto-error></span>
  </p>
</div>

<style>
  .campo {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  label {
    font-weight: 700;
    font-size: .9rem;
  }

  .marca {
    font-weight: 400;
    color: var(--muted);
  }

  /* 50 px como en las capturas (48 + 2 de borde; detalle fino 1) */
  .control {
    width: 100%;
    height: 50px;
    border: 1px solid var(--line-input);
    border-radius: var(--radius-field);
    padding: 0 14px;
    font-size: 1rem;
    font-weight: 400;
    color: var(--ink);
    background: var(--bg);
  }

  .ayuda {
    margin-top: -2px;
    font-size: .84rem;
    color: var(--muted);
  }

  .area {
    height: auto;
    min-height: 110px;
    padding: 12px 14px;
    line-height: 1.45;
    resize: vertical;
  }

  select.control {
    padding: 0 10px;
    cursor: pointer;
  }

  .control::placeholder {
    color: var(--placeholder);
  }

  /* Foco visible (H51): borde de 2 px rojo, además del anillo global */
  .control:focus-visible {
    border-color: var(--brand);
    box-shadow: inset 0 0 0 1px var(--brand);
  }

  /* Error (sección 3, "Error de formulario"): borde de 2 px #C23A24, ícono y texto */
  .control[aria-invalid='true'] {
    border-color: var(--brand);
    box-shadow: inset 0 0 0 1px var(--brand);
  }

  .error {
    display: flex;
    align-items: flex-start;
    gap: 6px;
    font-size: .84rem;
    font-weight: 500;
    line-height: 1.35;
    color: var(--brand);
  }

  .error :global(svg) {
    flex-shrink: 0;
    margin-top: 1px;
  }

  .error[hidden] {
    display: none;
  }
</style>
