---
// N3 · Encabezado mínimo de registro: logo + "¿Ya tienes cuenta? Entrar". No es fijo.
// "Entrar" va a la pantalla de inicio de sesión (H12, H33), como en el encabezado de visitante.
import EnlaceSubrayado from '../ui/EnlaceSubrayado.astro';
import Logo from '../ui/Logo.astro';
---

<header class="encabezado">
  <Logo href="/" />
  <p class="ya">¿Ya tienes cuenta? <EnlaceSubrayado href="/entrar">Entrar</EnlaceSubrayado></p>
</header>

<style>
  .encabezado {
    box-sizing: content-box;
    max-width: var(--ancho-max);
    margin-inline: auto;
    padding: 14px var(--margen-lateral);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }


  .ya {
    font-size: .9rem;
    color: var(--muted);
  }
</style>
