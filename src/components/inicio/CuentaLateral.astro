---
// N7 · Barra lateral de perfil: tarjeta de cuenta, menú "Secciones" y "Tus parches".
// En celular y tableta va después del feed (H15); el orden lo pone la página.
import Icono, { type NombreIcono } from '../ui/Icono.astro';
import Avatar from '../ui/Avatar.astro';
import { usuaria } from '../../data/personas';
import { cifrasPerfil } from '../../data/perfil';
import { misParches } from '../../data/asistencia';
import { chatsSinLeer } from '../../data/mensajes';
import { estadoParche, fondoParche as fondo } from './resumen';
import { cifra } from '../../lib/formato';

interface Props {
  noLeidos?: number;
}

const { noLeidos = chatsSinLeer } = Astro.props;
// Las mismas cifras de Mi perfil, calculadas de los datos (PF6, decisión 2.29)
const contadores = cifrasPerfil(usuaria.id)!;

// soloComputador: en celular "Tus parches" va compacto arriba del feed (ResumenCelular, decisión 2.27)
const menu: { texto: string; href: string; icono: NombreIcono; actual?: boolean; conteo?: number; soloComputador?: boolean }[] = [
  { texto: 'Inicio', href: '/inicio', icono: 'inicio', actual: true },
  // Mismo ícono de calendario que el encabezado para la Agenda (detalle fino 28)
  { texto: 'Explorar agenda', href: '/agenda', icono: 'agenda' },
  { texto: 'Mapa de eventos', href: '/mapa', icono: 'mapa' },
  // Acceso al centro de noticias con sesión (decisión 2.25): aquí y no en el encabezado, que a 320 px ya no tiene espacio
  { texto: 'Noticias', href: '/noticias', icono: 'noticias' },
  // Un solo nombre para la lista de parches (H62)
  { texto: 'Tus parches', href: '#parches', icono: 'parches', soloComputador: true },
  {
    texto: 'Mensajes',
    href: '/mensajes',
    icono: 'mensajes',
    conteo: noLeidos,
  },
  { texto: 'Guardados', href: '/yo?pestana=guardados', icono: 'marcador' },
  { texto: 'Recuerdos', href: '/yo?pestana=recuerdos', icono: 'recuerdos' },
];

---

<aside class="cuenta" aria-label="Tu cuenta">
  <section class="tarjeta perfil" aria-label="Tu perfil">
    <a href="/yo" class="quien">
      <Avatar color={usuaria.color} tamano={48} iniciales={usuaria.iniciales} class="avatar-perfil" />
      <span class="nombres">
        <b>{usuaria.nombre}</b>
        <span>@{usuaria.id}</span>
      </span>
    </a>
    <dl class="cifras">
      <div><dt>Planes</dt><dd>{cifra(contadores.planes)}</dd></div>
      <div><dt>Seguidores</dt><dd>{cifra(contadores.seguidores)}</dd></div>
      <div><dt>Siguiendo</dt><dd>{cifra(contadores.siguiendo)}</dd></div>
    </dl>
  </section>

  <nav aria-label="Secciones" class="menu">
    {
      menu.map((m) => (
        <a
          href={m.href}
          aria-current={m.actual ? 'page' : undefined}
          class:list={{ actual: m.actual, 'solo-computador': m.soloComputador }}
        >
          <Icono nombre={m.icono} tamano={18} />
          {m.texto}
          {/* El nombre sale del texto visible: "Mensajes 3 sin leer" (H59) */}
          {m.conteo ? (
            <span class="conteo">
              {m.conteo}
              <span class="solo-lectores"> sin leer</span>
            </span>
          ) : null}
        </a>
      ))
    }
  </nav>

  <section id="parches" class="tarjeta parches" aria-labelledby="parches-titulo">
    <h2 id="parches-titulo">Tus parches</h2>
    {
      misParches.map((p) => (
        <a href={`/mensajes/${p.slug}`} class="parche">
          <span class="cuadro" style={`background: ${fondo[p.color]}`} aria-hidden="true">{p.iniciales}</span>
          <span class="texto">
            <b>{p.nombre}</b>
            <span data-estado-parche={p.id}>{estadoParche(p)}</span>
          </span>
        </a>
      ))
    }
  </section>
</aside>

<style>
  .cuenta {
    display: flex;
    flex-direction: column;
    gap: 16px;
    min-width: 0;
  }

  .tarjeta {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    padding: 18px;
    display: flex;
    flex-direction: column;
  }

  .perfil {
    gap: 14px;
  }

  .quien {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  /* El hover rojo solo en el texto; las iniciales quedan en tinta (detalle fino 8) */
  .quien :global(.avatar-perfil) {
    font-size: 15px;
    color: var(--ink);
  }

  .nombres {
    display: flex;
    flex-direction: column;
    line-height: 1.25;
    min-width: 0;
  }

  .nombres span {
    color: var(--muted);
    font-size: .85rem;
  }

  .cifras {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 6px;
    text-align: center;
  }

  .cifras div {
    display: flex;
    flex-direction: column-reverse;
  }

  dd {
    font-weight: 700;
    font-size: 1.05rem;
  }

  dt {
    font-size: .74rem;
    color: var(--muted);
  }

  .menu {
    display: flex;
    flex-direction: column;
    gap: 2px;
    font-weight: 500;
  }

  /* Borde transparente en todos para que el actual no sea 2 px más alto (detalle fino 5) */
  .menu a {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 10px 13px;
    border: 1px solid transparent;
    border-radius: 12px;
  }

  .menu :global(svg) {
    flex-shrink: 0;
  }

  .menu .actual {
    background: var(--surface);
    border-color: var(--line);
    font-weight: 700;
  }

  .conteo {
    margin-left: auto;
    min-width: 22px;
    height: 22px;
    border-radius: var(--radius-pill);
    background: var(--brand);
    color: var(--on-dark);
    padding: 0 7px;
    font-size: .72rem;
    font-weight: 700;
    line-height: 1;
    display: grid;
    place-items: center;
  }

  .parches {
    gap: 12px;
  }

  @media (max-width: 767px) {
    .parches,
    .menu .solo-computador {
      display: none;
    }
  }

  h2 {
    font-size: .78rem;
    font-weight: 700;
    letter-spacing: .12em;
    text-transform: uppercase;
    color: var(--brand);
  }

  .parche {
    display: flex;
    align-items: center;
    gap: 10px;
    min-height: 44px;
  }

  .cuadro {
    flex-shrink: 0;
    width: 36px;
    height: 36px;
    border-radius: var(--radius-xs);
    display: grid;
    place-items: center;
    font-family: var(--display);
    font-weight: 900;
    font-size: .8rem;
    color: var(--ink);
  }

  .texto {
    line-height: 1.25;
    min-width: 0;
  }

  .texto b {
    font-size: .9rem;
  }

  .texto span {
    display: block;
    font-size: .78rem;
    color: var(--muted);
  }
</style>
