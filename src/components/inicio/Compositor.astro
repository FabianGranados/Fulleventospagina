---
// N9 · Compositor "Publicar un plan". Formulario real (detalle fino global 5).
// "Armar parche" abre la ventana "Nuevo parche" de Mensajes (H38). "Etiquetar evento", "Reseña" y "Publicar"
// llevan al camino "Una publicación sobre un evento" de /crear-evento (decisión 2.26), con lo escrito en ?texto=.
// "Foto" sigue sin diseño (H38) y avisa "Próximamente".
// Por debajo de 768 px (decisión 2.27) es una sola fila: avatar, campo y un botón de enviar; las opciones aparecen
// al enfocar el campo (o cuando tiene texto). El botón se llama "Publicar lo que escribiste" para no confundirse
// con el "Publicar" (+) del encabezado, que lleva a elegir entre un evento nuevo o una publicación.
import Icono from '../ui/Icono.astro';
import Avatar from '../ui/Avatar.astro';
import { usuaria } from '../../data/personas';
import { rutaNuevoParche } from '../../data/mensajes';
import { rutaPublicar } from '../../lib/publicaciones';

const nombrePila = usuaria.nombre.split(' ')[0];
---

<form class="compositor" aria-label="Publicar un plan" action="/crear-evento" method="get" data-compositor>
  <input type="hidden" name="modo" value="publicacion" />
  <div class="arriba">
    <Avatar color={usuaria.color} tamano={42} iniciales={usuaria.iniciales} class="avatar-compositor" />
    <label class="campo">
      <span class="solo-lectores">Publica tu plan</span>
      <input
        id="compositor-campo"
        type="text"
        name="texto"
        autocomplete="off"
        placeholder={`¿Qué plan tienes, ${nombrePila}? Etiqueta un evento con @`}
      />
    </label>
    <button type="submit" class="enviar" aria-label="Publicar lo que escribiste">
      <Icono nombre="avion" tamano={18} grosor={2.2} />
    </button>
  </div>
  <div class="acciones">
    <a href={rutaPublicar()} class="secundario">
      <Icono nombre="agenda" tamano={16} />Etiquetar evento
    </a>
    <a href={rutaNuevoParche()} class="secundario">
      <Icono nombre="armarParche" tamano={16} />Armar parche
    </a>
    <button type="button" class="secundario" data-proximamente="subir fotos">
      <Icono nombre="foto" tamano={16} />Foto
    </button>
    <a href={`${rutaPublicar()}&tipo=resena`} class="secundario">
      <Icono nombre="estrella" tamano={16} />Reseña
    </a>
    <button type="submit" class="publicar">Publicar<span class="solo-lectores"> lo que escribiste</span></button>
  </div>
</form>

<script>
  document.querySelectorAll<HTMLFormElement>('[data-compositor]').forEach((form) => {
    form.classList.add('plegable');
    form.addEventListener('focusin', () => form.classList.add('abierto'));
  });
</script>

<style>
  .compositor {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    padding: 16px 18px;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .arriba {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .arriba :global(.avatar-compositor) {
    font-size: .8rem;
  }

  .campo {
    flex: 1;
    min-width: 0;
  }

  input {
    width: 100%;
    height: 44px;
    border: 1px solid var(--line);
    border-radius: var(--radius-pill);
    padding: 0 16px;
    background: var(--bg);
    font-size: .95rem;
    color: var(--ink);
    text-overflow: ellipsis;
  }

  input::placeholder {
    color: var(--placeholder);
  }

  .acciones {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    align-items: center;
  }

  .secundario {
    height: 36px;
    border: 1px solid var(--line);
    background: var(--surface);
    border-radius: var(--radius-pill);
    padding: 0 14px;
    font-size: .84rem;
    font-weight: 500;
    display: flex;
    align-items: center;
    gap: 6px;
    color: var(--ink);
  }

  .secundario :global(svg) {
    flex-shrink: 0;
  }

  .publicar {
    margin-left: auto;
    height: 36px;
    border: 0;
    background: var(--brand);
    color: var(--on-dark);
    border-radius: var(--radius-pill);
    padding: 0 18px;
    font-size: .86rem;
    font-weight: 700;
  }

  .enviar {
    display: none;
  }

  /* Objetivos táctiles de 44 px en celular (WCAG 2.5.8 y regla 4 del proyecto) */
  @media (max-width: 767px) {
    .compositor {
      padding: 12px;
      gap: 0;
    }

    .arriba {
      gap: 8px;
    }

    .enviar {
      flex-shrink: 0;
      width: 44px;
      height: 44px;
      border: 0;
      border-radius: 50%;
      background: var(--brand);
      color: var(--on-dark);
      display: grid;
      place-items: center;
    }

    .publicar {
      display: none;
    }

    /* Opciones en una fila con desplazamiento lateral. Con JavaScript aparecen al enfocar o tocar el campo y se
       quedan (si se ocultaran al perder el foco, en iOS el toque sobre una opción se perdería); sin JavaScript
       se ven siempre. */
    .acciones {
      flex-wrap: nowrap;
      overflow-x: auto;
      scrollbar-width: none;
      margin: 0 -12px -6px;
      padding: 12px 24px 6px 12px;
      /* Sin desvanecido (decisión 2.28): la fila llega al borde de la pantalla y lo que sigue se asoma */
      margin-right: calc(-1 * var(--margen-lateral));
      padding-right: var(--margen-lateral);
    }

    .plegable:not(.abierto):not(:focus-within) .acciones {
      display: none;
    }

    .secundario {
      flex-shrink: 0;
      height: 44px;
      white-space: nowrap;
    }
  }
</style>
