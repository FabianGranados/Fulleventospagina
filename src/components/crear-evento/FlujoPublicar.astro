---
// /crear-evento (decisión 2.26): "¿Qué quieres publicar?" y sus dos caminos.
//   A · Un evento nuevo: 4 pasos (lo básico, cuándo y dónde, boletas, foto y revisión) y "En revisión".
//   B · Una publicación sobre un evento que ya está: elegir evento, escribir, revisar y publicar.
// Cada paso es un <form> real que se oculta con `hidden` (lo escrito se conserva al ir y volver, H45).
// La lógica (pasos, validación, antiduplicados, fotos y guardado del demo) está en flujo.ts, evento-nuevo.ts y
// publicacion.ts. DEMOSTRACIÓN: el evento nuevo no se guarda en ningún servidor; la publicación se guarda solo en
// este navegador (lib/publicaciones.ts).
import Campo from '../registro/Campo.astro';
import Icono from '../ui/Icono.astro';
import ResumenErrores from './ResumenErrores.astro';
import ErrorCampo from './ErrorCampo.astro';
import { ciudades, nombreCiudad } from '../../data/ciudades';
import { eventos } from '../../data/eventos';
import { HOY_DEMO } from '../../data/demo';
import { estadoPlan } from '../../data/asistencia';
import { fechaCorta, normalizar, placaFecha } from '../../lib/formato';
import { lineaEvento, MAX_FOTOS, MAX_TEXTO, MAX_TITULO, TIPOS } from '../../lib/publicaciones';

const categorias = [...new Set(eventos.map((e) => e.categoria))];

// Camino B: primero los planes de la usuaria (va o está en un parche, asistencia.ts), luego el resto por fecha
const ordenados = [...eventos].sort((a, b) => a.fecha.localeCompare(b.fecha) || a.titulo.localeCompare(b.titulo, 'es'));
const estados = { parche: 'En parche', va: 'Vas', interesa: 'Te interesa' } as const;
const esPlan = (id: string) => ['parche', 'va'].includes(estadoPlan(id) ?? '');
const grupos = [
  { id: 'tus', titulo: 'Tus planes', lista: ordenados.filter((e) => esPlan(e.id)) },
  { id: 'otros', titulo: 'Más eventos en Fulleventos', lista: ordenados.filter((e) => !esPlan(e.id)) },
];
const busqueda = (e: (typeof eventos)[number]) =>
  normalizar([e.titulo, e.lugar, nombreCiudad(e.ciudad), e.categoria].join(' '));

const pasosA = ['Lo básico', 'Cuándo y dónde', 'Boletas', 'Foto y revisión'];
const pasosB = ['Elige el evento', 'Escribe', 'Revisa y publica'];
---

<div class="flujo" data-flujo data-pasos-a={JSON.stringify(pasosA)} data-pasos-b={JSON.stringify(pasosB)}>
  <p class="nota-demo">Demostración: lo que publiques aquí no se guarda en ningún servidor.</p>

  <section class="tarjeta" aria-label="Publicar en Fulleventos">
    {/* Progreso del camino elegido (oculto en la elección inicial y en los estados de éxito) */}
    <div class="progreso" data-progreso hidden>
      <p class="progreso-texto">
        <span data-progreso-camino></span> · <span data-progreso-texto></span>
      </p>
      <div
        class="riel"
        role="progressbar"
        aria-label="Progreso"
        aria-valuemin="1"
        aria-valuemax="4"
        aria-valuenow="1"
        data-riel
      >
        <span class="relleno" data-relleno></span>
      </div>
    </div>

    {/* ---------- Paso 0 · ¿Qué quieres publicar? ---------- */}
    <form class="paso" data-vista="inicio" novalidate aria-labelledby="inicio-titulo">
      <div>
        <h2 id="inicio-titulo" tabindex="-1">¿Qué quieres publicar?</h2>
        <p class="bajada">Elige una opción. Puedes cambiarla después.</p>
      </div>
      <ResumenErrores texto="Elige una opción para continuar." />
      <fieldset class="opciones-grandes" id="modo">
        <legend class="solo-lectores">¿Qué quieres publicar?</legend>
        <label class="opcion-grande">
          <input type="radio" name="modo" value="nuevo" />
          <span class="opcion-icono" aria-hidden="true"><Icono nombre="agenda" tamano={24} /></span>
          <span class="opcion-texto">
            <b>Un evento nuevo</b>
            <span>Organizas o conoces un plan que todavía no está en Fulleventos.</span>
          </span>
        </label>
        <label class="opcion-grande">
          <input type="radio" name="modo" value="publicacion" />
          <span class="opcion-icono" aria-hidden="true"><Icono nombre="foto" tamano={24} /></span>
          <span class="opcion-texto">
            <b>Una publicación sobre un evento</b>
            <span>Cuenta algo de un plan que ya está en Fulleventos: una reseña, una invitación, fotos, cómo llegar…</span>
          </span>
        </label>
      </fieldset>
      <ErrorCampo id="modo" />
      <div class="acciones">
        <span></span>
        <button type="submit" class="boton primario">Continuar</button>
      </div>
    </form>

    {/* ---------- Camino A · 1. Lo básico ---------- */}
    <form class="paso" data-vista="a1" novalidate aria-labelledby="a1-titulo" hidden>
      <div>
        <h2 id="a1-titulo" tabindex="-1">Lo básico</h2>
        <p class="bajada">Cuéntanos qué es el plan.</p>
      </div>
      <ResumenErrores />
      <Campo id="ev-nombre" etiqueta="Nombre del evento" obligatorio maximo={90} autocomplete="off" placeholder="Ej. Noche de boleros en La Candelaria">
        {/* Antiduplicados: coincidencias con eventos que ya están (evento-nuevo.ts) */}
        <div class="duplicados" data-duplicados hidden>
          <p class="duplicados-titulo"><Icono nombre="informacion" tamano={18} />¿Es alguno de estos? Ya están en Fulleventos</p>
          <ul class="duplicados-lista" data-lista-duplicados></ul>
          <p class="duplicados-nota">Si es otro plan, sigue llenando el formulario.</p>
        </div>
        <p class="solo-lectores" aria-live="polite" data-anuncio-duplicados></p>
      </Campo>
      <Campo
        id="ev-categoria"
        etiqueta="Categoría"
        obligatorio
        tipo="select"
        opcionVacia="Elige una categoría"
        opciones={categorias.map((c) => ({ valor: c, texto: c }))}
      />
      <Campo
        id="ev-descripcion"
        etiqueta="Descripción corta"
        obligatorio
        tipo="textarea"
        filas={3}
        maximo={280}
        ayuda="Una o dos frases: qué es el plan y para quién."
      >
        <p class="contador" data-contador="ev-descripcion" data-maximo="280">0 de 280 caracteres</p>
      </Campo>
      <div class="acciones">
        <button type="button" class="atras" data-ir="inicio">Atrás</button>
        <button type="submit" class="boton primario">Continuar</button>
      </div>
    </form>

    {/* ---------- Camino A · 2. Cuándo y dónde ---------- */}
    <form class="paso" data-vista="a2" novalidate aria-labelledby="a2-titulo" hidden>
      <div>
        <h2 id="a2-titulo" tabindex="-1">Cuándo y dónde</h2>
        <p class="bajada">Así la gente lo encuentra en la agenda y en el mapa.</p>
      </div>
      <ResumenErrores />
      <div class="dos-columnas">
        <Campo id="ev-fecha" etiqueta="Fecha" obligatorio tipo="date" />
        <Campo id="ev-hora" etiqueta="Hora de inicio" obligatorio tipo="time">
          <p class="ayuda-viva" data-hora-colombiana aria-live="polite"></p>
        </Campo>
      </div>
      <Campo
        id="ev-ciudad"
        etiqueta="Ciudad"
        obligatorio
        tipo="select"
        opcionVacia="Elige la ciudad"
        opciones={ciudades.map((c) => ({ valor: c.id, texto: c.nombre }))}
      />
      <Campo id="ev-lugar" etiqueta="Lugar" obligatorio maximo={80} placeholder="Ej. Teatro Libre" />
      <Campo
        id="ev-direccion"
        etiqueta="Dirección o barrio"
        obligatorio
        maximo={120}
        placeholder="Ej. Calle 62 # 10-25, Chapinero"
        autocomplete="street-address"
      />
      <div class="acciones">
        <button type="button" class="atras" data-ir="a1">Atrás</button>
        <button type="submit" class="boton primario" data-continuar>Continuar</button>
      </div>
    </form>

    {/* ---------- Camino A · 3. Boletas ---------- */}
    <form class="paso" data-vista="a3" novalidate aria-labelledby="a3-titulo" hidden>
      <div>
        <h2 id="a3-titulo" tabindex="-1">Boletas</h2>
        <p class="bajada">¿Hay que pagar para entrar?</p>
      </div>
      <ResumenErrores />
      <fieldset class="opciones-medianas" id="ev-entrada">
        <legend>¿Cómo es la entrada? <span class="marca">(obligatorio)</span></legend>
        <label class="opcion-mediana">
          <input type="radio" name="ev-entrada" value="gratis" />
          <span class="opcion-texto"><b>Gratis</b><span>Entrada libre, sin boleta.</span></span>
        </label>
        <label class="opcion-mediana">
          <input type="radio" name="ev-entrada" value="boleta" />
          <span class="opcion-texto"><b>Con boleta</b><span>Se compra en una boletera o en el sitio del organizador.</span></span>
        </label>
      </fieldset>
      <ErrorCampo id="ev-entrada" />

      <div class="con-boleta" data-con-boleta hidden>
        <Campo
          id="ev-precio"
          etiqueta="Precio desde"
          obligatorio
          inputmode="numeric"
          maximo={12}
          autocomplete="off"
          placeholder="Ej. 45000"
          ayuda="En pesos colombianos: el precio de la boleta más barata."
        >
          <p class="ayuda-viva" data-precio-visto aria-live="polite"></p>
        </Campo>
        <Campo id="ev-vende" etiqueta="Quién vende las boletas" obligatorio maximo={60} placeholder="Ej. el organizador o la boletera" />
        <Campo
          id="ev-url"
          etiqueta="Enlace oficial de venta"
          obligatorio
          tipo="url"
          inputmode="url"
          autocomplete="url"
          placeholder="https://"
          ayuda="La página donde se compran las boletas de este evento."
        />
        <p class="nota-venta">
          <Icono nombre="boleta" tamano={18} />
          <span>Fulleventos no vende boletas: el botón de compra llevará a este enlace.</span>
        </p>
      </div>

      <Campo
        id="ev-edad"
        etiqueta="Edad mínima"
        tipo="select"
        opcionVacia="Sin edad mínima"
        opciones={[14, 16, 18].map((n) => ({ valor: String(n), texto: `Mayores de ${n} años` }))}
      />
      <div class="acciones">
        <button type="button" class="atras" data-ir="a2">Atrás</button>
        <button type="submit" class="boton primario" data-continuar>Continuar</button>
      </div>
    </form>

    {/* ---------- Camino A · 4. Foto y revisión ---------- */}
    <form class="paso" data-vista="a4" novalidate aria-labelledby="a4-titulo" hidden>
      <div>
        <h2 id="a4-titulo" tabindex="-1">Foto y revisión</h2>
        <p class="bajada">Revisa cómo se verá antes de enviarlo.</p>
      </div>
      <ResumenErrores />

      <div class="campo-archivo">
        <label for="ev-foto" class="rotulo">Foto del evento <span class="marca">(opcional)</span></label>
        <p id="ev-foto-ayuda" class="ayuda">JPG, PNG o WebP de hasta 10 MB. Solo se ve en tu navegador: no se sube a ningún servidor.</p>
        <input id="ev-foto" name="ev-foto" type="file" accept="image/jpeg,image/png,image/webp" aria-describedby="ev-foto-ayuda" class="archivo" />
        <ErrorCampo id="ev-foto" />
        <div class="foto-elegida" data-foto-elegida hidden>
          <img alt="Vista previa de la foto elegida" data-foto-previa />
          <button type="button" class="quitar" data-quitar-foto>Quitar foto</button>
        </div>
      </div>

      <fieldset class="opciones-medianas" id="ev-organizador">
        <legend>¿Eres el organizador? <span class="marca">(obligatorio)</span></legend>
        <label class="opcion-mediana">
          <input type="radio" name="ev-organizador" value="si" />
          <span class="opcion-texto"><b>Sí, yo lo organizo</b></span>
        </label>
        <label class="opcion-mediana">
          <input type="radio" name="ev-organizador" value="no" />
          <span class="opcion-texto"><b>No, solo lo estoy compartiendo</b></span>
        </label>
      </fieldset>
      <ErrorCampo id="ev-organizador" />

      <div class="revision">
        <div class="vista-previa">
          <h3 class="subtitulo">Así se verá en la agenda</h3>
          {/* Imita la tarjeta pública (TarjetaEvento, N15) sin enlaces: es solo una vista previa */}
          <div class="tarjeta-evento" data-previa-evento>
            <div class="te-imagen" data-te-imagen>
              <img alt="" data-te-foto hidden />
              <span class="te-fecha" data-te-placa hidden><b data-te-dia></b><span data-te-mes></span></span>
            </div>
            <div class="te-cuerpo">
              <span class="te-categoria" data-te-categoria></span>
              <p class="te-titulo" data-te-titulo></p>
              <span class="te-lugar"><span data-te-lugar></span> · <b data-te-ciudad></b></span>
              <div class="te-compra">
                <span class="te-precio">
                  <span data-te-precio></span>
                  <small data-te-cargo>+ cargo por servicio</small>
                  <small data-te-vende></small>
                </span>
                <span class="te-cta" aria-hidden="true" data-te-cta></span>
              </div>
            </div>
          </div>
        </div>

        <div class="resumen-datos">
          <h3 class="subtitulo">Revisa los datos</h3>
          <div class="grupo-datos">
            <div class="grupo-cabeza">
              <h4>Lo básico</h4>
              <button type="button" class="editar" data-editar="a1">Editar<span class="solo-lectores"> lo básico</span></button>
            </div>
            <dl>
              <dt>Nombre</dt><dd data-dato="ev-nombre"></dd>
              <dt>Categoría</dt><dd data-dato="ev-categoria"></dd>
              <dt>Descripción</dt><dd data-dato="ev-descripcion"></dd>
            </dl>
          </div>
          <div class="grupo-datos">
            <div class="grupo-cabeza">
              <h4>Cuándo y dónde</h4>
              <button type="button" class="editar" data-editar="a2">Editar<span class="solo-lectores"> cuándo y dónde</span></button>
            </div>
            <dl>
              <dt>Fecha y hora</dt><dd data-dato="cuando"></dd>
              <dt>Lugar</dt><dd data-dato="donde"></dd>
            </dl>
          </div>
          <div class="grupo-datos">
            <div class="grupo-cabeza">
              <h4>Boletas</h4>
              <button type="button" class="editar" data-editar="a3">Editar<span class="solo-lectores"> las boletas</span></button>
            </div>
            <dl>
              <dt>Entrada</dt><dd data-dato="entrada"></dd>
              <dt data-dato-con-boleta>Enlace de venta</dt><dd data-dato="ev-url" data-dato-con-boleta></dd>
              <dt>Edad mínima</dt><dd data-dato="ev-edad"></dd>
            </dl>
          </div>
        </div>
      </div>

      <p class="nota-revision">
        <Icono nombre="escudo" tamano={18} />
        <span>Antes de publicarlo, el equipo de Fulleventos revisa cada evento nuevo.</span>
      </p>
      <div class="acciones">
        <button type="button" class="atras" data-ir="a3">Atrás</button>
        <button type="submit" class="boton primario">Enviar a revisión</button>
      </div>
    </form>

    {/* ---------- Camino A · En revisión ---------- */}
    <div class="paso exito" data-vista="a-listo" hidden>
      <span class="exito-icono" aria-hidden="true"><Icono nombre="palomita" tamano={26} grosor={2.6} /></span>
      <h2 id="a-listo-titulo" tabindex="-1">Tu evento quedó en revisión.</h2>
      <p class="bajada">Te avisamos cuando esté publicado.</p>
      <p class="nota-demo">Demostración: el evento no se guardó en ningún servidor.</p>
      <div class="botones-exito">
        <a href="/inicio" class="boton primario">Ir a mi inicio</a>
        <button type="button" class="boton contorno" data-reiniciar>Publicar otra cosa</button>
      </div>
    </div>

    {/* ---------- Camino B · 1. Elige el evento ---------- */}
    <form class="paso" data-vista="b1" novalidate aria-labelledby="b1-titulo" hidden>
      <div>
        <h2 id="b1-titulo" tabindex="-1">¿Sobre qué evento?</h2>
        <p class="bajada">Busca el plan en Fulleventos.</p>
      </div>
      <ResumenErrores />
      <div class="buscador">
        <label for="buscar-evento" class="rotulo">Busca por nombre, ciudad o lugar</label>
        <div class="buscador-caja">
          <Icono nombre="lupa" tamano={18} />
          <input id="buscar-evento" type="search" autocomplete="off" placeholder="Ej. salsa, Medellín o El Campín" data-buscar-evento />
        </div>
        <p class="solo-lectores" aria-live="polite" data-anuncio-busqueda></p>
      </div>

      <fieldset class="lista-eventos" id="pub-evento">
        <legend class="solo-lectores">Elige el evento</legend>
        {
          grupos.map((g) => (
            <div class="grupo-eventos" data-grupo-eventos>
              <h3 class="subtitulo">{g.titulo}</h3>
              <ul>
                {g.lista.map((e) => {
                  const { dia, mes } = placaFecha(e.fecha);
                  const estado = estadoPlan(e.id);
                  return (
                    <li data-item-evento data-busqueda={busqueda(e)}>
                      <label class="opcion-evento">
                        <input type="radio" name="pub-evento" value={e.id} />
                        <span class="mini" style={`--bg1: ${e.bg1}; --bg2: ${e.bg2}`} aria-hidden="true">
                          <b>{dia}</b>
                          <span>{mes}</span>
                        </span>
                        <span class="mini-info">
                          <b>{e.titulo}</b>
                          <span>{lineaEvento(e)}</span>
                          {estado && estado !== 'interesa' && <span class="estado">{estados[estado]}</span>}
                        </span>
                      </label>
                    </li>
                  );
                })}
              </ul>
            </div>
          ))
        }
      </fieldset>
      <ErrorCampo id="pub-evento" />
      <div class="sin-resultados" data-sin-resultados hidden>
        <p>No encontramos eventos con «<span data-termino></span>».</p>
        <p>¿Es un plan que todavía no está en Fulleventos?</p>
        <button type="button" class="boton contorno" data-a-evento-nuevo>Publicar un evento nuevo</button>
      </div>
      <div class="acciones">
        <button type="button" class="atras" data-ir="inicio">Atrás</button>
        <button type="submit" class="boton primario">Continuar</button>
      </div>
    </form>

    {/* ---------- Camino B · 2. Escribe ---------- */}
    <form class="paso" data-vista="b2" novalidate aria-labelledby="b2-titulo" hidden>
      <div>
        <h2 id="b2-titulo" tabindex="-1">Escribe tu publicación</h2>
        <p class="bajada">Se verá en la página del evento y en el inicio de tu gente.</p>
      </div>
      <ResumenErrores />
      <div class="evento-elegido">
        <p><span class="rotulo-chico">Evento</span> <b data-elegido-titulo></b> <span data-elegido-linea></span></p>
        <button type="button" class="editar" data-ir="b1">Cambiar<span class="solo-lectores"> el evento</span></button>
      </div>

      <fieldset class="chips" id="pub-tipo">
        <legend>Tipo de publicación <span class="marca">(obligatorio)</span></legend>
        {
          Object.entries(TIPOS).map(([valor, texto]) => (
            <label class="chip">
              <input type="radio" name="pub-tipo" value={valor} />
              <span>{texto}</span>
            </label>
          ))
        }
      </fieldset>
      <ErrorCampo id="pub-tipo" />

      <Campo id="pub-titulo" etiqueta="Título" obligatorio maximo={MAX_TITULO} autocomplete="off" placeholder="Ej. ¿Quién se apunta el viernes?" />
      <Campo id="pub-texto" etiqueta="Texto" obligatorio tipo="textarea" filas={6} maximo={MAX_TEXTO}>
        <p class="contador" data-contador="pub-texto" data-maximo={MAX_TEXTO}>0 de {MAX_TEXTO.toLocaleString('es-CO')} caracteres</p>
      </Campo>

      <div class="campo-archivo">
        <label for="pub-fotos" class="rotulo">Fotos <span class="marca">(opcional)</span></label>
        <p id="pub-fotos-ayuda" class="ayuda">Hasta {MAX_FOTOS}, de hasta 10 MB cada una. En esta demostración se guardan solo en tu navegador.</p>
        <input
          id="pub-fotos"
          name="pub-fotos"
          type="file"
          accept="image/jpeg,image/png,image/webp"
          multiple
          aria-describedby="pub-fotos-ayuda"
          class="archivo"
        />
        <ErrorCampo id="pub-fotos" />
        <ul class="fotos-elegidas" data-fotos-elegidas hidden></ul>
      </div>

      <fieldset class="opciones-medianas" id="pub-audiencia">
        <legend>¿Quién la ve? <span class="marca">(obligatorio)</span></legend>
        <label class="opcion-mediana">
          <input type="radio" name="pub-audiencia" value="publica" checked />
          <span class="opcion-texto"><b>Pública</b><span>Cualquiera que entre al evento.</span></span>
        </label>
        <label class="opcion-mediana">
          <input type="radio" name="pub-audiencia" value="amigos" />
          <span class="opcion-texto"><b>Solo mis amigos</b><span>La gente que te sigue y sigues.</span></span>
        </label>
        <label class="opcion-mediana" data-opcion-parche hidden>
          <input type="radio" name="pub-audiencia" value="parche" />
          <span class="opcion-texto"><b>Mi parche</b><span data-nombre-parche></span></span>
        </label>
      </fieldset>
      <ErrorCampo id="pub-audiencia" />

      <div class="acciones">
        <button type="button" class="atras" data-ir="b1">Atrás</button>
        <button type="submit" class="boton primario">Ver vista previa</button>
      </div>
    </form>

    {/* ---------- Camino B · 3. Revisa y publica ---------- */}
    <form class="paso" data-vista="b3" novalidate aria-labelledby="b3-titulo" hidden>
      <div>
        <h2 id="b3-titulo" tabindex="-1">Así se verá tu publicación</h2>
        <p class="bajada">Revísala antes de publicarla.</p>
      </div>
      <div class="previa-publicacion" data-previa-publicacion></div>
      <p class="error" role="alert" data-error-guardar hidden>
        <Icono nombre="informacion" tamano={16} />
        <span>Tu navegador no deja guardar la publicación (por ejemplo, en una ventana privada). Prueba en una ventana normal.</span>
      </p>
      <div class="acciones">
