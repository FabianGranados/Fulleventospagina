---
interface Linea {
  texto: string;
  sangria?: string;
  maxAncho?: string;
}

interface Props {
  lineas: Linea[];
  nivel?: 1 | 2;
  tamano?: string;
  class?: string;
}

const {
  lineas,
  nivel = 1,
  tamano = 'clamp(2.3rem, 5.8vw, 4.9rem)',
  class: clase,
} = Astro.props;

const Etiqueta = `h${nivel}`;
---

<Etiqueta class:list={['titular', clase]} style={`--tamano-titular: ${tamano}`}>
  {
    lineas.map((linea, i) => (
      <>
        <span
          class:list={['linea', { invertida: i % 2 === 1 }]}
          style={`--sangria: ${linea.sangria ?? '0'}; --max-ancho: ${linea.maxAncho ?? 'none'}`}
        >
          {linea.texto}
        </span>
        {' '}
      </>
    ))
  }
</Etiqueta>

<style>
  .titular {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    font-family: var(--display);
    font-weight: 900;
    font-size: var(--tamano-titular);
    line-height: .98;
    letter-spacing: -0.035em;
    text-transform: uppercase;
    color: var(--ink);
  }

  .linea {
    background: var(--degradado-titular);
    padding: .1em .22em .06em;
    margin-left: var(--sangria);
    max-width: var(--max-ancho);
  }

  .invertida {
    background: var(--degradado-titular-inv);
  }
</style>
