---
// N68 · Ventana modal canónica con <dialog> y showModal(): foco dentro, fondo inerte y Escape (H7).
// Se abre con cualquier botón que tenga data-abrir-modal="<id>"; al cerrar, el foco vuelve a ese botón.
// Cierra con la X, con Escape, con clic afuera o con cualquier elemento con data-cerrar-modal dentro.
import Icono from './Icono.astro';

interface Props {
  id: string;
  titulo: string;
  ancho?: number;
  // "lateral": panel arriba a la derecha (checkout de Evento); "hoja": por debajo de 520 px se pega abajo, a todo
  // el ancho y con alto automático (decisión 2.27), y en pantallas grandes es "centrada"; "centrada": el resto
  forma?: 'centrada' | 'lateral' | 'hoja';
}

const { id, titulo, ancho = 520, forma = 'centrada' } = Astro.props;
---

<dialog id={id} class:list={['modal', forma]} aria-labelledby={`${id}-titulo`} style={`--ancho-modal: ${ancho}px`} data-modal>
  <div class="caja">
    <div class="cabeza">
      <h2 id={`${id}-titulo`} class="titulo">{titulo}</h2>
      <button type="button" class="cerrar" aria-label="Cerrar" data-cerrar-modal>
        <Icono nombre="cerrar" tamano={16} grosor={2.4} />
      </button>
    </div>
    <slot />
  </div>
</dialog>

<script>
  const origen = new WeakMap<HTMLDialogElement, HTMLElement>();

  document.addEventListener('click', (ev) => {
    const objetivo = ev.target as HTMLElement;
    const abrir = objetivo.closest<HTMLElement>('[data-abrir-modal]');
    if (abrir) {
      const dialogo = document.getElementById(abrir.dataset.abrirModal!) as HTMLDialogElement | null;
      if (dialogo && !dialogo.open) {
        origen.set(dialogo, abrir);
        dialogo.showModal();
        dialogo.dispatchEvent(new CustomEvent('modal:abierta', { detail: { origen: abrir } }));
      }
      return;
    }
    const dialogo = objetivo.closest<HTMLDialogElement>('dialog[data-modal]');
    // Clic en el fondo: el objetivo es el propio <dialog>, no su contenido
    if (objetivo.matches('dialog[data-modal]') || (dialogo && objetivo.closest('[data-cerrar-modal]'))) {
      (dialogo ?? (objetivo as HTMLDialogElement)).close();
    }
  });

  document.querySelectorAll<HTMLDialogElement>('dialog[data-modal]').forEach((dialogo) => {
    dialogo.addEventListener('close', () => origen.get(dialogo)?.focus());
  });
</script>

<style>
  .modal {
    padding: 0;
    border: 0;
    background: transparent;
    max-width: calc(100% - 32px);
    width: var(--ancho-modal);
    max-height: calc(100% - 32px);
    margin: auto;
    color: var(--ink);
    overflow: visible;
  }

  .modal::backdrop {
    background: rgba(23, 18, 15, .55);
  }

  .lateral {
    margin: 12px 12px auto auto;
    max-height: calc(100% - 24px);
    max-width: calc(100% - 24px);
  }

  .caja {
    background: var(--surface);
    border-radius: var(--radius-xl);
    padding: 22px;
    box-shadow: 0 24px 60px rgba(23, 18, 15, .3);
    max-height: calc(100dvh - 32px);
    overflow-y: auto;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .lateral .caja {
    background: var(--bg);
    box-shadow: 0 24px 60px rgba(23, 18, 15, .35);
  }

  .cabeza {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }

  .titulo {
    font-size: 1.15rem;
    font-weight: 700;
  }

  /* 44 × 44 en todas las formas (objetivo táctil, decisión 2.27) */
  .cerrar {
    flex-shrink: 0;
    width: 44px;
    height: 44px;
    border: 0;
    border-radius: 50%;
    background: var(--bg);
    color: var(--ink);
    display: grid;
    place-items: center;
  }

  .lateral .cerrar {
    background: var(--surface);
  }

  /* En celular, pantalla completa (N68); la hoja, abajo y del alto de su contenido */
  @media (max-width: 519px) {
    .modal:not(.hoja),
    .lateral {
      width: 100%;
      max-width: 100%;
      height: 100%;
      max-height: 100%;
      margin: 0;
    }

    .modal:not(.hoja) .caja {
      min-height: 100%;
      max-height: 100dvh;
      border-radius: 0;
    }

    .hoja {
      width: 100%;
      max-width: 100%;
      max-height: 90vh;
      max-height: 90dvh;
      margin: auto 0 0;
    }

    .hoja .caja {
      max-height: 90vh;
      max-height: 90dvh;
      border-radius: var(--radius-lg) var(--radius-lg) 0 0;
      padding-bottom: calc(22px + env(safe-area-inset-bottom, 0px));
      box-shadow: 0 -12px 40px rgba(23, 18, 15, .25);
    }

    /* Sube desde abajo; sin movimiento con prefers-reduced-motion (regla global de base.css) */
    .hoja[open] .caja {
      animation: subir-hoja .22s ease-out;
    }
  }

  @keyframes subir-hoja {
    from {
      transform: translateY(40px);
      opacity: 0;
    }
  }
</style>
