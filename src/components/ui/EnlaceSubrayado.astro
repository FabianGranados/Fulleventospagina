---
interface Props {
  href: string;
  sobreOscuro?: boolean;
  class?: string;
}

const { href, sobreOscuro = false, class: clase } = Astro.props;
---

<a href={href} class:list={['subrayado', { 'sobre-oscuro': sobreOscuro }, clase]}><slot /></a>

<style>
  .subrayado {
    font-weight: 700;
    border-bottom: 2px solid var(--ink);
    padding-bottom: 1px;
  }

  /* Sobre fondo oscuro el color es fijo, también al pasar el mouse */
  .sobre-oscuro,
  .sobre-oscuro:hover {
    color: var(--on-dark);
    border-bottom-color: var(--on-dark);
  }
</style>
