---
import Icono from '../ui/Icono.astro';
import EnlaceSubrayado from '../ui/EnlaceSubrayado.astro';
import EncabezadoSeccion from '../ui/EncabezadoSeccion.astro';
import FilaEventos from '../eventos/FilaEventos.astro';
import { ciudades } from '../../data/ciudades';
import { eventos, conteoCiudad, type Evento } from '../../data/eventos';

// Una fila deslizable por categoría (decisión 2.30, pedido del cliente). Los id son las `etiquetas` de los eventos
// y los que acepta `?categoria=` de /agenda. Un evento puede estar en dos filas (un concierto gratis).
const categorias = [
  { id: 'rumba', texto: 'Rumba' },
  { id: 'conciertos', texto: 'Conciertos' },
  { id: 'gratis', texto: 'Gratis este finde' },
  { id: 'deporte', texto: 'Deporte' },
  { id: 'teatro', texto: 'Arte y teatro' },
  { id: 'comida', texto: 'Comida' },
];

// Orden intercalado por ciudad dentro de cada fila: el 1.º de cada ciudad, luego el 2.º… (4.3, 6.5)
const intercalar = (lista: Evento[]) => {
  const grupos = ciudades.map((c) => lista.filter((e) => e.ciudad === c.id));
  const salida: Evento[] = [];
  for (let i = 0; grupos.some((g) => g[i]); i++) for (const g of grupos) if (g[i]) salida.push(g[i]);
  return salida;
};

const filas = categorias
  .map((c) => ({ ...c, eventos: intercalar(eventos.filter((e) => e.etiquetas.includes(c.id))) }))
  .filter((c) => c.eventos.length > 0);
---

<section id="agenda" class="agenda" aria-labelledby="agenda-titulo" data-agenda>
  <EncabezadoSeccion antetitulo="Agenda" titulo="Este finde en Colombia" id="agenda-titulo" enfocable margenInferior={20}>
    <div class="enlaces" slot="aside">
      <span class="ejemplo">Contenido de ejemplo</span>
      <a href="/mapa" class="ver-mapa" data-ver-mapa><Icono nombre="mapa" tamano={16} />Ver en el mapa</a>
      <EnlaceSubrayado href="/agenda" class="ver-todo">Ver toda la agenda</EnlaceSubrayado>
    </div>
  </EncabezadoSeccion>

  <div class="chips" role="group" aria-label="Filtrar por ciudad">
    <button type="button" class="chip" data-ciudad="all" aria-pressed="true">
      <Icono nombre="pin" tamano={16} />Toda Colombia{' '}<span class="conteo">{eventos.length}<span class="solo-lectores">{eventos.length === 1 ? ' plan' : ' planes'}</span></span>
    </button>
    {
      ciudades.map((c) => (
        <button type="button" class="chip" data-ciudad={c.id} aria-pressed="false">
          {c.nombre}{' '}<span class="conteo">{conteoCiudad(c.id)}<span class="solo-lectores">{conteoCiudad(c.id) === 1 ? ' plan' : ' planes'}</span></span>
        </button>
      ))
    }
  </div>

  <p class="solo-lectores" role="status" data-anuncio></p>

  <div class="vacio" data-vacio hidden>
    <p data-vacio-mensaje></p>
    <button type="button" class="boton-contorno" data-limpiar>Ver todos los planes del país</button>
  </div>

  <div class="filas" data-filas>
    {
      filas.map((c) => (
        <div class="fila" data-categoria-fila={c.id}>
          <FilaEventos id={`finde-${c.id}`} titulo={c.texto} eventos={c.eventos} href={`/agenda?categoria=${c.id}`} />
        </div>
      ))
    }
  </div>
</section>

<script>
  import { ciudades } from '../../data/ciudades';
  import { planes } from '../../lib/formato';

  const nombres = Object.fromEntries(ciudades.map((c) => [c.id, c.nombre]));
  const raiz = document.querySelector<HTMLElement>('[data-agenda]');

  if (raiz) {
    const filas = [...raiz.querySelectorAll<HTMLElement>('[data-categoria-fila]')];
    const contenedorFilas = raiz.querySelector<HTMLElement>('[data-filas]')!;
    const chipsCiudad = [...raiz.querySelectorAll<HTMLButtonElement>('.chips [data-ciudad]')];
    // Selector de ciudad de los dos encabezados (visitante y con sesión, decisión 2.24); solo uno está visible
    const selectores = [...document.querySelectorAll<HTMLSelectElement>('select[data-selector-ciudad]')];
    const vacio = raiz.querySelector<HTMLElement>('[data-vacio]')!;
    const mensajeVacio = raiz.querySelector<HTMLElement>('[data-vacio-mensaje]')!;
    const anuncio = raiz.querySelector<HTMLElement>('[data-anuncio]')!;
    const verMapa = raiz.querySelector<HTMLAnchorElement>('[data-ver-mapa]')!;
    const titulo = raiz.querySelector<HTMLElement>('#agenda-titulo')!;

    const estado = { ciudad: 'all' };

    const pintar = (anunciar = true) => {
      const ids = new Set<string>();
      let categorias = 0;

      filas.forEach((fila) => {
        let cuantos = 0;
        fila.querySelectorAll<HTMLElement>('li[data-ciudad]').forEach((li) => {
          const entra = estado.ciudad === 'all' || li.dataset.ciudad === estado.ciudad;
          li.hidden = !entra;
          if (!entra) return;
          cuantos++;
          ids.add(li.querySelector<HTMLElement>('[data-tarjeta]')!.dataset.id!);
        });
        fila.hidden = cuantos === 0;
        if (cuantos) categorias++;
        fila.querySelector('[data-fila-cantidad]')!.textContent = planes(cuantos);
        const p = new URLSearchParams({ categoria: fila.dataset.categoriaFila! });
        if (estado.ciudad !== 'all') p.set('ciudad', estado.ciudad);
        fila.querySelector<HTMLAnchorElement>('a.ver-todos')!.href = `/agenda?${p}`;
        // Cada fila vuelve al inicio y recalcula sus flechas (FilaEventos)
        fila.querySelector('[data-fila-eventos]')!.dispatchEvent(new Event('fila-eventos:reiniciar'));
      });

      const nombre = estado.ciudad === 'all' ? 'Toda Colombia' : nombres[estado.ciudad];
      const hay = ids.size > 0;
      contenedorFilas.hidden = !hay;
      vacio.hidden = hay;
      mensajeVacio.textContent = `No hay planes en ${nombre} este finde.`;

      chipsCiudad.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.ciudad === estado.ciudad)));
      selectores.forEach((s) => (s.value = estado.ciudad));
      verMapa.href = estado.ciudad === 'all' ? '/mapa' : `/mapa?ciudad=${estado.ciudad}`;

      if (anunciar) {
        anuncio.textContent = hay
          ? `${nombre}: ${planes(ids.size)} en ${categorias} ${categorias === 1 ? 'categoría' : 'categorías'}.`
          : mensajeVacio.textContent;
      }
    };

    chipsCiudad.forEach((b) =>
      b.addEventListener('click', () => {
        estado.ciudad = b.dataset.ciudad!;
        pintar();
      }),
    );
    selectores.forEach((selector) =>
      selector.addEventListener('change', () => {
        estado.ciudad = selector.value || 'all';
        pintar();
      }),
    );
    raiz.querySelector('[data-limpiar]')!.addEventListener('click', () => {
      estado.ciudad = 'all';
      pintar();
      titulo.focus();
    });

    // Guardar (demo): un evento puede estar en dos filas, así que se marcan todas sus copias
    raiz.addEventListener('click', (ev) => {
      const guardar = (ev.target as HTMLElement).closest<HTMLButtonElement>('.guardar');
      if (!guardar) return;
      const id = guardar.closest<HTMLElement>('[data-tarjeta]')!.dataset.id;
      const valor = String(guardar.getAttribute('aria-pressed') !== 'true');
      raiz
        .querySelectorAll<HTMLElement>(`[data-tarjeta][data-id="${id}"] .guardar`)
        .forEach((b) => b.setAttribute('aria-pressed', valor));
    });

    pintar(false);
  }
</script>

<style>
  .agenda {
    padding-top: 72px;
  }

  .enlaces {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px 20px;
  }

  .ejemplo {
    font-size: .78rem;
    color: var(--muted);
  }

  .ver-mapa {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    height: 42px;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-pill);
    padding: 0 16px;
    font-size: .9rem;
    font-weight: 700;
  }

  .enlaces :global(.ver-todo) {
    font-size: .9rem;
  }

  /* position: relative contiene el texto oculto de los contadores (8.1 #4) */
  /* El relleno superior deja ver completo el anillo de foco dentro de la fila con scroll;
     el margen negativo lo compensa para conservar el espaciado del prototipo */
  .chips {
    position: relative;
    display: flex;
    gap: 8px;
    overflow-x: auto;
    padding-block: 6px;
    margin-top: -6px;
    margin-bottom: 22px;
    scroll-padding-inline: 8px 40px;
  }

  .chip {
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    height: 42px;
    border-radius: var(--radius-pill);
    padding: 0 16px;
    font-size: .9rem;
    font-weight: 500;
    white-space: nowrap;
    border: 1px solid var(--line);
    background: var(--surface);
    color: var(--ink);
  }

  .chip:has(.conteo) {
    padding: 0 7px 0 15px;
  }

  .chip[aria-pressed='true'] {
    background: var(--ink);
    border-color: var(--ink);
    color: var(--on-dark);
  }

  .conteo {
    min-width: 28px;
    height: 28px;
    padding: 0 8px;
    border-radius: var(--radius-pill);
    display: inline-grid;
    place-items: center;
    font-size: .78rem;
    font-weight: 700;
    background: var(--surface-sunken);
    color: var(--ink);
  }

  .chip[aria-pressed='true'] .conteo {
    background: var(--yellow);
  }

  /* Pista de que hay más chips (H61): en tableta y escritorio pasan a dos líneas;
     en celular se desplazan de lado con un desplazamiento hasta el borde de la pantalla */
  @media (min-width: 768px) {
    .chips {
      flex-wrap: wrap;
      overflow: visible;
    }
  }

  @media (max-width: 767px) {
    .chips {
      /* Sin desvanecido (decisión 2.28): la fila llega al borde de la pantalla y lo que sigue se asoma */
      margin-right: calc(-1 * var(--margen-lateral));
      padding-right: var(--margen-lateral);
      padding-right: 24px;
    }

    /* Objetivo táctil de 44 px en celular (decisión 2.27) */
    .chip {
      height: 44px;
    }
  }

  .vacio {
    text-align: center;
    padding: 40px 16px;
    background: var(--surface);
    border: 1px dashed var(--line);
    border-radius: var(--radius-card);
  }

  .vacio p {
    margin: 0 0 14px;
    color: var(--muted);
  }

  .boton-contorno {
    height: 44px;
    border-radius: var(--radius-pill);
    border: 1px solid var(--line-strong);
    background: var(--surface);
    color: var(--ink);
    padding: 0 20px;
    font-size: .9rem;
    font-weight: 700;
  }

  /* Una fila por categoría (decisión 2.30); las vacías se ocultan y no dejan hueco */
  .filas {
    display: flex;
    flex-direction: column;
    gap: 40px;
  }

  @media (max-width: 767px) {
    .filas {
      gap: 32px;
    }
  }
</style>
