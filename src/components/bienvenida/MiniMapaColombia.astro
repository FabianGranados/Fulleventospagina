---
import { ciudades } from '../../data/ciudades';
import { eventos, conteoCiudad as conteo } from '../../data/eventos';
import { planes, ciudadesTexto } from '../../lib/formato';
import { departamentos, nivelPlanes, planesPorDepartamento } from '../../data/departamentos';

const activas = ciudades.filter((c) => conteo(c.id) > 0).length;
// Orden de norte a sur (top ascendente), como en el prototipo
const pines = [...ciudades].sort((a, b) => a.top - b.top);
// Mapa de tierra y mar (decisión 2.36): departamentos reales según los planes del finde
const porDepartamento = planesPorDepartamento(Object.fromEntries(ciudades.map((c) => [c.id, conteo(c.id)])));
---

<div class="mini">
  <!-- Un solo enlace para todo el mini-mapa (H60, decisión 2.14) -->
  <a href="/mapa" class="lienzo">
    <span class="solo-lectores">
      {`Ver el mapa de eventos: ${planes(eventos.length)} este finde en ${ciudadesTexto(activas)}`}
    </span>
    <svg viewBox="0 0 130 175" aria-hidden="true" focusable="false">
      {
        departamentos.map((d) => (
          <path class="dpto" d={d.d} data-nivel={nivelPlanes(porDepartamento[d.cod] ?? 0)} />
        ))
      }
    </svg>
    {
      pines.map((c) => (
        <span
          class="pin"
          style={`left: ${c.left}%; top: ${c.top}%`}
          title={`${c.nombre}: ${planes(conteo(c.id))} este finde`}
          aria-hidden="true"
        >
          {conteo(c.id)}
          <span class:list={['rotulo', c.rotulo]} style={`margin-top: ${c.dy}px`}>
            {c.nombre}
          </span>
        </span>
      ))
    }
  </a>
  <p class="leyenda"><span class="punto"></span>Planes este finde por ciudad; en verde, los departamentos con planes</p>
</div>

<style>
  .mini {
    flex: 1 1 280px;
    max-width: 400px;
    margin: 0 auto;
  }

  .lienzo {
    position: relative;
    display: block;
    width: 100%;
    aspect-ratio: 130 / 175;
    container-type: inline-size;
    border-radius: var(--radius-md);
  }

  svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    filter: drop-shadow(0 10px 18px rgba(23, 18, 15, .18));
  }

  .dpto {
    fill: var(--mapa-sin-planes);
    stroke: var(--mapa-borde);
    stroke-width: .4;
    stroke-linejoin: round;
  }

  .dpto[data-nivel='1'] { fill: var(--mapa-planes-1); }
  .dpto[data-nivel='2'] { fill: var(--mapa-planes-2); }
  .dpto[data-nivel='3'] { fill: var(--mapa-planes-3); }

  .pin {
    position: absolute;
    transform: translate(-50%, -50%);
    width: clamp(20px, 6.5cqw, 26px);
    height: clamp(20px, 6.5cqw, 26px);
    border-radius: 50%;
    border: 2px solid var(--hero);
    background: var(--yellow);
    color: var(--ink);
    display: grid;
    place-items: center;
    font-family: var(--display);
    font-weight: 900;
    font-size: clamp(.64rem, 2.9cqw, .78rem);
    line-height: 1;
    box-shadow: 0 0 0 4px rgba(246, 220, 106, .2);
  }

  .rotulo {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    white-space: nowrap;
    font-family: var(--ui);
    font-weight: 700;
    font-size: clamp(.62rem, 2.8cqw, .74rem);
    padding: 1px 6px;
    border-radius: var(--radius-pill);
    background: rgba(20, 14, 16, .9);
    color: var(--on-dark);
  }

  .derecha {
    left: calc(100% + 6px);
  }

  .izquierda {
    right: calc(100% + 6px);
  }

  .leyenda {
    margin: 14px 0 0;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    font-size: .8rem;
    color: var(--ink);
  }

  .punto {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: var(--yellow);
  }
</style>
