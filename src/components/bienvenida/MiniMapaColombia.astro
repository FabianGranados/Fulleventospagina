---
import { ciudades } from '../../data/ciudades';
import { eventos, conteoCiudad as conteo } from '../../data/eventos';
import { planes, ciudadesTexto } from '../../lib/formato';

const activas = ciudades.filter((c) => conteo(c.id) > 0).length;
// Orden de norte a sur (top ascendente), como en el prototipo
const pines = [...ciudades].sort((a, b) => a.top - b.top);
const contorno =
  'M21.4 43.2 L26.5 46.0 L27.5 49.5 L27.2 45.5 L30.7 41.5 L38.2 36.0 L39.2 34.5 L38.5 30.0 L39.5 26.0 L42.5 22.0 L46.5 20.0 L51.0 19.0 L52.9 17.6 L58.0 17.0 L65.9 14.6 L70.0 12.0 L73.3 8.0 L78.3 5.4 L81.0 8.0 L81.7 11.5 L75.5 14.5 L72.5 19.0 L66.5 25.5 L64.5 33.0 L61.5 39.0 L67.5 43.5 L71.0 47.0 L70.3 51.0 L73.0 56.0 L83.0 59.5 L94.0 59.2 L101.0 60.5 L120.2 68.0 L117.0 78.0 L116.5 86.0 L119.0 91.3 L123.0 102.0 L124.0 111.0 L126.3 118.3 L116.0 119.0 L113.0 113.0 L101.0 112.0 L96.0 117.5 L94.5 123.5 L94.5 131.0 L99.0 137.5 L100.5 144.0 L97.0 152.0 L95.5 163.0 L95.6 172.2 L91.0 168.0 L92.0 158.0 L84.0 154.0 L75.0 153.0 L66.0 154.5 L60.0 151.0 L53.0 142.0 L47.2 132.0 L41.0 129.0 L32.0 127.0 L26.0 126.0 L18.5 121.5 L14.0 118.0 L6.5 115.5 L7.0 112.0 L9.0 108.0 L16.0 104.3 L20.0 98.0 L23.0 91.2 L21.0 85.0 L20.5 75.0 L20.5 68.0 L17.0 60.0 L17.5 55.0 L20.5 50.5 L22.0 47.0 Z';
---

<div class="mini">
  <!-- Un solo enlace para todo el mini-mapa (H60, decisión 2.14) -->
  <a href="/mapa" class="lienzo">
    <span class="solo-lectores">
      {`Ver el mapa de eventos: ${planes(eventos.length)} este finde en ${ciudadesTexto(activas)}`}
    </span>
    <svg viewBox="0 0 130 175" aria-hidden="true" focusable="false">
      <path
        d="M0 43.75H130M0 87.5H130M0 131.25H130M32.5 0V175M65 0V175M97.5 0V175"
        fill="none"
        stroke="#FFFFFF"
        stroke-opacity=".07"
        stroke-width=".4"
        stroke-dasharray="1 2"
      />
      <path d={contorno} fill="#2B2124" stroke="#F3B27E" stroke-opacity=".6" stroke-width=".6" stroke-linejoin="round" />
    </svg>
    {
      pines.map((c) => (
        <span
          class="pin"
          style={`left: ${c.left}%; top: ${c.top}%`}
          title={`${c.nombre}: ${planes(conteo(c.id))} este finde`}
          aria-hidden="true"
        >
          {conteo(c.id)}
          <span class:list={['rotulo', c.rotulo]} style={`margin-top: ${c.dy}px`}>
            {c.nombre}
          </span>
        </span>
      ))
    }
  </a>
  <p class="leyenda"><span class="punto"></span>Número de planes este finde por ciudad</p>
</div>

<style>
  .mini {
    flex: 1 1 280px;
    max-width: 400px;
    margin: 0 auto;
  }

  .lienzo {
    position: relative;
    display: block;
    width: 100%;
    aspect-ratio: 130 / 175;
    container-type: inline-size;
    border-radius: var(--radius-md);
  }

  svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .pin {
    position: absolute;
    transform: translate(-50%, -50%);
    width: clamp(20px, 6.5cqw, 26px);
    height: clamp(20px, 6.5cqw, 26px);
    border-radius: 50%;
    border: 2px solid var(--hero);
    background: var(--yellow);
    color: var(--ink);
    display: grid;
    place-items: center;
    font-family: var(--display);
    font-weight: 900;
    font-size: clamp(.64rem, 2.9cqw, .78rem);
    line-height: 1;
    box-shadow: 0 0 0 4px rgba(246, 220, 106, .2);
  }

  .rotulo {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    white-space: nowrap;
    font-family: var(--ui);
    font-weight: 700;
    font-size: clamp(.62rem, 2.8cqw, .74rem);
    color: var(--on-dark);
    text-shadow: 0 0 3px var(--hero), 0 0 6px var(--hero);
  }

  .derecha {
    left: calc(100% + 6px);
  }

  .izquierda {
    right: calc(100% + 6px);
  }

  .leyenda {
    margin: 14px 0 0;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    font-size: .8rem;
    color: var(--on-dark-muted);
  }

  .punto {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: var(--yellow);
  }
</style>
