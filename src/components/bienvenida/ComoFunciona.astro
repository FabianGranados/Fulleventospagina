---
import EncabezadoSeccion from '../ui/EncabezadoSeccion.astro';
import { VENTA_PROPIA } from '../../config';

const pasos = [
  {
    n: '1',
    color: 'var(--yellow)',
    titulo: 'Descubre',
    texto:
      'Rumba, conciertos, fútbol, teatro y planes gratis de todo el país, en un solo lugar. Búscalos por ciudad o explóralos en el mapa.',
  },
  {
    n: '2',
    color: 'var(--pink)',
    titulo: 'Mira quién va',
    texto: 'Sigue a tus amigos y ve a qué eventos van, qué guardan y qué recomiendan.',
  },
  {
    n: '3',
    color: 'var(--lilac)',
    titulo: 'Arma parche',
    // H1: se quitó el absoluto "sin salir de Fulleventos" (depende del modo de compra, P1).
    // Sin venta propia (decisión 2.22) las boletas se compran en la boletera.
    texto: VENTA_PROPIA
      ? 'Crea un grupo para ir juntos o únete a uno abierto, y compra tus boletas.'
      : 'Crea un grupo para ir juntos o únete a uno abierto, y mira dónde comprar las boletas.',
  },
];
---

<section id="como-funciona" class="como" aria-labelledby="como-titulo">
  <EncabezadoSeccion antetitulo="Cómo funciona" titulo="Planes mejores, con tu gente" id="como-titulo" margenInferior={28} />
  <div class="pasos">
    {
      pasos.map((p) => (
        <div class="paso">
          <span class="numero" style={`background: ${p.color}`}>{p.n}</span>
          <h3>{p.titulo}</h3>
          <p>{p.texto}</p>
        </div>
      ))
    }
  </div>
</section>

<style>
  .como {
    padding-top: 72px;
  }

  /* Pasa directo de 1 a 3 columnas, sin la fila suelta de 2 + 1 (H61) */
  .pasos {
    display: grid;
    grid-template-columns: 1fr;
    gap: 20px;
  }

  @media (min-width: 720px) {
    .pasos {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .paso {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    padding: 24px;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .numero {
    width: 48px;
    height: 48px;
    border-radius: var(--radius-sm);
    display: grid;
    place-items: center;
    font-family: var(--display);
    font-weight: 900;
    font-size: 1.3rem;
  }

  h3 {
    font-size: 1.15rem;
    font-weight: 700;
  }

  .paso p {
    color: var(--muted);
  }
</style>
