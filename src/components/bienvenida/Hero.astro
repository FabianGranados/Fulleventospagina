---
import Etiqueta from '../ui/Etiqueta.astro';
import Titular from '../ui/Titular.astro';
import Boton from '../ui/Boton.astro';
import EnlaceSubrayado from '../ui/EnlaceSubrayado.astro';
import Icono from '../ui/Icono.astro';
import PruebaSocial from './PruebaSocial.astro';
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { eventos } from '../../data/eventos';
import { nombreCiudad } from '../../data/ciudades';
import { pesos, placaFecha, rutaEvento, horaSinCorte } from '../../lib/formato';

interface Props {
  // Se muestra solo con datos reales (decisión 2.13); sin datos no se pinta.
  pruebaSocial?: { personas: number; ciudades: number };
}

const { pruebaSocial } = Astro.props;

// Foto del héroe (P10, decisión 2.18): basta con dejar el archivo en src/assets/hero/ con el nombre
// "foto" (.jpg, .jpeg, .png o .webp). Sin archivo se usa el fondo con manchas de luz (decisión 2.13).
const archivos = import.meta.glob<{ default: ImageMetadata }>('../../assets/hero/foto.{jpg,jpeg,png,webp}', {
  eager: true,
});
const foto = Object.values(archivos)[0]?.default;

// Plan destacado de la tarjeta flotante en computador (decisión 2.19). En producción lo elige el equipo
// editorial desde el backend; en el demo es el evento principal (e1).
const destacado = eventos.find((e) => e.id === 'e1')!;
const { dia, mes } = placaFecha(destacado.fecha);
const diaSemana = new Date(`${destacado.fecha}T12:00:00-05:00`)
  .toLocaleDateString('es-CO', { weekday: 'short', timeZone: 'America/Bogota' })
  .replace('.', '');
const cuando = `${diaSemana[0].toUpperCase()}${diaSemana.slice(1)} ${dia} ${mes}` + (destacado.hora ? ` · ${horaSinCorte(destacado.hora)}` : '');
---

<section aria-label="Bienvenida" class:list={['hero', 'superficie-oscura', { 'con-foto': foto }]}>
  {
    foto && (
      <Picture
        src={foto}
        alt=""
        formats={['avif', 'webp']}
        widths={[480, 800, 1280, 1920]}
        sizes="(max-width: 1288px) 100vw, 1240px"
        loading="eager"
        fetchpriority="high"
        class="foto"
        pictureAttributes={{ class: 'marco-foto' }}
      />
    )
  }

  <div class="texto">
    <!-- Celular: titular de bloques con degradado (decisión 2.13). Computador: titular minimalista
         (decisión 2.19). Solo uno se muestra a la vez, así que solo hay un h1 en el árbol accesible. -->
    <Etiqueta tamano="lg" class="etiqueta-hero">Arma tu parche</Etiqueta>
    <Titular
      class="titular-celular"
      lineas={[
        { texto: 'De la rumba' },
        { texto: 'del viernes', sangria: 'clamp(0em, 2vw, 1.15em)' },
        { texto: 'al concierto del sábado', sangria: 'clamp(0em, 1vw, .4em)', maxAncho: '13ch' },
      ]}
    />
    <h1 class="titular-escritorio">
      <span>De la rumba del viernes</span>{' '}
      <span>al concierto del sábado</span>
    </h1>
    <p class="bajada">
      Descubre planes en Bogotá, Medellín, Cali, Barranquilla y todo el país, mira quién de tus amigos
      va y arma parche para no llegar solo.
    </p>
    <div class="acciones">
      <Boton href="/registro" class="boton-hero">
        Crear mi cuenta gratis
        <Icono nombre="flecha" tamano={18} class="flecha" />
      </Boton>
      <EnlaceSubrayado href="#agenda" sobreOscuro>Ver la agenda sin registrarme</EnlaceSubrayado>
    </div>
    {pruebaSocial && <PruebaSocial {...pruebaSocial} />}
  </div>

  <a class="destacado" href={rutaEvento(destacado.ciudad, destacado.titulo)}>
    <span class="destacado-imagen" style={`--bg1: ${destacado.bg1}; --bg2: ${destacado.bg2}`}></span>
    <span class="destacado-antetitulo">Destacado este finde</span>
    <span class="destacado-titulo">{destacado.titulo}</span>
    <span class="destacado-dato">{destacado.lugar.split(' · ')[0]} · {nombreCiudad(destacado.ciudad)}</span>
    <span class="destacado-dato destacado-cuando">{cuando}</span>
    <span class="destacado-precio">
      {destacado.precio ? `Desde ${pesos(destacado.precio)}` : 'Gratis'}
      {destacado.precio > 0 && <small>+ cargo por servicio</small>}
    </span>
  </a>
</section>

<style>
  .hero {
    position: relative;
    display: flex;
    align-items: center;
    gap: 40px;
    min-height: 520px;
    padding: 56px clamp(22px, 5vw, 64px) 52px;
    border-radius: var(--radius-2xl);
    overflow: hidden;
    background: var(--fondo-heroe);
    color: var(--on-dark);
  }

  .texto {
    display: flex;
    flex-direction: column;
    justify-content: center;
    flex: 1;
    min-width: 0;
  }

  /* La foto va de fondo y la capa oscura asegura el contraste del texto blanco (detalle fino 18):
     casi opaca a la izquierda, donde va el texto, y más clara a la derecha, donde se ve la foto */
  .hero :global(.marco-foto) {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .hero :global(.foto) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 70% 40%;
  }

  .con-foto::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
    background: linear-gradient(
      90deg,
      rgba(20, 14, 16, .94) 0%,
      rgba(20, 14, 16, .86) 38%,
      rgba(20, 14, 16, .45) 72%,
      rgba(20, 14, 16, .25) 100%
    );
  }

  .texto,
  .destacado {
    position: relative;
    z-index: 2;
  }

  .hero :global(.etiqueta-hero) {
    align-self: flex-start;
    margin-left: clamp(0px, 3vw, 44px);
  }

  .titular-escritorio,
  .destacado {
    display: none;
  }

  .bajada {
    margin-top: 26px;
    max-width: 48ch;
    font-size: 1.1rem;
    color: rgba(255, 255, 255, .9);
  }

  .acciones {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 16px 22px;
    margin-top: 26px;
  }

  .acciones :global(.boton-hero) {
    display: inline-flex;
    align-items: center;
    gap: 10px;
  }

  /* La flecha es del diseño minimalista de computador (decisión 2.19) */
  .acciones :global(.flecha) {
    display: none;
  }

  /* Computador: héroe minimalista (decisión 2.19), titular limpio sin mayúsculas ni bloques de color */
  @media (min-width: 821px) {
    .hero {
      min-height: 560px;
      align-items: stretch;
    }

    .hero :global(.etiqueta-hero),
    .hero :global(.titular-celular) {
      display: none;
    }

    .titular-escritorio {
      display: block;
      max-width: 15ch;
      font-family: var(--ui);
      font-size: clamp(2.6rem, 4.4vw, 3.9rem);
      font-weight: 700;
      line-height: 1.04;
      letter-spacing: -0.035em;
      text-wrap: balance;
    }

    .bajada {
      margin-top: 20px;
      max-width: 42ch;
      font-size: 1.08rem;
    }

    .acciones {
      margin-top: 30px;
    }

    .acciones :global(.boton-hero) {
      padding: 14px 22px 14px 26px;
    }

    .acciones :global(.flecha) {
      display: block;
      transition: transform .2s ease-out;
    }

    .acciones :global(.boton-hero:hover .flecha) {
      transform: translateX(3px);
    }
  }

  /* Tarjeta flotante del plan destacado: solo cuando hay espacio al lado del texto */
  @media (min-width: 1024px) {
    .destacado,
    .destacado:hover {
      display: flex;
      flex-direction: column;
      align-self: flex-end;
      flex: 0 0 272px;
      padding: 12px 12px 16px;
      border-radius: var(--radius-lg);
      background: var(--surface);
      color: var(--ink);
      box-shadow: 0 18px 40px rgba(0, 0, 0, .28);
    }

    .destacado-imagen {
      aspect-ratio: 16 / 10;
      margin-bottom: 12px;
      border-radius: 12px;
      background: radial-gradient(circle at 70% 30%, var(--bg1) 0, transparent 60%), var(--bg2);
    }

    .destacado-antetitulo {
      padding-inline: 4px;
      font-size: .7rem;
      font-weight: 700;
      letter-spacing: .1em;
      text-transform: uppercase;
      color: var(--brand);
    }

    .destacado-titulo {
      margin-top: 4px;
      padding-inline: 4px;
      font-size: 1.02rem;
      font-weight: 700;
      line-height: 1.25;
    }

    .destacado:hover .destacado-titulo {
      color: var(--brand);
    }

    .destacado-dato {
      margin-top: 4px;
      padding-inline: 4px;
      font-size: .82rem;
      color: var(--muted);
    }

    .destacado-cuando {
      margin-top: 0;
    }

    .destacado-precio {
      margin-top: 10px;
      padding-inline: 4px;
      font-size: 1rem;
      font-weight: 700;
    }

    .destacado-precio small {
      display: block;
      font-size: .72rem;
      font-weight: 400;
      color: var(--muted);
    }
  }

  /* Ajuste de celular del código base (decisión 2.13) */
  @media (max-width: 820px) {
    .hero {
      min-height: 0;
      border-radius: 22px;
    }

    /* En celular el texto ocupa todo el ancho: la capa se oscurece parejo */
    .con-foto::before {
      background: linear-gradient(180deg, rgba(20, 14, 16, .78) 0%, rgba(20, 14, 16, .9) 100%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .acciones :global(.flecha) {
      transition: none;
    }
  }
</style>
