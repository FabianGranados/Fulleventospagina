---
// Franja "Mira a qué va tu gente" (decisión 2.34): va en "Este finde", después de la primera fila, para que la
// invitación llegue cuando la persona ya vio planes. Sin sesión invita a crear la cuenta; con sesión lleva al
// inicio. Los avatares son decorativos y solo llevan iniciales: no se nombra a nadie en la página pública.
import { personas } from '../../data/personas';

const avatares = personas.slice(1, 5);
---

<div class="franja">
  <span class="pila" aria-hidden="true">
    {avatares.map((p) => <span class:list={['avatar', p.color]}>{p.iniciales}</span>)}
  </span>
  <div class="textos solo-visitante">
    <h3>Mira a qué va tu gente y armen parche para ir juntos</h3>
    <p>Sigue a tus amigos y entérate de sus planes del finde.</p>
  </div>
  <a href="/registro" class="boton solo-visitante">Crear mi cuenta gratis</a>
  {/* Con sesión no se invita a crear la cuenta que ya se tiene (decisión 2.27) */}
  <div class="textos solo-sesion">
    <h3>Mira a qué va tu gente este finde</h3>
    <p>Los planes y parches de tus amigos están en tu inicio.</p>
  </div>
  <a href="/inicio" class="boton solo-sesion">Ir a mi inicio</a>
</div>

<style>
  .franja {
    display: flex;
    align-items: center;
    gap: 18px;
    padding: 18px 22px;
    border: 1px solid var(--line);
    border-radius: var(--radius-field);
    background: var(--surface);
  }

  .pila {
    flex-shrink: 0;
    display: flex;
  }

  .avatar {
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    margin-left: -9px;
    border: 2px solid var(--surface);
    border-radius: 50%;
    font-size: .72rem;
    font-weight: 700;
    color: var(--ink);
  }

  .avatar:first-child {
    margin-left: 0;
  }

  .c1 { background: var(--peach); }
  .c2 { background: var(--lilac); }
  .c3 { background: var(--pink); }
  .c4 { background: var(--lime); }
  .c5 { background: var(--yellow); }
  .c6 { background: var(--aqua); }

  .textos {
    flex: 1;
    min-width: 0;
  }

  h3 {
    font-family: var(--display);
    font-size: 1.1rem;
    font-weight: 800;
    line-height: 1.2;
    text-wrap: balance;
  }

  p {
    margin-top: 2px;
    font-size: .9rem;
    color: var(--muted);
  }

  .boton,
  .boton:hover {
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 48px;
    padding: 0 22px;
    border-radius: var(--radius-pill);
    background: var(--brand);
    color: var(--on-dark);
    font-weight: 700;
    white-space: nowrap;
  }

  .boton:hover {
    background: color-mix(in srgb, var(--brand) 86%, black);
  }

  @media (max-width: 767px) {
    .franja {
      flex-wrap: wrap;
      gap: 12px;
      padding: 20px 16px 16px;
    }

    .textos {
      flex-basis: 100%;
    }

    .boton {
      flex: 1;
    }
  }
</style>
