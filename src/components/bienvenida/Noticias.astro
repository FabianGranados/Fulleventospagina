---
import { destacada, lista } from '../../data/noticias';
---

<section id="noticias" class="noticias" aria-labelledby="noticias-titulo">
  <div class="cabecera">
    <div>
      <p class="antetitulo">Lo que se mueve</p>
      <h2 id="noticias-titulo">Noticias de la escena</h2>
    </div>
    <span class="ejemplo">Contenido de ejemplo</span>
  </div>

  <!-- Sin enlaces hasta que exista la página de noticia (H36, decisión 2.14) -->
  <div class="cuerpo">
    <article class="destacada">
      <div class="imagen" aria-hidden="true"></div>
      <div class="texto">
        <p class="kicker">{destacada.antetitulo}</p>
        <h3 class="titulo-destacada">{destacada.titulo}</h3>
        <p class="bajada">{destacada.bajada}</p>
        <p class="meta">{destacada.tiempo}</p>
      </div>
    </article>
    <div class="lista">
      {
        lista.map((n) => (
          <article class="item">
            <p class="kicker">{n.antetitulo}</p>
            <h3 class="titulo-item">{n.titulo}</h3>
            <p class="tiempo">{n.tiempo}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .noticias {
    padding-top: 72px;
  }

  .cabecera {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 16px;
    margin-bottom: 24px;
  }

  .antetitulo {
    margin: 0 0 6px;
    font-size: .74rem;
    font-weight: 700;
    letter-spacing: .12em;
    text-transform: uppercase;
    color: var(--brand);
  }

  h2 {
    font-family: var(--display);
    font-weight: 900;
    font-size: clamp(1.7rem, 3.2vw, 2.4rem);
    letter-spacing: -0.03em;
    line-height: 1.05;
  }

  .ejemplo {
    font-size: .78rem;
    color: var(--muted);
  }

  .cuerpo {
    display: flex;
    flex-wrap: wrap;
    gap: 24px;
  }

  .destacada {
    flex: 1.25 1 320px;
    min-width: 0;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    overflow: hidden;
  }

  .imagen {
    aspect-ratio: 16 / 9;
    background:
      radial-gradient(circle at 30% 35%, rgba(246, 220, 106, .85) 0, transparent 30%),
      radial-gradient(circle at 75% 65%, rgba(217, 69, 47, .8) 0, transparent 40%),
      var(--photo-dark);
  }

  .texto {
    padding: 18px 20px 20px;
  }

  .kicker {
    font-size: .7rem;
    font-weight: 700;
    letter-spacing: .1em;
    text-transform: uppercase;
    color: var(--brand);
  }

  .titulo-destacada {
    margin: 4px 0 8px;
    font-family: var(--display);
    font-weight: 800;
    font-size: 1.35rem;
    letter-spacing: -0.02em;
    line-height: 1.12;
  }

  .bajada {
    color: var(--muted);
    font-size: .93rem;
  }

  .meta {
    margin-top: 10px;
    font-size: .8rem;
    color: var(--muted);
  }

  .lista {
    flex: 1 1 280px;
    min-width: 0;
    display: flex;
    flex-direction: column;
  }

  .item {
    padding: 16px 0;
    border-bottom: 1px solid var(--line);
  }

  .item:first-child {
    padding-top: 0;
  }

  .item:last-child {
    border-bottom: 0;
  }

  .titulo-item {
    margin-top: 2px;
    font-size: 1.02rem;
    font-weight: 700;
    line-height: 1.3;
  }

  .tiempo {
    margin-top: 6px;
    font-size: .8rem;
    color: var(--muted);
  }
</style>
