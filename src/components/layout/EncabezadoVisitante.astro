---
import Icono from '../ui/Icono.astro';
import Logo from '../ui/Logo.astro';
import { ciudades } from '../../data/ciudades';
import { conVolver } from '../../lib/sesion';

// N2 · Encabezado de visitante. En la Bienvenida sus enlaces van a las secciones de la página; en las páginas
// públicas con sesión opcional (Evento, Agenda, Mapa y Noticias, decisiones 2.24 y 2.25) va junto al EncabezadoApp: cada uno con
// su clase (solo-visitante / solo-sesion) y solo uno visible.
interface Props {
  class?: string;
}

const { class: clase } = Astro.props;
const ruta = Astro.url.pathname.replace(/\/$/, '') || '/';
const enBienvenida = ruta === '/';
// "Entrar" y "Crear cuenta" devuelven a esta misma página (el script suma los filtros de la URL al tocarlos)
const entrar = enBienvenida ? '/entrar' : conVolver('/entrar', ruta);
const crear = enBienvenida ? '/registro' : conVolver('/registro', ruta);
const actual = (destino: string) => (ruta === destino ? 'page' : undefined);
---

<header class:list={['encabezado', clase]} data-encabezado data-encabezado-visitante>
  <div class="fila">
    <Logo href="/" />

    <form class="buscador" role="search" action="/agenda" method="get" data-buscador-app>
      <Icono nombre="lupa" tamano={18} class="lupa" />
      <input type="search" name="q" placeholder="¿Qué plan buscas?" aria-label="Buscar planes" />
      <label class="ciudad">
        <Icono nombre="pin" tamano={16} />
        <span class="solo-lectores">Ciudad</span>
        <select name="ciudad" data-selector-ciudad>
          <option value="all">Toda Colombia</option>
          {ciudades.map((c) => <option value={c.id}>{c.nombre}</option>)}
        </select>
      </label>
      <button type="submit" class="ir" aria-label="Buscar">
        <Icono nombre="lupa" tamano={16} grosor={2.5} />
      </button>
    </form>

    <!-- En celular el menú se pliega detrás de un botón; sin JavaScript queda abierto -->
    <button type="button" class="abrir-menu" aria-expanded="false" aria-controls="menu-visitante" hidden data-abrir-menu>
      <Icono nombre="menu" tamano={22} class="icono-abrir" />
      <Icono nombre="cerrar" tamano={22} class="icono-cerrar" />
      <span class="solo-lectores">Menú</span>
    </button>

    <nav aria-label="Principal" class="nav" id="menu-visitante" data-menu-visitante>
      <a href={enBienvenida ? '#como-funciona' : '/#como-funciona'}>Cómo funciona</a>
      <a href="/mapa" class="con-insignia" aria-current={actual('/mapa')}>Mapa <span class="insignia">Nuevo</span></a>
      <a href={enBienvenida ? '#agenda' : '/agenda'} aria-current={actual('/agenda')}>Agenda</a>
      <!-- Centro de noticias (decisión 2.25): siempre la página, también desde la Bienvenida (como el Mapa) -->
      <a href="/noticias" aria-current={actual('/noticias')}>Noticias</a>
      <a href={entrar} class="fuerte entrar" data-volver-actual={enBienvenida ? undefined : '/entrar'}>Entrar</a>
      <a href={crear} class="crear" data-volver-actual={enBienvenida ? undefined : '/registro'}>Crear cuenta</a>
    </nav>
  </div>
</header>

<script>
  import { conVolver, rutaActual } from '../../lib/sesion';

  document.querySelectorAll<HTMLElement>('[data-encabezado-visitante]').forEach((encabezado) => {
    // Mientras no exista la pantalla de resultados (H41), buscar lleva a la agenda con lo escrito y la ciudad
    // elegida (decisión 2.15). En la Agenda filtra sin recargar (AgendaApp). En la Bienvenida, con texto va a
    // la agenda con los resultados (decisión 2.31); sin texto baja a "Este finde".
    const buscador = encabezado.querySelector<HTMLFormElement>('[data-buscador-app]');
    buscador?.addEventListener('submit', (ev) => {
      if (document.querySelector('[data-agenda-app]')) {
        ev.preventDefault();
        return;
      }
      const texto = String(new FormData(buscador).get('q') ?? '').trim();
      const agenda = document.querySelector<HTMLElement>('#agenda');
      if (texto || !agenda) return;
      ev.preventDefault();
      agenda.scrollIntoView();
      document.querySelector<HTMLElement>('#agenda-titulo')?.focus();
    });

    // "Entrar" y "Crear cuenta" vuelven al mismo punto, con los filtros que tenga la URL en ese momento
    encabezado.querySelectorAll<HTMLAnchorElement>('[data-volver-actual]').forEach((a) =>
      a.addEventListener('click', () => (a.href = conVolver(a.dataset.volverActual!, rutaActual()))),
    );

    // Menú plegable de celular (decisión 2.18): Escape lo cierra y devuelve el foco al botón
    const botonMenu = encabezado.querySelector<HTMLButtonElement>('[data-abrir-menu]');
    const menu = encabezado.querySelector<HTMLElement>('[data-menu-visitante]');
    if (botonMenu && menu) {
      botonMenu.hidden = false;
      menu.classList.add('plegable');
      const alternar = (abrir: boolean) => {
        botonMenu.setAttribute('aria-expanded', String(abrir));
        menu.classList.toggle('abierto', abrir);
      };
      botonMenu.addEventListener('click', () => alternar(botonMenu.getAttribute('aria-expanded') !== 'true'));
      menu.addEventListener('click', (ev) => {
        if ((ev.target as HTMLElement).closest('a')) alternar(false);
      });
      document.addEventListener('keydown', (ev) => {
        if (ev.key === 'Escape' && botonMenu.getAttribute('aria-expanded') === 'true') {
          alternar(false);
          botonMenu.focus();
        }
      });
    }

    // El foco y los saltos de ancla no deben quedar debajo del encabezado fijo (H16). Si este encabezado está
    // oculto (la otra versión es la visible, decisión 2.24), no toca el valor.
    const ajustar = () => {
      if (!encabezado.getClientRects().length) return;
      const fijo = getComputedStyle(encabezado).position === 'sticky';
      const alto = fijo ? encabezado.offsetHeight + 12 : 12;
      document.documentElement.style.scrollPaddingTop = `${alto}px`;
    };
    new ResizeObserver(ajustar).observe(encabezado);
    addEventListener('resize', ajustar);
  });
</script>

<style>
  .encabezado {
    position: sticky;
    top: env(safe-area-inset-top, 0px);
    z-index: 10;
    background: var(--bg);
  }

  .fila {
    box-sizing: content-box;
    max-width: var(--ancho-max);
    margin-inline: auto;
    padding: 14px var(--margen-lateral);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px 24px;
  }


  .buscador {
    flex: 1 1 300px;
    max-width: 520px;
    min-width: 0;
    display: flex;
    align-items: center;
    gap: 10px;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius-pill);
    padding: 4px 4px 4px 18px;
  }

  /* Foco visible en el campo píldora (H51) */
  .buscador:focus-within {
    border-color: var(--brand);
    box-shadow: 0 0 0 1px var(--brand);
  }

  .buscador :global(.lupa) {
    flex-shrink: 0;
    color: var(--muted);
  }

  input {
    flex: 1;
    min-width: 0;
    border: 0;
    background: transparent;
    font-size: .95rem;
    color: var(--ink);
  }

  input:focus-visible {
    outline: none;
  }

  input::placeholder {
    color: var(--placeholder);
  }

  .ciudad {
    display: flex;
    align-items: center;
    gap: 4px;
    padding-left: 12px;
    border-left: 1px solid var(--line);
    font-size: .9rem;
    white-space: nowrap;
    flex-shrink: 0;
  }

  select {
    height: 40px;
    max-width: 8.6em;
    border: 0;
    background: transparent;
    font-size: .9rem;
    font-weight: 500;
    color: var(--ink);
    cursor: pointer;
  }

  .ir {
    flex-shrink: 0;
    width: 40px;
    height: 40px;
    border: 0;
    border-radius: 50%;
    display: grid;
    place-items: center;
    background: var(--brand);
    color: var(--on-dark);
  }

  .nav {
    margin-left: auto;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 20px;
    font-size: .92rem;
    font-weight: 500;
  }

  .con-insignia {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }

  .insignia {
    background: var(--yellow);
    color: var(--ink);
    border-radius: var(--radius-pill);
    padding: 1px 7px;
    font-size: .68rem;
    font-weight: 700;
    line-height: 1.4;
  }

  .fuerte {
    font-weight: 700;
  }

  /* Página actual (Agenda, Mapa o Noticias públicos, decisiones 2.24 y 2.25) */
  .nav a[aria-current='page'] {
    text-decoration: underline;
    text-decoration-color: var(--brand);
    text-decoration-thickness: 2px;
    text-underline-offset: 6px;
  }

  .crear,
  .crear:hover {
    background: var(--ink);
    color: var(--on-dark);
    border-radius: var(--radius-pill);
    padding: 11px 18px;
    font-weight: 700;
  }

  .abrir-menu {
    display: none;
  }

  /* En celular el encabezado deja de ser fijo (H40, decisión 2.14) y se compacta (decisión 2.18):
     logo, "Entrar" y el botón de menú en una fila; el buscador debajo; el resto del menú plegado */
  @media (max-width: 767px) {
    .encabezado {
      position: static;
      --tope-logo: 40px;
    }

    .fila {
      padding-block: 10px 12px;
      gap: 10px 12px;
    }

    .fila :global(.logo) {
      margin-right: auto;
    }

    .buscador {
      order: 5;
      flex-basis: 100%;
      max-width: none;
    }

    .abrir-menu:not([hidden]) {
      order: 2;
      display: grid;
      place-items: center;
      width: 44px;
      height: 44px;
      margin-right: -8px;
      border: 0;
      border-radius: 12px;
      background: transparent;
      color: var(--ink);
    }

    .abrir-menu :global(.icono-cerrar),
    .abrir-menu[aria-expanded='true'] :global(.icono-abrir) {
      display: none;
    }

    .abrir-menu[aria-expanded='true'] :global(.icono-cerrar) {
      display: block;
    }

    .nav.plegable {
      display: contents;
    }

    .nav.plegable > a:not(.entrar) {
      display: none;
    }

    .nav.plegable > .entrar {
      order: 1;
      display: inline-flex;
      align-items: center;
      min-height: 44px;
      padding-inline: 4px;
    }

    /* Menú abierto: panel a todo el ancho entre la primera fila y el buscador */
    .nav.plegable.abierto {
      order: 3;
      flex-basis: 100%;
      display: flex;
      flex-direction: column;
      align-items: stretch;
      gap: 0;
      margin: 0;
      padding: 4px 0 6px;
      border-top: 1px solid var(--line);
      font-size: 1rem;
    }

    /* Abierto, "Entrar" pasa de la primera fila a la lista del panel */
    .nav.plegable.abierto > a {
      order: 0;
      display: flex;
      padding-inline: 0;
      align-items: center;
      min-height: 48px;
      border-bottom: 1px solid var(--line-soft);
    }

    .nav.plegable.abierto > .crear {
      justify-content: center;
      padding-inline: 18px;
      margin-top: 10px;
      border-bottom: 0;
    }
  }


  /* Por debajo de 480 px la ciudad baja a su propia línea dentro del buscador (H8) */
  @media (max-width: 479px) {
    .buscador {
      flex-wrap: wrap;
      border-radius: 24px;
      row-gap: 0;
    }

    .ciudad {
      order: 3;
      flex-basis: 100%;
      padding: 0;
      border-left: 0;
      border-top: 1px solid var(--line);
      margin-right: 14px;
    }

    select {
      max-width: none;
      flex: 1;
    }
  }
</style>
