---
// N1 · Encabezado con sesión: un solo componente con variantes (H41).
// completo: Inicio, Agenda, Mapa, Mensajes, Mi perfil (/yo) · detalle: Evento y perfil de otra persona
// Por debajo de 768 px (decisión 2.27) es una sola fila: logo + lupa, "+" y avatar (completo) o flecha "Volver",
// logo centrado y avatar (detalle). Los íconos de secciones pasan a la barra inferior (BarraNavegacion, N70).
import Icono, { type NombreIcono } from '../ui/Icono.astro';
import Logo from '../ui/Logo.astro';
import { ciudades } from '../../data/ciudades';
import { usuaria } from '../../data/personas';
import { chatsSinLeer } from '../../data/mensajes';
import { nombreMensajes } from '../../lib/formato';

// 'yo': Mi perfil. Marca el avatar (aria-current y anillo), que es el enlace a /yo (decisión 2.29)
type Pagina = 'inicio' | 'agenda' | 'mapa' | 'noticias' | 'mensajes' | 'yo';

interface Props {
  variante?: 'completo' | 'detalle';
  activa?: Pagina;
  noLeidos?: number;
  // En Evento, Agenda, Mapa y Bienvenida va junto al EncabezadoVisitante con class="solo-sesion" (decisión 2.24)
  class?: string;
}

// Sin cifra propia de la página, la de los datos del chat (una sola fuente, H13)
const { variante = 'completo', activa, noLeidos = chatsSinLeer, class: clase } = Astro.props;

const iconos: { id: Pagina; href: string; icono: NombreIcono; nombre: string }[] = [
  { id: 'inicio', href: '/inicio', icono: 'inicio', nombre: 'Inicio' },
  { id: 'agenda', href: '/agenda', icono: 'agenda', nombre: 'Agenda de eventos' },
  { id: 'mapa', href: '/mapa', icono: 'mapa', nombre: 'Mapa de eventos' },
  // Noticias, la sección de contenido (decisión 2.25): también con sesión, no solo en "Secciones" de Inicio
  { id: 'noticias', href: '/noticias', icono: 'noticias', nombre: 'Noticias' },
  {
    id: 'mensajes',
    href: '/mensajes',
    icono: 'mensajes',
    nombre: nombreMensajes(noLeidos),
  },
];
---

<header class:list={['encabezado', variante, clase]} data-encabezado data-encabezado-app>
  <div class="fila">
    {
      variante !== 'completo' && (
        <a href="/inicio" class="volver" data-volver>
          <Icono nombre="volver" tamano={18} />
          {/* En celular solo la flecha (44 × 44); el texto queda para lectores de pantalla */}
          <span class="texto-volver">Volver</span>
        </a>
      )
    }

    <Logo href="/inicio" />

    {
      variante === 'completo' && (
        <form class="buscador" id="buscador-app" role="search" action="/agenda" method="get" data-buscador-app>
          <Icono nombre="lupa" tamano={18} class="lupa" />
          <input type="search" name="q" placeholder="Busca planes, gente o lugares" aria-label="Buscar" />
          <label class="ciudad">
            <Icono nombre="pin" tamano={16} />
            <span class="solo-lectores">Ciudad</span>
            <select name="ciudad" data-selector-ciudad>
              <option value="all">Toda Colombia</option>
              {ciudades.map((c) => <option value={c.id}>{c.nombre}</option>)}
            </select>
          </label>
        </form>
      )
    }

    <nav aria-label="Principal" class="iconos">
      {iconos.map((i) => (
        <a href={i.href} class="icono" aria-label={i.nombre} aria-current={activa === i.id ? 'page' : undefined}>
          <Icono nombre={i.icono} tamano={20} />
          {i.id === 'mensajes' && noLeidos > 0 && <span class="insignia" aria-hidden="true">{noLeidos}</span>}
        </a>
      ))}
      <button type="button" class="icono" aria-label="Notificaciones">
        <Icono nombre="campana" tamano={20} />
      </button>
      {/* Antes "Crear evento": lleva a los dos caminos, un evento nuevo o una publicación sobre uno (decisión 2.26) */}
      {variante === 'completo' && (
        <a href="/crear-evento" class="crear">
          <Icono nombre="mas" tamano={16} grosor={2.4} />Publicar
        </a>
      )}
      <a href="/yo" class="avatar" aria-label={`${usuaria.iniciales}, tu perfil`} aria-current={activa === 'yo' ? 'page' : undefined}>{usuaria.iniciales}</a>
    </nav>

    {/* Solo por debajo de 768 px (decisión 2.27). Fuera del nav: el nav "Principal" de celular es la barra inferior */}
    <div class="acciones-celular">
      {
        variante === 'completo' && (
          <>
            {/* Sin JavaScript el buscador se ve abierto y este botón no aparece (como el menú del visitante) */}
            <button type="button" class="redondo" aria-label="Buscar" aria-expanded="false" aria-controls="buscador-app" hidden data-abrir-busqueda>
              <Icono nombre="lupa" tamano={20} />
            </button>
            <a href="/crear-evento" class="redondo mas" aria-label="Publicar">
              <Icono nombre="mas" tamano={20} grosor={2.4} />
            </a>
          </>
        )
      }
      <a href="/yo" class="avatar" aria-label={`${usuaria.iniciales}, tu perfil`} aria-current={activa === 'yo' ? 'page' : undefined}>{usuaria.iniciales}</a>
    </div>
  </div>
</header>

<script>
  document.querySelectorAll<HTMLElement>('[data-encabezado-app]').forEach((encabezado) => {
    // "Volver" regresa a la pantalla de origen cuando se llegó desde Fulleventos (N1).
    encabezado.querySelector<HTMLAnchorElement>('[data-volver]')?.addEventListener('click', (ev) => {
      if (document.referrer && new URL(document.referrer).origin === location.origin && history.length > 1) {
        ev.preventDefault();
        history.back();
      }
    });

    // Mientras no exista la pantalla de resultados (H41), buscar abre la agenda con la ciudad elegida.
    encabezado.querySelector<HTMLFormElement>('[data-buscador-app]')?.addEventListener('submit', (ev) => {
      if (document.querySelector('[data-agenda-app]')) ev.preventDefault();
    });

    // Búsqueda plegable de celular (decisión 2.27): la lupa la abre debajo de la fila, con el foco en el campo;
    // Escape la cierra y devuelve el foco a la lupa. En computador el buscador siempre se ve.
    const lupa = encabezado.querySelector<HTMLButtonElement>('[data-abrir-busqueda]');
    const buscador = encabezado.querySelector<HTMLFormElement>('[data-buscador-app]');
    if (lupa && buscador) {
      lupa.hidden = false;
      encabezado.classList.add('busqueda-plegable');
      const celular = matchMedia('(max-width: 767px)');
      const alternar = (abrir: boolean) => {
        lupa.setAttribute('aria-expanded', String(abrir));
        buscador.classList.toggle('abierta', abrir);
        if (abrir) buscador.querySelector<HTMLInputElement>('input')?.focus();
      };
      lupa.addEventListener('click', () => alternar(lupa.getAttribute('aria-expanded') !== 'true'));
      buscador.addEventListener('keydown', (ev) => {
        if (ev.key === 'Escape' && celular.matches && lupa.getAttribute('aria-expanded') === 'true') {
          alternar(false);
          lupa.focus();
        }
      });
    }

    // Si este encabezado está oculto (la versión de visitante es la visible, decisión 2.24), no toca el valor
    const ajustar = () => {
      if (!encabezado.getClientRects().length) return;
      const fijo = getComputedStyle(encabezado).position === 'sticky';
      document.documentElement.style.scrollPaddingTop = `${fijo ? encabezado.offsetHeight + 12 : 12}px`;
    };
    new ResizeObserver(ajustar).observe(encabezado);
  });
</script>

<style>
  .encabezado {
    position: sticky;
    top: env(safe-area-inset-top, 0px);
    z-index: 10;
    background: var(--bg);
    border-bottom: 1px solid var(--line);
  }

  .fila {
    box-sizing: content-box;
    max-width: var(--ancho-max);
    margin-inline: auto;
    padding: 12px var(--margen-lateral);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px 20px;
  }

  .detalle :global(.logo) {
    margin-inline: auto;
  }

  /* Variantes de detalle: tres columnas para que el logo quede centrado en la página y no entre
     "Volver" y los íconos, que miden distinto. En celular la tercera columna es el avatar (decisión 2.27). */
  .detalle .fila {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
  }

  .detalle .volver {
    justify-self: start;
  }

  .detalle .iconos {
    justify-self: end;
    margin-left: 0;
  }

  .volver {
    display: flex;
    align-items: center;
    gap: 8px;
    height: 44px;
    font-weight: 700;
    font-size: .92rem;
  }

  .buscador {
    flex: 1 1 260px;
    max-width: 500px;
    min-width: 0;
    height: 44px;
    display: flex;
    align-items: center;
    gap: 10px;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius-pill);
    padding: 0 6px 0 16px;
  }

  .buscador:focus-within {
    border-color: var(--brand);
    box-shadow: 0 0 0 1px var(--brand);
  }

  .buscador :global(.lupa) {
    flex-shrink: 0;
    color: var(--muted);
  }

  input {
    flex: 1;
    min-width: 0;
    border: 0;
    background: transparent;
    font-size: .95rem;
    color: var(--ink);
  }

  input:focus-visible {
    outline: none;
  }

  input::placeholder {
    color: var(--placeholder);
  }

  .ciudad {
    display: flex;
    align-items: center;
    gap: 4px;
    padding-left: 10px;
    border-left: 1px solid var(--line);
    font-size: .9rem;
    white-space: nowrap;
    flex-shrink: 0;
  }

  select {
    height: 36px;
    max-width: 8.6em;
    border: 0;
    background: transparent;
    font-size: .9rem;
    font-weight: 500;
    color: var(--ink);
    cursor: pointer;
  }

  .iconos {
    margin-left: auto;
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    align-items: center;
    gap: 6px;
  }

  .icono {
    position: relative;
    width: 44px;
    height: 44px;
    border: 0;
    border-radius: 12px;
    background: transparent;
    color: var(--ink);
    display: grid;
    place-items: center;
  }

  .icono:hover {
    color: var(--brand);
  }

  .icono[aria-current='page'],
  .icono[aria-current='page']:hover {
    background: var(--ink);
    color: var(--on-dark);
  }

  .insignia {
    position: absolute;
    top: 6px;
    right: 6px;
    min-width: 18px;
    height: 18px;
    border-radius: 9px;
    background: var(--brand);
    color: var(--on-dark);
    font-size: .66rem;
    font-weight: 700;
    line-height: 1;
    display: grid;
    place-items: center;
    padding: 0 4px;
  }

  .icono[aria-current='page'] .insignia {
    top: 4px;
    right: 4px;
    box-shadow: 0 0 0 2px var(--ink);
  }

  .crear,
  .crear:hover {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    height: 44px;
    padding: 0 18px 0 14px;
    margin-left: 6px;
    border-radius: var(--radius-pill);
    background: var(--ink);
    color: var(--on-dark);
    font-weight: 700;
    font-size: .9rem;
  }

  .avatar {
    width: 40px;
    height: 40px;
    margin-left: 4px;
    border-radius: 50%;
    background: var(--aqua);
    display: grid;
    place-items: center;
    font-weight: 700;
    font-size: .78rem;
  }

  /* Mi perfil (decisión 2.29): el avatar es la página actual. Anillo doble, no solo color */
  .avatar[aria-current='page'] {
    box-shadow: 0 0 0 2px var(--bg), 0 0 0 4px var(--ink);
  }

  .acciones-celular {
    display: none;
  }

  /* En celular el encabezado deja de ser fijo (H40, decisiones 2.14 y 2.15) y es una sola fila de unos 61 px
     (decisión 2.27): las secciones, la campana y "Publicar" con texto pasan a la barra inferior o al "+" */
  @media (max-width: 767px) {
    .encabezado {
      position: static;
      --tope-logo: 32px;
    }

    .fila {
      padding-block: 8px;
      flex-wrap: wrap;
      gap: 8px;
    }

    .iconos {
      display: none;
    }

    .acciones-celular {
      display: flex;
      align-items: center;
      gap: 4px;
      margin-left: auto;
    }

    .detalle .acciones-celular {
      justify-self: end;
      margin-left: 0;
    }

    .redondo {
      position: relative;
      width: 44px;
      height: 44px;
      border: 0;
      border-radius: 50%;
      background: transparent;
      color: var(--ink);
      display: grid;
      place-items: center;
    }

    .redondo:hover {
      color: var(--brand);
    }

    .redondo[aria-expanded='true'] {
      background: var(--surface-sunken);
    }

    .redondo.mas,
    .redondo.mas:hover {
      background: var(--ink);
      color: var(--on-dark);
    }

    .avatar {
      width: 44px;
      height: 44px;
      margin-left: 0;
    }

    .volver {
      width: 44px;
      justify-content: center;
      border-radius: 50%;
    }

    .texto-volver {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip: rect(0 0 0 0);
      white-space: nowrap;
    }

    /* El buscador baja a su propia línea, a todo el ancho; con JavaScript se pliega detrás de la lupa */
    .buscador {
      order: 10;
      flex: 1 1 100%;
      max-width: none;
    }

    .busqueda-plegable .buscador:not(.abierta) {
      display: none;
    }
  }
</style>
