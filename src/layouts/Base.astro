---
import '../styles/tokens.css';
import '../styles/base.css';
import { CLAVE_SESION } from '../lib/sesion';

// Descripción propuesta, pendiente de aprobación del cliente (decisión 2.15)
const DESCRIPCION =
  'Descubre planes en toda Colombia, mira a qué van tus amigos y arma parche: rumba, conciertos, fútbol, teatro y planes gratis este finde.';

interface Props {
  titulo: string;
  descripcion?: string;
  // 16 px en las pantallas públicas; 15 px en las pantallas con sesión (sección 3)
  tamanoBase?: 15 | 16;
  // Inicio, Mensajes, /yo y /perfil/*: sin sesión llevan a /entrar?volver=<ruta actual> (decisión 2.24)
  requiereSesion?: boolean;
}

const { titulo, descripcion = DESCRIPCION, tamanoBase = 16, requiereSesion = false } = Astro.props;
---

<!doctype html>
<html lang="es" data-sesion="no">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- Sesión de demostración (decisión 2.24, lib/sesion.ts). Va antes de los estilos para que la página se
         pinte de una vez como visitante o con sesión, sin parpadeo. Sin JavaScript queda la versión pública. -->
    <script is:inline define:vars={{ clave: CLAVE_SESION, requiere: requiereSesion }}>
      var leer = function () {
        try {
          return localStorage.getItem(clave) === '1';
        } catch (e) {
          return false;
        }
      };
      var conSesion = leer();
      if (conSesion) document.documentElement.setAttribute('data-sesion', 'si');
      else if (requiere) {
        document.documentElement.style.display = 'none';
        location.replace('/entrar?volver=' + encodeURIComponent(location.pathname + location.search + location.hash));
      }
      // Si la sesión cambió en otra pestaña o al volver con "Atrás" (página guardada en memoria), se recarga
      addEventListener('pageshow', function (ev) {
        if (ev.persisted && leer() !== conSesion) location.reload();
      });
      addEventListener('storage', function (ev) {
        if (ev.key === clave && leer() !== conSesion) location.reload();
      });
    </script>
    <!-- Sitio de demostración con datos de ejemplo: que los buscadores no lo indexen (M7, H34).
         Quitar esta etiqueta y public/robots.txt al publicar con datos reales. -->
    <meta name="robots" content="noindex, nofollow" />
    <title>{titulo}</title>
    <meta name="description" content={descripcion} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_CO" />
    <meta property="og:site_name" content="Fulleventos" />
    <meta property="og:title" content={titulo} />
    <meta property="og:description" content={descripcion} />
    <meta name="theme-color" content="#FBF7F3" />
    <!-- Ícono de la marca (decisión 2.21) -->
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Archivo:wght@800;900&family=DM+Sans:opsz,wght@9..40,400;9..40,500;9..40,700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body style={tamanoBase === 15 ? 'font-size: 15px' : undefined}>
    <a class="salto" href="#contenido">Saltar al contenido</a>
    <slot />
  </body>
</html>
