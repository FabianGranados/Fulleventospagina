---
// Centro de noticias (decisión 2.25). Pública, como Evento, Agenda y Mapa (decisión 2.24): los dos encabezados y
// solo uno visible. Las noticias salen de la colección src/content/noticias (una sola fuente).
// Filtros por ciudad y tema en la URL (?ciudad=&tema=, H42), en botones con hoja (decisión 2.38). Sin JavaScript se
// ven todas y no aparecen los filtros. Las tarjetas llevan solo la imagen y el titular.
import Base from '../../layouts/Base.astro';
import EncabezadoApp from '../../components/layout/EncabezadoApp.astro';
import EncabezadoVisitante from '../../components/layout/EncabezadoVisitante.astro';
import Pie from '../../components/layout/Pie.astro';
import BarraNavegacion from '../../components/layout/BarraNavegacion.astro';
import TarjetaNoticia from '../../components/noticias/TarjetaNoticia.astro';
import BotonFiltro from '../../components/filtros/BotonFiltro.astro';
import HojaFiltro from '../../components/filtros/HojaFiltro.astro';
import OpcionFiltro from '../../components/filtros/OpcionFiltro.astro';
import { ciudades } from '../../data/ciudades';
import { TEMAS, temas } from '../../data/noticias';
import { ciudadesDe, noticiasOrdenadas, separarDestacada } from '../../lib/noticias';

const todas = await noticiasOrdenadas();
const { destacada, resto } = separarDestacada(todas);

// Solo las ciudades y los temas que tienen noticias, en el orden de siempre
const conNoticias = new Set(todas.flatMap(ciudadesDe));
const ciudadesFiltro = ciudades.filter((c) => conNoticias.has(c.id));
const temasFiltro = temas.filter((t) => todas.some((n) => n.data.tema === t));
const porCiudad = (id: string) => todas.filter((n) => ciudadesDe(n).includes(id)).length;
const porTema = (t: string) => todas.filter((n) => n.data.tema === t).length;
const unidad: [string, string] = ['noticia', 'noticias'];

const datosFiltro = (n: (typeof todas)[number]) => ({
  'data-noticia': true,
  'data-ciudades': ciudadesDe(n).join(' '),
  'data-tema': n.data.tema,
});

const descripcion =
  'Noticias de la escena en toda Colombia: conciertos, rumba, deporte, teatro, comida y guías para armar plan con tu parche.';
---

<Base titulo="Noticias · Fulleventos" descripcion={descripcion}>
  <EncabezadoVisitante class="solo-visitante" />
  <EncabezadoApp variante="completo" activa="noticias" class="solo-sesion" />
  <main id="contenido" class="contenedor principal">
    <div class="cabecera">
      <div>
        <p class="antetitulo">Lo que se mueve</p>
        <h1 id="noticias-titulo">Noticias de la escena</h1>
        <p class="bajada">Lo que pasa en conciertos, rumba, deporte, teatro y comida en toda Colombia, con los planes para ir.</p>
      </div>
      <span class="ejemplo">Contenido de ejemplo</span>
    </div>

    <!-- Filtros de ciudad y tema (decisión 2.38): dos botones con su hoja de opciones, como en la Agenda -->
    <div class="filtros" hidden data-filtros>
      <BotonFiltro hoja="filtro-ciudad" filtro="ciudad" rotulo="Ciudad" icono="pin">Toda Colombia</BotonFiltro>
      <BotonFiltro hoja="filtro-tema" filtro="tema" rotulo="Tema" icono="filtro">Todos los temas</BotonFiltro>
    </div>

    <HojaFiltro id="filtro-ciudad" titulo="Ciudad" leyenda="Filtrar por ciudad">
      <OpcionFiltro nombre="noticias-ciudad" valor="all" atributo="ciudad" checked icono="pin" conteo={todas.length} unidad={unidad}>
        Toda Colombia
      </OpcionFiltro>
      {
        ciudadesFiltro.map((c) => (
          <OpcionFiltro nombre="noticias-ciudad" valor={c.id} atributo="ciudad" conteo={porCiudad(c.id)} unidad={unidad}>
            {c.nombre}
          </OpcionFiltro>
        ))
      }
    </HojaFiltro>

    <HojaFiltro id="filtro-tema" titulo="Tema" leyenda="Filtrar por tema">
      <OpcionFiltro nombre="noticias-tema" valor="all" atributo="tema" checked icono="filtro" conteo={todas.length} unidad={unidad}>
        Todos los temas
      </OpcionFiltro>
      {
        temasFiltro.map((t) => (
          <OpcionFiltro nombre="noticias-tema" valor={t} atributo="tema" conteo={porTema(t)} unidad={unidad}>
            {TEMAS[t]}
          </OpcionFiltro>
        ))
      }
    </HojaFiltro>

    <p class="solo-lectores" role="status" data-anuncio></p>

    {destacada && <TarjetaNoticia noticia={destacada} variante="grande" class="destacada" data-bloque-destacada />}

    <div class="vacio" hidden data-vacio>
      <p data-vacio-mensaje></p>
      <button type="button" class="boton-contorno" data-limpiar>Ver todas las noticias</button>
    </div>

    <ul class="rejilla" aria-labelledby="noticias-titulo">
      {
        destacada && (
          <li hidden data-copia-destacada {...datosFiltro(destacada)}>
            <TarjetaNoticia noticia={destacada} />
          </li>
        )
      }
      {
        resto.map((n) => (
          <li {...datosFiltro(n)}>
            <TarjetaNoticia noticia={n} />
          </li>
        ))
      }
    </ul>
  </main>
  <Pie />
  <BarraNavegacion activa="noticias" class="solo-sesion" />
</Base>

<script>
  const filtros = document.querySelector<HTMLElement>('[data-filtros]')!;
  const radiosCiudad = [...document.querySelectorAll<HTMLInputElement>('input[data-ciudad]')];
  const radiosTema = [...document.querySelectorAll<HTMLInputElement>('input[data-tema]')];
  const botonCiudad = filtros.querySelector<HTMLElement>('[data-filtro="ciudad"]')!;
  const botonTema = filtros.querySelector<HTMLElement>('[data-filtro="tema"]')!;
  const botonesVer = [...document.querySelectorAll<HTMLElement>('[data-ver-resultados]')];
  const items = [...document.querySelectorAll<HTMLElement>('li[data-noticia]')];
  const copiaDestacada = document.querySelector<HTMLElement>('[data-copia-destacada]');
  const bloqueDestacada = document.querySelector<HTMLElement>('[data-bloque-destacada]');
  const vacio = document.querySelector<HTMLElement>('[data-vacio]')!;
  const mensajeVacio = document.querySelector<HTMLElement>('[data-vacio-mensaje]')!;
  const anuncio = document.querySelector<HTMLElement>('[data-anuncio]')!;

  const valido = (radios: HTMLInputElement[], valor: string | null) =>
    valor && radios.some((r) => r.value === valor) ? valor : 'all';

  const params = new URLSearchParams(location.search);
  const estado = {
    ciudad: valido(radiosCiudad, params.get('ciudad')),
    tema: valido(radiosTema, params.get('tema')),
  };

  const etiqueta = (r: HTMLInputElement) => r.closest('label')!.querySelector<HTMLElement>('[data-nombre]')!;
  const nombre = (radios: HTMLInputElement[], valor: string) =>
    etiqueta(radios.find((r) => r.value === valor)!).textContent!.trim();

  // Una noticia (de la lista, sin la copia de la destacada) pasa los filtros dados
  const unicas = items.filter((li) => li !== copiaDestacada);
  const pasa = (li: HTMLElement, ciudad: string, tema: string) =>
    (ciudad === 'all' || li.dataset.ciudades!.split(' ').includes(ciudad)) && (tema === 'all' || li.dataset.tema === tema);
  const contar = (ciudad: string, tema: string) =>
    unicas.filter((li) => pasa(li, ciudad, tema)).length + (copiaDestacada && pasa(copiaDestacada, ciudad, tema) ? 1 : 0);

  // Conteo de cada opción: sigue al otro filtro; las opciones sin noticias se atenúan
  const pintarConteos = (radios: HTMLInputElement[], calcular: (valor: string) => number) =>
    radios.forEach((r) => {
      const n = calcular(r.value);
      const caja = document.querySelector(`[name="${r.name}"][value="${r.value}"]`)!.closest('label')!.querySelector('.conteo');
      if (caja) {
        caja.firstChild!.textContent = String(n);
        caja.querySelector('.solo-lectores')!.textContent = n === 1 ? ' noticia' : ' noticias';
      }
      r.closest('label')!.classList.toggle('vacia', n === 0);
    });

  const aplicar = (anunciar: boolean) => {
    radiosCiudad.forEach((r) => (r.checked = r.value === estado.ciudad));
    radiosTema.forEach((r) => (r.checked = r.value === estado.tema));
    botonCiudad.querySelector('[data-filtro-texto]')!.textContent = nombre(radiosCiudad, estado.ciudad);
    botonTema.querySelector('[data-filtro-texto]')!.textContent = nombre(radiosTema, estado.tema);
    botonCiudad.classList.toggle('activo', estado.ciudad !== 'all');
    botonTema.classList.toggle('activo', estado.tema !== 'all');
    pintarConteos(radiosCiudad, (c) => contar(c, estado.tema));
    pintarConteos(radiosTema, (t) => contar(estado.ciudad, t));

    const filtrando = estado.ciudad !== 'all' || estado.tema !== 'all';
    // Con un filtro la destacada deja de ir aparte y entra en la lista, en su orden por fecha
    if (bloqueDestacada) bloqueDestacada.hidden = filtrando;
    let visibles = 0;
    items.forEach((li) => {
      const mostrar = pasa(li, estado.ciudad, estado.tema) && (li !== copiaDestacada || filtrando);
      li.hidden = !mostrar;
      if (mostrar) visibles++;
    });
    if (!filtrando && bloqueDestacada) visibles++;

    const texto = visibles ? `Ver ${visibles} ${visibles === 1 ? 'noticia' : 'noticias'}` : 'Ver resultados';
    botonesVer.forEach((b) => (b.textContent = texto));

    vacio.hidden = visibles > 0;
    if (!visibles) {
      const tema = estado.tema === 'all' ? '' : ` de ${nombre(radiosTema, estado.tema).toLowerCase()}`;
      const ciudad = estado.ciudad === 'all' ? '' : ` en ${nombre(radiosCiudad, estado.ciudad)}`;
      mensajeVacio.textContent = `Todavía no hay noticias${tema}${ciudad}.`;
    }
    if (anunciar) anuncio.textContent = visibles ? `Mostrando ${visibles} ${visibles === 1 ? 'noticia' : 'noticias'}` : mensajeVacio.textContent!;

    const url = new URL(location.href);
    url.searchParams.delete('ciudad');
    url.searchParams.delete('tema');
    if (estado.ciudad !== 'all') url.searchParams.set('ciudad', estado.ciudad);
    if (estado.tema !== 'all') url.searchParams.set('tema', estado.tema);
    history.replaceState(null, '', url);
  };

  radiosCiudad.forEach((r) =>
    r.addEventListener('change', () => {
      if (!r.checked) return;
      estado.ciudad = r.value;
      aplicar(true);
    }),
  );
  radiosTema.forEach((r) =>
    r.addEventListener('change', () => {
      if (!r.checked) return;
      estado.tema = r.value;
      aplicar(true);
    }),
  );
  document.querySelector('[data-limpiar]')?.addEventListener('click', () => {
    estado.ciudad = 'all';
    estado.tema = 'all';
    aplicar(true);
    botonCiudad.focus();
  });

  filtros.hidden = false;
  aplicar(false);
</script>

<style>
  .principal {
    padding-top: 28px;
    padding-bottom: 64px;
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .principal + :global(.pie) {
    margin-top: 0;
  }

  .cabecera {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 12px 16px;
  }

  .antetitulo {
    margin-bottom: 6px;
    font-size: .74rem;
    font-weight: 700;
    letter-spacing: .12em;
    text-transform: uppercase;
    color: var(--brand);
  }

  h1 {
    font-family: var(--display);
    font-weight: 900;
    font-size: clamp(1.9rem, 3.6vw, 2.8rem);
    letter-spacing: -0.03em;
    line-height: 1.02;
  }

  .bajada {
    margin-top: 8px;
    color: var(--muted);
    max-width: 62ch;
  }

  .ejemplo {
    font-size: .78rem;
    color: var(--muted);
  }

  .filtros {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .rejilla {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 320px), 1fr));
    gap: 20px;
  }

  /* N67 · Estado vacío, como el de la Agenda */
  .vacio {
    text-align: center;
    padding: 40px 16px;
    background: var(--surface);
    border: 1px dashed var(--line);
    border-radius: var(--radius-card);
  }

  .vacio p {
    margin-bottom: 14px;
    color: var(--muted);
  }

  .boton-contorno {
    min-height: 44px;
    border: 1px solid var(--ink);
    border-radius: var(--radius-pill);
    background: var(--surface);
    padding: 0 18px;
    font-size: .9rem;
    font-weight: 700;
    color: var(--ink);
  }

  .boton-contorno:hover {
    background: var(--light-hover);
  }
</style>
