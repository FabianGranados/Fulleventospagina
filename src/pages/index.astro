---
import Base from '../layouts/Base.astro';
import EncabezadoVisitante from '../components/layout/EncabezadoVisitante.astro';
import EncabezadoApp from '../components/layout/EncabezadoApp.astro';
import Pie from '../components/layout/Pie.astro';
import BarraNavegacion from '../components/layout/BarraNavegacion.astro';
import Hero from '../components/bienvenida/Hero.astro';
import AgendaFinde from '../components/bienvenida/AgendaFinde.astro';
import ComoFunciona from '../components/bienvenida/ComoFunciona.astro';
import BloqueMapa from '../components/bienvenida/BloqueMapa.astro';
import Unete from '../components/bienvenida/Unete.astro';
import Noticias from '../components/bienvenida/Noticias.astro';
---

<Base titulo="Fulleventos Colombia">
  <!-- Pública. Con la sesión de demostración (decisión 2.24) el encabezado pasa a ser el de la app -->
  <EncabezadoVisitante class="solo-visitante" buscador={false} />
  <EncabezadoApp variante="completo" class="solo-sesion" />
  <!-- Orden de la auditoría H44 (decisión 2.13): los planes a la venta justo después del héroe -->
  <main id="contenido" class="contenedor principal">
    <Hero />
    <AgendaFinde />
    <ComoFunciona />
    <BloqueMapa />
    <Unete />
    <Noticias />
  </main>
  <Pie />
  <BarraNavegacion class="solo-sesion" />
</Base>

<style>
  .principal {
    padding-top: 8px;
  }
</style>
