---
// 4.7 Mapa de eventos. /mapa?ciudad=<id> abre la ciudad elegida (H42); también se reflejan
// categoria=<id> y fecha=<id> para poder compartir y volver al mismo punto.
// Público (decisión 2.24, H33): el visitante ve todo el mapa; guardar, repostear y "Mi ciudad" son con sesión.
import Base from '../layouts/Base.astro';
import EncabezadoApp from '../components/layout/EncabezadoApp.astro';
import EncabezadoVisitante from '../components/layout/EncabezadoVisitante.astro';
import VentanaCuenta from '../components/ui/VentanaCuenta.astro';
import Pie from '../components/layout/Pie.astro';
import BarraNavegacion from '../components/layout/BarraNavegacion.astro';
import CabeceraMapa from '../components/mapa/CabeceraMapa.astro';
import MapaColombia from '../components/mapa/MapaColombia.astro';
import PanelResultados from '../components/mapa/PanelResultados.astro';
import RankingCiudades from '../components/mapa/RankingCiudades.astro';
import VentanaRepost from '../components/eventos/VentanaRepost.astro';
import { categoriasMapa } from '../data/mapa';
---

<Base titulo="Mapa de eventos · Fulleventos" tamanoBase={15}>
  <EncabezadoVisitante class="solo-visitante" />
  <EncabezadoApp variante="completo" activa="mapa" class="solo-sesion" />
  <main id="contenido" class="contenedor principal">
    <CabeceraMapa />

    <div class="chips" role="group" aria-label="Filtrar por categoría" data-chips>
      {
        categoriasMapa.map((c) => (
          <button type="button" class="chip" data-categoria={c.id} aria-pressed={c.id === 'all' ? 'true' : 'false'}>
            {c.texto}
          </button>
        ))
      }
    </div>

    <!-- Región viva permanente (H49) -->
    <p class="solo-lectores" role="status" data-anuncio></p>

    <div class="contenedor-fila">
      <div class="fila-mapa">
        <MapaColombia />
        <PanelResultados />
      </div>
    </div>

    <RankingCiudades />
  </main>
  <Pie />
  <BarraNavegacion activa="explorar" class="solo-sesion" />
  <VentanaRepost />
  <VentanaCuenta />
</Base>

<script>
  import { eventos } from '../data/eventos';
  import { ciudadesMapa, categoriasMapa, fechasMapa, miCiudad, LIMITE_LISTA } from '../data/mapa';
  import { planes, ciudadesTexto } from '../lib/formato';
  import { destinosRepost } from '../data/agenda';
  import { haySesion } from '../lib/sesion';

  type Estado = { ciudad: string | null; zoom: number; categoria: string; fecha: string; todo: boolean };

  const $ = <T extends Element = HTMLElement>(sel: string, raiz: ParentNode = document) => raiz.querySelector<T>(sel)!;
  const $$ = <T extends Element = HTMLElement>(sel: string, raiz: ParentNode = document) => [...raiz.querySelectorAll<T>(sel)];

  const porId = Object.fromEntries(ciudadesMapa.map((c) => [c.id, c]));
  const fechaPorId = Object.fromEntries(fechasMapa.map((f) => [f.id, f]));
  const categoriaPorId = Object.fromEntries(categoriasMapa.map((c) => [c.id, c]));
  const movimientoReducido = matchMedia('(prefers-reduced-motion: reduce)');

  const mapa = $('[data-mapa]');
  const marco = $('[data-marco]', mapa);
  const lienzo = $('[data-lienzo]', mapa);
  const capa = $('[data-capa]', mapa);
  const panel = $('[data-panel]');
  const tituloPanel = $('#panel-titulo');
  const lista = $('[data-lista]', panel);
  const ranking = $('[data-ranking]');
  const filaRanking = $('[data-ranking-fila]', ranking);
  // Selector de ciudad de los dos encabezados (visitante y con sesión, decisión 2.24); solo uno está visible
  const selectores = $$<HTMLSelectElement>('select[data-selector-ciudad]');
  const anuncio = $('[data-anuncio]');
  const botonMas = $<HTMLButtonElement>('[data-mas]', panel);
  const vistaLista = $<HTMLAnchorElement>('[data-vista-lista]');

  const pines = $$<HTMLButtonElement>('[data-pin]', mapa);
  const celdas = $$('[data-celda]', lista);
  const chipsRanking = $$<HTMLButtonElement>('[data-ranking-ciudad]', ranking);

  const estado: Estado = { ciudad: null, zoom: 1, categoria: 'all', fecha: 'finde', todo: false };

  // --- Reglas de estado (6.2.5) ---
  const reiniciar = () => Object.assign(estado, { ciudad: null, zoom: 1, todo: false });
  const elegir = (id: string) => Object.assign(estado, { ciudad: id, zoom: Math.max(estado.zoom, 2), todo: false });

  const filtrados = () => {
    const f = fechaPorId[estado.fecha];
    return eventos.filter(
      (e) =>
        (estado.categoria === 'all' || e.etiquetas.includes(estado.categoria)) && e.fecha >= f.desde && e.fecha <= f.hasta,
    );
  };

  const etiquetaZoom = (z: number) => String(z).replace('.', ',') + '×';
  const tamano = (n: number) => Math.min(70, 40 + 5 * (n - 1));

  const transformacion = () => {
    const Z = estado.zoom;
    const sel = estado.ciudad ? porId[estado.ciudad] : null;
    const px = sel ? sel.left : 50;
    const py = sel ? sel.top : 50;
    const k = sel ? Math.min(1, Math.max(0, Z - 1)) : 0;
    return { tx: px * (1 - Z) + k * (50 - px), ty: py * (1 - Z) + k * (50 - py) };
  };

  // Sin ciudad: "Toda Colombia"; con ciudad: su nombre
  const lugar = () => (estado.ciudad ? porId[estado.ciudad].nombre : null);

  const mensajeVacio = () => {
    const c = estado.categoria;
    const que = c === 'all' ? 'planes' : c === 'gratis' ? 'planes gratis' : `planes de ${categoriaPorId[c].texto}`;
    return `No hay ${que}${estado.ciudad ? ` en ${lugar()}` : ''} ${fechaPorId[estado.fecha].frase}.`;
  };

  // H50: los pines que quedan fuera del marco salen del orden de Tab
  const ajustarTabulacion = () => {
    const Z = estado.zoom;
    const { tx, ty } = transformacion();
    const f = Math.max(0, Math.min(1, (3 - Z) / 2));
    const r = lienzo.getBoundingClientRect();
    const m = marco.getBoundingClientRect();
    for (const pin of pines) {
      const c = porId[pin.dataset.pin!];
      const x = r.left + ((c.left / 100) * Z + tx / 100) * r.width + c.ox * f;
      const y = r.top + ((c.top / 100) * Z + ty / 100) * r.height + c.oy * f;
      const dentro = x > m.left + 8 && x < m.right - 8 && y > m.top + 8 && y < m.bottom - 8;
      pin.tabIndex = dentro ? 0 : -1;
    }
  };

  const pintar = ({ anunciar = true } = {}) => {
    const lista0 = filtrados();
    const conteo: Record<string, number> = {};
    for (const e of lista0) conteo[e.ciudad] = (conteo[e.ciudad] ?? 0) + 1;
    const activas = ciudadesMapa.filter((c) => conteo[c.id]);
    const fecha = fechaPorId[estado.fecha];
    const resumen = lista0.length ? `${planes(lista0.length)} en ${ciudadesTexto(activas.length)}` : 'Sin planes';

    // Cabecera de la página: la fecha sí cambia los textos (H39)
    $('[data-frase]').textContent = fecha.frase;
    $('[data-intro]').textContent = lista0.length
      ? `${resumen}, ${fecha.rango}. Toca un punto del mapa para ver qué hay en cada ciudad.`
      : `${resumen} ${fecha.rango}. Mira lo que hay este finde.`;
    $$<HTMLInputElement>('input[name="fecha"]').forEach((r) => (r.checked = r.value === estado.fecha));
    $$('[data-chips] [data-categoria]').forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.categoria === estado.categoria)));

    // --- Mapa ---
    const Z = estado.zoom;
    const { tx, ty } = transformacion();
    const f = Math.max(0, Math.min(1, (3 - Z) / 2));
    capa.style.transform = `translate(${tx.toFixed(2)}%, ${ty.toFixed(2)}%) scale(${Z})`;
    capa.style.setProperty('--inv', (1 / Z).toFixed(4));
    capa.style.setProperty('--f', String(f));
    for (const pin of pines) {
      const id = pin.dataset.pin!;
      const n = conteo[id] ?? 0;
      const elegido = estado.ciudad === id;
      const ancla = pin.parentElement!;
      ancla.hidden = n === 0;
      ancla.style.zIndex = String(elegido ? 60 : 40 - n);
      if (n) {
        const t = tamano(n);
        pin.style.setProperty('--tam', String(t));
        pin.style.setProperty('--fs', String(Math.round(t * 0.36)));
        $('[data-pin-conteo]', pin).textContent = String(n);
        $('[data-pin-unidad]', pin).textContent = n === 1 ? ' plan' : ' planes';
      }
      pin.setAttribute('aria-pressed', String(elegido));
    }

    $$('[data-accion="todo"]', mapa).forEach((b) => b.setAttribute('aria-pressed', String(!estado.ciudad)));
    $('[data-accion="mi-ciudad"]', mapa).setAttribute('aria-pressed', String(estado.ciudad === miCiudad));
    $('[data-zoom-nivel]', mapa).textContent = etiquetaZoom(Z);
    $('[data-zoom="-0.5"]', mapa).setAttribute('aria-disabled', String(Z <= 1));
    $('[data-zoom="0.5"]', mapa).setAttribute('aria-disabled', String(Z >= 3));
    $('[data-leyenda]', mapa).textContent = resumen;

    // --- Panel ---
    const visibles = lista0.filter((e) => !estado.ciudad || e.ciudad === estado.ciudad);
    const ids = new Set(visibles.map((e) => e.id));
    $('[data-panel-antetitulo]', panel).textContent = estado.ciudad ? 'Ciudad elegida' : 'Todo el país';
    $('[data-panel-nombre]', panel).textContent = lugar() ?? 'Toda Colombia';
    $('[data-panel-conteo]', panel).textContent = planes(visibles.length);
    $('[data-panel-sub]', panel).textContent = estado.ciudad
      ? `Lo que hay ${fecha.frase} en ${lugar()}, por fecha.`
      : 'Ordenados por ciudad y fecha. Usa «Ver en el mapa» para ubicar cada plan.';
    $$('[data-solo-ciudad]', panel).forEach((b) => (b.hidden = !estado.ciudad));

    let mostradas = 0;
    const porGrupo: Record<string, number> = {};
    for (const celda of celdas) {
      const t = $('[data-tarjeta]', celda);
      const pasa = ids.has(t.dataset.id!);
      const ver = pasa && (estado.todo || mostradas < LIMITE_LISTA);
      if (pasa) mostradas++;
      celda.hidden = !ver;
      if (ver) {
        porGrupo[`c:${t.dataset.ciudad}`] = 1;
        porGrupo[`d:${t.dataset.ciudad}:${t.dataset.fecha}`] = (porGrupo[`d:${t.dataset.ciudad}:${t.dataset.fecha}`] ?? 0) + 1;
      }
    }
    // Encabezados por ciudad sin ciudad elegida; por día con ciudad elegida (H47)
    $$('[data-grupo-ciudad]', lista).forEach((h) => {
      const id = h.dataset.grupoCiudad!;
      h.hidden = !!estado.ciudad || !porGrupo[`c:${id}`];
      $('[data-grupo-conteo]', h).textContent = planes(conteo[id] ?? 0);
    });
    $$('[data-grupo-dia]', lista).forEach((h) => {
      const del = visibles.filter((e) => e.ciudad === h.dataset.ciudad && e.fecha === h.dataset.grupoDia).length;
      h.hidden = !estado.ciudad || !porGrupo[`d:${h.dataset.ciudad}:${h.dataset.grupoDia}`];
      $('[data-grupo-conteo]', h).textContent = planes(del);
    });

    const vacio = $('[data-vacio]', lista);
    vacio.hidden = visibles.length > 0;
    if (!visibles.length) {
      $('[data-vacio-mensaje]', vacio).textContent = mensajeVacio();
      $('[data-vacio-pista]', vacio).textContent =
        estado.fecha !== 'finde'
          ? 'Mira lo que hay este finde.'
          : estado.ciudad
            ? 'Prueba otra categoría o mira toda Colombia.'
            : 'Prueba otra categoría.';
      $('[data-accion="fecha-finde"]', vacio).hidden = estado.fecha === 'finde';
      $('[data-accion="categorias"]', vacio).hidden = estado.categoria === 'all';
    }

    const ocultas = visibles.length - LIMITE_LISTA;
    $('[data-mas-contenedor]', lista).hidden = ocultas <= 0;
    if (ocultas > 0) {
      botonMas.setAttribute('aria-expanded', String(estado.todo));
      botonMas.textContent = estado.todo ? 'Ver menos planes' : ocultas === 1 ? 'Ver 1 plan más' : `Ver ${ocultas} planes más`;
    }

    // --- Ranking (de mayor a menor; empates en el orden de las ciudades) ---
    const orden = [...activas].sort((a, b) => conteo[b.id] - conteo[a.id]);
    chipsRanking.forEach((b) => (b.hidden = !conteo[b.dataset.rankingCiudad!]));
    for (const c of orden) {
      const b = chipsRanking.find((x) => x.dataset.rankingCiudad === c.id)!;
      b.setAttribute('aria-pressed', String(estado.ciudad === c.id));
      $('[data-ranking-conteo]', b).textContent = String(conteo[c.id]);
      $('[data-ranking-unidad]', b).textContent = conteo[c.id] === 1 ? ' plan' : ' planes';
      filaRanking.append(b);
    }
    ranking.hidden = orden.length === 0;

    // Selector del encabezado sincronizado con el mapa (N4)
    selectores.forEach((s) => (s.value = estado.ciudad ?? 'all'));

    // La dirección refleja ciudad, categoría y fecha (H42)
    const params = new URLSearchParams(location.search);
    const fijar = (clave: string, valor: string | null, defecto: string) =>
      valor && valor !== defecto ? params.set(clave, valor) : params.delete(clave);
    fijar('ciudad', estado.ciudad, 'all');
    fijar('categoria', estado.categoria, 'all');
    fijar('fecha', estado.fecha, 'finde');
    const qs = params.toString();
    history.replaceState(null, '', `${location.pathname}${qs ? `?${qs}` : ''}${location.hash}`);

    // "Lista" lleva a la Agenda con los mismos filtros (H41): ciudad, categoría y fecha usan los mismos ids
    const agenda = new URLSearchParams();
    if (estado.ciudad) agenda.set('ciudad', estado.ciudad);
    if (estado.categoria !== 'all') agenda.set('categoria', estado.categoria);
    if (estado.fecha !== 'finde') agenda.set('fecha', estado.fecha);
    const consultaAgenda = agenda.toString();
    vistaLista.href = `/agenda${consultaAgenda ? `?${consultaAgenda}` : ''}`;

    ajustarTabulacion();

    if (anunciar) {
      anuncio.textContent = visibles.length
        ? `Mostrando ${planes(visibles.length)} en ${lugar() ?? 'toda Colombia'}`
        : mensajeVacio();
    }
  };

  // Si el elemento con el foco desaparece, el foco va al título del panel (H7)
  const actualizar = (opciones?: { anunciar?: boolean }) => {
    const activo = document.activeElement as HTMLElement | null;
    pintar(opciones);
    if (activo && activo !== document.body && !activo.getClientRects().length) tituloPanel.focus();
  };

  // Mapa y lista apilados (celular y tableta): el resultado queda abajo, fuera de la vista (H42)
  const apilado = () => panel.getBoundingClientRect().top >= mapa.getBoundingClientRect().bottom - 1;
  const comportamiento = (): ScrollBehavior => (movimientoReducido.matches ? 'auto' : 'smooth');

  const mostrarResultado = () => {
    if (!apilado()) return;
    tituloPanel.focus({ preventScroll: true });
    panel.scrollIntoView({ behavior: comportamiento(), block: 'start' });
  };

  const tocarCiudad = (id: string, alternar = true) => {
    if (alternar && estado.ciudad === id) {
      reiniciar();
      actualizar();
      return;
    }
    elegir(id);
    actualizar();
    mostrarResultado();
  };

  // --- Eventos ---
  pines.forEach((p) => p.addEventListener('click', () => tocarCiudad(p.dataset.pin!)));
  chipsRanking.forEach((b) => b.addEventListener('click', () => tocarCiudad(b.dataset.rankingCiudad!)));
  $('[data-accion="mi-ciudad"]', mapa).addEventListener('click', () => tocarCiudad(miCiudad, false));

  $$('[data-accion="todo"]').forEach((b) =>
    b.addEventListener('click', () => {
      reiniciar();
      actualizar();
    }),
  );

  $$<HTMLButtonElement>('[data-zoom]', mapa).forEach((b) =>
    b.addEventListener('click', () => {
      if (b.getAttribute('aria-disabled') === 'true') return;
      estado.zoom = Math.min(3, Math.max(1, estado.zoom + Number(b.dataset.zoom)));
      actualizar({ anunciar: false });
    }),
  );

  $$('[data-chips] [data-categoria]').forEach((b) =>
    b.addEventListener('click', () => {
      estado.categoria = b.dataset.categoria!;
      estado.todo = false;
      actualizar();
    }),
  );

  $$<HTMLInputElement>('input[name="fecha"]').forEach((r) =>
    r.addEventListener('change', () => {
      estado.fecha = r.value;
      estado.todo = false;
      actualizar();
    }),
  );

  $('[data-accion="categorias"]', panel).addEventListener('click', () => {
    estado.categoria = 'all';
    actualizar();
  });

  $('[data-accion="fecha-finde"]', panel).addEventListener('click', () => {
    estado.fecha = 'finde';
    actualizar();
  });

  botonMas.addEventListener('click', () => {
    estado.todo = !estado.todo;
    actualizar({ anunciar: false });
    if (!estado.todo) botonMas.scrollIntoView({ block: 'nearest' });
  });

  selectores.forEach((selector) => selector.addEventListener('change', () => {
    if (selector.value === 'all') reiniciar();
    else elegir(selector.value);
    actualizar();
  }));

  lista.addEventListener('click', (ev) => {
    const objetivo = ev.target as HTMLElement;
    const repost = objetivo.closest<HTMLButtonElement>('[data-repost]');
    if (repost) {
      // "Repostear" sigue hasta la ventana compartida (Modal); "Reposteado" quita el repost sin abrirla (6.2.4)
      if (repost.getAttribute('aria-pressed') === 'true') {
        ev.stopPropagation();
        marcarRepost(repost, false);
        anuncio.textContent = `Quitaste el repost de «${repost.closest<HTMLElement>('[data-tarjeta]')!.dataset.titulo}».`;
      }
      return;
    }
    const guardar = objetivo.closest<HTMLButtonElement>('[data-guardar]');
    if (guardar) {
      guardar.setAttribute('aria-pressed', String(guardar.getAttribute('aria-pressed') !== 'true'));
      return;
    }
    const verMapa = objetivo.closest<HTMLButtonElement>('[data-ver-mapa]');
    if (verMapa) {
      // "Ver en el mapa": elige la ciudad, lleva al mapa y enfoca su pin (H42)
      const id = verMapa.dataset.verMapa!;
      if (estado.ciudad !== id) elegir(id);
      actualizar();
      const pin = pines.find((p) => p.dataset.pin === id)!;
      pin.focus({ preventScroll: true });
      mapa.scrollIntoView({ behavior: comportamiento(), block: 'nearest' });
    }
  });

  // Repost confirmado en la ventana: marca la tarjeta y lo anuncia, con el texto de la Agenda (N17)
  const marcarRepost = (boton: HTMLElement, activo: boolean) => {
    boton.setAttribute('aria-pressed', String(activo));
    $('[data-repost-texto]', boton).textContent = activo ? 'Reposteado' : 'Repostear';
  };
  document.addEventListener('repost:confirmado', (ev) => {
    const { id, destino } = (ev as CustomEvent<{ id: string; destino: string }>).detail;
    const tarjeta = $$('[data-tarjeta]', lista).find((t) => t.dataset.id === id);
    if (!tarjeta) return;
    marcarRepost($('[data-repost]', tarjeta), true);
    const donde = destinosRepost.find((d) => d.id === destino) ?? destinosRepost[0];
    anuncio.textContent = `Reposteaste «${tarjeta.dataset.titulo}» en ${donde.aviso}.`;
  });

  // Con sesión, los reposts de la usuaria del demo (el servidor pinta las tarjetas como las ve el visitante)
  if (haySesion()) $$<HTMLElement>('[data-reposteado-sesion]', lista).forEach((b) => marcarRepost(b, true));

  new ResizeObserver(() => ajustarTabulacion()).observe(lienzo);

  // --- Estado inicial desde la dirección ---
  const params = new URLSearchParams(location.search);
  const ciudadUrl = params.get('ciudad');
  const categoriaUrl = params.get('categoria');
  const fechaUrl = params.get('fecha');
  if (categoriaUrl && categoriaPorId[categoriaUrl]) estado.categoria = categoriaUrl;
  if (fechaUrl && fechaPorId[fechaUrl]) estado.fecha = fechaUrl;
  if (ciudadUrl && porId[ciudadUrl]) elegir(ciudadUrl);

  if (location.search) {
    mapa.dataset.sinTransicion = '';
    pintar({ anunciar: !!estado.ciudad });
    requestAnimationFrame(() => requestAnimationFrame(() => delete mapa.dataset.sinTransicion));
    // Llegar con ?ciudad= en celular muestra el resultado (H42)
    if (estado.ciudad && apilado()) panel.scrollIntoView({ block: 'start' });
  } else {
    pintar({ anunciar: false });
  }
</script>

<style>
  .principal {
    padding-top: 28px;
    padding-bottom: 48px;
    display: flex;
    flex-direction: column;
    gap: 22px;
  }

  /* El pie del prototipo va pegado al final del main (48 px de relleno) */
  .principal + :global(.pie) {
    margin-top: 0;
  }

  /* Fila de categorías (mismo patrón que la Bienvenida; H61) */
  .chips {
    position: relative;
    display: flex;
    gap: 8px;
    overflow-x: auto;
    padding-block: 6px;
    margin-block: -6px -2px;
    scroll-padding-inline: 8px 40px;
  }

  .chip {
    flex-shrink: 0;
    height: 42px;
    border-radius: var(--radius-pill);
    padding: 0 16px;
    font-size: .9rem;
    font-weight: 500;
    white-space: nowrap;
    border: 1px solid var(--line);
    background: var(--surface);
    color: var(--ink);
  }

  .chip[aria-pressed='true'] {
    background: var(--ink);
    border-color: var(--ink);
    color: var(--on-dark);
  }

  @media (min-width: 768px) {
    .chips {
      flex-wrap: wrap;
      overflow: visible;
    }
  }

  @media (max-width: 767px) {
    .chips {
      mask-image: linear-gradient(to right, #000 calc(100% - 32px), transparent);
      padding-right: 24px;
    }
  }

  /* Mapa y panel lado a lado cuando caben (560 + 24 + 382); en ese mismo punto la lista pasa a
     scroll interno y el panel toma el alto del mapa (corrige el panel estirado entre 1014 y 1099 px) */
  .contenedor-fila {
    container: fila-mapa / inline-size;
  }

  .fila-mapa {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 24px;
  }

  @container fila-mapa (min-width: 966px) {
    .fila-mapa {
      grid-template-columns: minmax(560px, 1fr) 382px;
      align-items: stretch;
    }

    .fila-mapa :global([data-panel]) {
      contain: size;
    }

    .fila-mapa :global([data-lista]) {
      min-height: 0;
      overflow-y: auto;
    }
  }
</style>
