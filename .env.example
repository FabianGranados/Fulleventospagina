# Copia lo que necesites a los archivos reales, que Git ignora. Nunca subas valores reales.

# ---- .env (lo lee Astro al compilar el sitio) ----
# Dominio público del bucket R2. Vacío = fotos apagadas (las tarjetas muestran el degradado).
PUBLIC_IMAGENES_URL=

# ---- .env.importador (lo lee `npm run imagenes`) ----
# ID de la cuenta de Cloudflare (panel → Workers & Pages → barra lateral, "Account ID")
CLOUDFLARE_ACCOUNT_ID=
# Token de API con SOLO estos permisos: Account → D1 → Edit y Account → Workers R2 Storage → Edit
CLOUDFLARE_API_TOKEN=
# ID de la base D1 "fulleventos" (npx wrangler d1 list)
D1_DATABASE_ID=
R2_BUCKET=fulleventos-imagenes
# El mismo dominio de PUBLIC_IMAGENES_URL (se guarda en url_publica de cada imagen)
IMAGENES_URL_PUBLICA=
