{
  "name": "fulleventos",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "dev:d1": "EVENTOS_D1=local astro dev",
    "build:d1": "EVENTOS_D1=local astro build",
    "build:pruebas": "EVENTOS_D1=pruebas astro build",
    "preview:d1": "EVENTOS_D1=local astro preview",
    "astro": "astro",
    "test": "npm run test:importador && npm run revisar:secretos && astro build && playwright test",
    "test:solo": "playwright test",
    "test:importador": "node --test --test-reporter=spec \"tests/importador/*.prueba.mjs\" \"tests/eventos/*.prueba.mjs\"",
    "imagenes": "node scripts/imagenes/cli.mjs",
    "revisar:secretos": "node scripts/revisar-secretos.mjs",
    "demo:imagenes": "node scripts/demo/demo-imagenes.mjs",
    "eventos": "node scripts/eventos/cli.mjs",
    "d1:local": "node scripts/eventos/d1-local.mjs",
    "divipola": "node scripts/eventos/divipola-generar.mjs",
    "divipola:sql": "node scripts/eventos/divipola-sql.mjs"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.3.4",
    "astro": "^7.3.6"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "axe-core": "^4.14.0",
    "sharp": "^0.35.5"
  }
}
